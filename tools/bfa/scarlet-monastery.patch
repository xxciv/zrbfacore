+// Scarlet Centurion 59746: cuts down the Zombified Corpses near it while no player is around
+struct npc_scarlet_centurion : public ScriptedAI
+{
+    npc_scarlet_centurion(Creature* creature) : ScriptedAI(creature), _retaliated(false) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        _events.ScheduleEvent(EVENT_FIGHT_ZOMBIE, 1500);
+        _retaliated = false;
+    }
+
+    void JustEngagedWith(Unit* who) override
+    {
+        if (who->GetEntry() == NPC_ZOMBIFIED_CORPSE)
+            return;
+
+        _events.Reset();
+        _events.ScheduleEvent(EVENT_CLEAVE, urand(2000, 4000));
+    }
+
+    void DamageTaken(Unit* /*attacker*/, uint32& damage) override
+    {
+        if (!_retaliated && me->HealthBelowPctDamaged(20, damage))
+        {
+            _retaliated = true;
+            DoCast(me, SPELL_RETALIATION, true);
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_FIGHT_ZOMBIE)
+        {
+            if (!me->IsInCombat())
+                if (Creature* zombie = me->FindNearestCreature(NPC_ZOMBIFIED_CORPSE, 10.0f))
+                    AttackStart(zombie);
+            _events.ScheduleEvent(EVENT_FIGHT_ZOMBIE, urand(5000, 6000));
+        }
+
+        if (!UpdateVictim())
+            return;
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        if (_events.ExecuteEvent() == EVENT_CLEAVE)
+        {
+            DoCastVictim(SPELL_CLEAVE);
+            _events.ScheduleEvent(EVENT_CLEAVE, urand(5000, 6000));
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+    bool _retaliated;
+};
