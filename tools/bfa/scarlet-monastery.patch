+// Lowest-health Scarlet within range, for the healers
+static Creature* FindHurtScarlet(Creature* me, float range)
+{
+    Creature* lowest = nullptr;
+    for (uint32 entry : { NPC_SCARLET_FANATIC, NPC_SCARLET_PURIFIER, NPC_SCARLET_ZEALOT, NPC_SCARLET_JUDICATOR, NPC_SCARLET_INITIATE, NPC_SCARLET_CENTURION })
+    {
+        std::list<Creature*> list;
+        me->GetCreatureListWithEntryInGrid(list, entry, range);
+        for (Creature* c : list)
+            if (c->IsAlive() && c->GetHealthPct() < 100.0f && (!lowest || c->GetHealthPct() < lowest->GetHealthPct()))
+                lowest = c;
+    }
+    return lowest;
+}
