+// Scarlet Zealot 58590: smites, heals the Crusade, raises its dead and leaves a Spirit of Redemption behind
+struct npc_scarlet_zealot : public ScriptedAI
+{
+    npc_scarlet_zealot(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        _resurrectGUID.Clear();
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _events.ScheduleEvent(EVENT_SMITE, urand(1000, 3000));
+        _events.ScheduleEvent(EVENT_HEAL, 10000);
+        _events.ScheduleEvent(EVENT_RESURRECTION, 15000);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        me->SummonCreature(NPC_SPIRIT_OF_REDEMPTION, me->GetPositionX() + frand(-2.0f, 2.0f), me->GetPositionY() + frand(-1.5f, 1.5f), me->GetPositionZ(), me->GetOrientation(), TEMPSUMMON_TIMED_DESPAWN, 12000);
+    }
+
+    void OnSuccessfulSpellCast(SpellInfo const* spell) override
+    {
+        if (spell->Id != SPELL_RESURRECTION)
+            return;
+
+        Creature* corpse = ObjectAccessor::GetCreature(*me, _resurrectGUID);
+        _resurrectGUID.Clear();
+        if (!corpse || corpse->IsAlive())
+            return;
+
+        corpse->setDeathState(JUST_RESPAWNED);
+        if (corpse->IsAIEnabled)
+            if (Unit* victim = me->GetVictim())
+                corpse->AI()->AttackStart(victim);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        _events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_SMITE:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 40.0f, true))
+                        DoCast(target, SPELL_SMITE);
+                    _events.ScheduleEvent(EVENT_SMITE, urand(4000, 6000));
+                    return;
+                case EVENT_HEAL:
+                    if (Creature* hurt = FindHurtScarlet(me, 40.0f))
+                        DoCast(hurt, SPELL_HEAL);
+                    else if (me->GetHealthPct() < 100.0f)
+                        DoCast(me, SPELL_HEAL);
+                    _events.ScheduleEvent(EVENT_HEAL, urand(9000, 14000));
+                    return;
+                case EVENT_RESURRECTION:
+                    if (Creature* corpse = FindScarletCorpse())
+                    {
+                        _resurrectGUID = corpse->GetGUID();
+                        me->SetFacingToObject(corpse);
+                        DoCast(corpse, SPELL_RESURRECTION);
+                    }
+                    _events.ScheduleEvent(EVENT_RESURRECTION, urand(15000, 25000));
+                    return;
+                default:
+                    break;
+            }
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    Creature* FindScarletCorpse() const
+    {
+        for (uint32 entry : { NPC_SCARLET_FANATIC, NPC_SCARLET_PURIFIER, NPC_SCARLET_ZEALOT, NPC_SCARLET_JUDICATOR, NPC_SCARLET_INITIATE })
+        {
+            std::list<Creature*> list;
+            me->GetCreatureListWithEntryInGrid(list, entry, 30.0f);
+            for (Creature* c : list)
+                if (!c->IsAlive() && !c->IsSummon())
+                    return c;
+        }
+        return nullptr;
+    }
+
+    EventMap _events;
+    ObjectGuid _resurrectGUID;
+};
+
+// Spirit of Redemption 58592: a dead Zealot's spirit, healing the Crusade for 12 seconds
+struct npc_scm_spirit_of_redemption : public ScriptedAI
+{
+    npc_scm_spirit_of_redemption(Creature* creature) : ScriptedAI(creature)
+    {
+        SetCombatMovement(false);
+    }
+
+    void Reset() override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+    }
+
+    void UpdateAI(uint32 /*diff*/) override
+    {
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        if (Creature* hurt = FindHurtScarlet(me, 40.0f))
+            DoCast(hurt, SPELL_REDEMPTION_HEAL);
+    }
+};
