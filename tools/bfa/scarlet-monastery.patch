+            player->KilledMonsterCredit(NPC_UNTO_DUST_CREDIT);
+            player->KilledMonsterCredit(NPC_UNTO_DUST_CREDIT_2);
+        }
+    }
+
+    void Register() override
+    {
+        BeforeCast += SpellCastFn(spell_scm_blades_of_the_anointed::HandleBeforeCast);
+    }
