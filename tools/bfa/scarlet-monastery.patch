+    RegisterCreatureAI(npc_frenzied_spirit);
+    RegisterCreatureAI(npc_pile_of_corpses);
+    RegisterCreatureAI(npc_scarlet_centurion);
+    RegisterCreatureAI(npc_zombified_corpse);
+    RegisterCreatureAI(npc_scarlet_zealot);
+    RegisterCreatureAI(npc_scm_spirit_of_redemption);
+}
