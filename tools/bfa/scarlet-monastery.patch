+#include "ScriptMgr.h"
+#include "InstanceScript.h"
+#include "MotionMaster.h"
+#include "ScriptedCreature.h"
+#include "TemporarySummon.h"
+#include "scarlet_monastery.h"
+
+enum KorloffSpells
+{
+    SPELL_BLAZING_FISTS          = 114807, // 6 s channel, a fiery punch cone every second
+    SPELL_FIRESTORM_KICK         = 113764, // fire around him every second after he lands
+    SPELL_RISING_FLAME           = 114410, // +10% damage for every 10% health lost
+    SPELL_FLYING_KICK            = 114488, // knockback and damage on the target he jumps at
+    SPELL_TRIGGER_SCORCHED_EARTH = 114464, // the burning ground left by the trigger
+};
+
+enum KorloffEvents
+{
+    EVENT_BLAZING_FISTS          = 1,
+    EVENT_FLYING_KICK,
+    EVENT_FIRESTORM_END,
+    EVENT_SCORCHED_EARTH,
+};
+
+enum KorloffTexts
+{
+    TALK_AGGRO                   = 0, // I will break you.
+    TALK_DEATH                   = 1, // You are like... piece of iron...
+    TALK_KICK                    = 2, // If you die, you die.
+    TALK_FISTS                   = 3, // My fists are scarlet... with your blood!
+};
+
+uint32 const PointFlyingKick = 1;
+
+struct boss_brother_korloff : public BossAI
+{
+    boss_brother_korloff(Creature* creature) : BossAI(creature, DATA_BROTHER_KORLOFF), _lastFlameHealth(100.0f), _scorched(false) { }
+
+    void Reset() override
+    {
+        _Reset();
+        _lastFlameHealth = 100.0f;
+        _scorched = false;
+        me->SetReactState(REACT_AGGRESSIVE);
+    }
+
+    void JustEngagedWith(Unit* who) override
+    {
+        BossAI::JustEngagedWith(who);
+        Talk(TALK_AGGRO);
+        events.ScheduleEvent(EVENT_FLYING_KICK, 10000);
+        events.ScheduleEvent(EVENT_BLAZING_FISTS, 20000);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _JustDied();
+        Talk(TALK_DEATH);
+    }
+
+    void DamageTaken(Unit* /*attacker*/, uint32& damage) override
+    {
+        // below half health he sets the floor on fire wherever he walks
+        if (!_scorched && me->HealthBelowPctDamaged(50, damage))
+        {
+            _scorched = true;
+            events.ScheduleEvent(EVENT_SCORCHED_EARTH, 1000);
+        }
+    }
+
+    void MovementInform(uint32 type, uint32 pointId) override
+    {
+        if (type != EFFECT_MOTION_TYPE || pointId != PointFlyingKick)
+            return;
+
+        // landed: Firestorm Kick, then back to the tank
+        DoCast(me, SPELL_FIRESTORM_KICK, true);
+        events.ScheduleEvent(EVENT_FIRESTORM_END, 6000);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        events.Update(diff);
+
+        // Rising Flame: another stack for every 10% of health he loses
+        if (_lastFlameHealth - me->GetHealthPct() >= 10.0f)
+        {
+            _lastFlameHealth -= 10.0f;
+            DoCast(me, SPELL_RISING_FLAME, true);
+        }
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_BLAZING_FISTS:
+                    Talk(TALK_FISTS);
+                    DoCastVictim(SPELL_BLAZING_FISTS);
+                    events.ScheduleEvent(EVENT_BLAZING_FISTS, 20000);
+                    break;
+                case EVENT_FLYING_KICK:
+                {
+                    Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, [this](Unit* u) { return u->GetTypeId() == TYPEID_PLAYER && u->GetDistance2d(me) > 5.0f; });
+                    if (!target)
+                        target = me->GetVictim();
+                    if (target)
+                    {
+                        Talk(TALK_KICK);
+                        me->SetReactState(REACT_PASSIVE);
+                        me->AttackStop();
+                        DoCast(target, SPELL_FLYING_KICK, true);
+                        me->GetMotionMaster()->MoveJump(target->GetPositionX(), target->GetPositionY(), target->GetPositionZ(), me->GetOrientation(), 30.0f, 8.0f, PointFlyingKick);
+                    }
+                    events.ScheduleEvent(EVENT_FLYING_KICK, 25000);
+                    break;
+                }
+                case EVENT_FIRESTORM_END:
+                    me->SetReactState(REACT_AGGRESSIVE);
+                    if (Unit* victim = me->GetVictim())
+                        AttackStart(victim);
+                    break;
+                case EVENT_SCORCHED_EARTH:
+                    if (me->isMoving())
+                        me->SummonCreature(NPC_SCORCHED_EARTH, me->GetPosition(), TEMPSUMMON_TIMED_DESPAWN, 30000);
+                    events.ScheduleEvent(EVENT_SCORCHED_EARTH, 1000);
+                    break;
+                default:
+                    break;
+            }
+
+            if (me->HasUnitState(UNIT_STATE_CASTING))
+                return;
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    float _lastFlameHealth;
+    bool _scorched;
+};
+
+// Scorched Earth 59507: a patch of burning ground left in Korloff's footsteps
+struct npc_scorched_earth : public ScriptedAI
+{
+    npc_scorched_earth(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(Unit* /*summoner*/) override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+        DoCast(me, SPELL_TRIGGER_SCORCHED_EARTH, true);
+    }
+
+    void UpdateAI(uint32 /*diff*/) override { }
+};
+
+void AddSC_boss_brother_korloff()
+{
+    RegisterCreatureAIWithFactory(boss_brother_korloff, GetScarletMonasteryAI);
+    RegisterCreatureAI(npc_scorched_earth);
+}
