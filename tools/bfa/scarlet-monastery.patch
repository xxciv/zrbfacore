+// Zombified Corpse 59771: hostile to the Crusade (faction 1962). A Centurion's blow finishes it a few seconds later.
+struct npc_zombified_corpse : public ScriptedAI
+{
+    npc_zombified_corpse(Creature* creature) : ScriptedAI(creature), _falling(false) { }
+
+    void DamageTaken(Unit* attacker, uint32& /*damage*/) override
+    {
+        if (_falling || !attacker || attacker->GetTypeId() == TYPEID_PLAYER || attacker->IsControlledByPlayer())
+            return;
+
+        _falling = true;
+        AttackStart(attacker);
+        _events.ScheduleEvent(EVENT_ZOMBIE_FALL, urand(3000, 5000));
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_ZOMBIE_FALL)
+        {
+            me->DisappearAndDie();
+            return;
+        }
+
+        if (!UpdateVictim())
+            return;
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+    bool _falling;
+};
