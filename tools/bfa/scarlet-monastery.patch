@@ -0,0 +1,496 @@
+/*
+ * 2026 BFA-HavenCore
+ *
+ * Scarlet Monastery (map 1004) trash, ported from the Pandaria 5.4.8 project (GPL v2 or later).
+ * Trash that already has working SmartAI in this database (Purifier, Judicator, Fanatic, Initiate)
+ * keeps it; this file covers the graveyard and the Zealots.
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * with this program. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "ScriptMgr.h"
+#include "InstanceScript.h"
+#include "MotionMaster.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "ScriptedCreature.h"
+#include "SpellInfo.h"
+#include "TemporarySummon.h"
+#include "scarlet_monastery.h"
+
+enum SMTrashSpells
+{
+    SPELL_FLAMETHROWER        = 115506,
+    SPELL_FUEL_BARREL         = 114875, // the tank's glow
+    SPELL_BARREL_EXPLOSION    = 114952, // 10 yards, hits creatures only (conditions)
+    SPELL_FRENZIED_SPIRIT     = 115524,
+    SPELL_PILE_OF_CORPSES     = 114951, // raises a Zombified Corpse every 10 s
+    SPELL_CLEAVE              = 115519,
+    SPELL_RETALIATION         = 115511,
+    SPELL_SMITE               = 111010,
+    SPELL_HEAL                = 111008,
+    SPELL_RESURRECTION        = 111670,
+    SPELL_REDEMPTION_HEAL     = 111024,
+};
+
+enum SMTrashEvents
+{
+    EVENT_FLAMETHROWER        = 1,
+    EVENT_FRENZY,
+    EVENT_CLEAVE,
+    EVENT_FIGHT_ZOMBIE,
+    EVENT_ZOMBIE_FALL,
+    EVENT_SMITE,
+    EVENT_HEAL,
+    EVENT_RESURRECTION,
+};
+
+enum SMTrashTexts
+{
+    TALK_PILES_OF_CORPSES     = 0, // Destroy the Piles of Corpses to stop the Zombified Corpses!
+};
+
+// Lowest-health Scarlet within range, for the healers
+static Creature* FindHurtScarlet(Creature* me, float range)
+{
+    Creature* lowest = nullptr;
+    for (uint32 entry : { NPC_SCARLET_FANATIC, NPC_SCARLET_PURIFIER, NPC_SCARLET_ZEALOT, NPC_SCARLET_JUDICATOR, NPC_SCARLET_INITIATE, NPC_SCARLET_CENTURION })
+    {
+        std::list<Creature*> list;
+        me->GetCreatureListWithEntryInGrid(list, entry, range);
+        for (Creature* c : list)
+            if (c->IsAlive() && c->GetHealthPct() < 100.0f && (!lowest || c->GetHealthPct() < lowest->GetHealthPct()))
+                lowest = c;
+    }
+    return lowest;
+}
+
+// Hooded Crusader 64827 at the entrance: warns about the Piles of Corpses as the first player walks in
+struct npc_scm_hooded_crusader : public ScriptedAI
+{
+    npc_scm_hooded_crusader(Creature* creature) : ScriptedAI(creature), _announced(false) { }
+
+    void MoveInLineOfSight(Unit* who) override
+    {
+        if (_announced || who->GetTypeId() != TYPEID_PLAYER || who->ToPlayer()->IsGameMaster() || !me->IsWithinDistInMap(who, 30.0f))
+            return;
+
+        _announced = true;
+        Talk(TALK_PILES_OF_CORPSES, who);
+    }
+
+    void UpdateAI(uint32 /*diff*/) override { }
+
+private:
+    bool _announced;
+};
+
+// Scarlet Flamethrower 59705: burns the graveyard dead out of combat, and leaves a Fuel Tank behind when killed
+struct npc_scarlet_flamethrower : public ScriptedAI
+{
+    npc_scarlet_flamethrower(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        _events.ScheduleEvent(EVENT_FLAMETHROWER, urand(1500, 2000));
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _events.Reset();
+        _events.ScheduleEvent(EVENT_FLAMETHROWER, urand(1500, 2000));
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        me->SummonCreature(NPC_FUEL_TANK, me->GetPositionX() + frand(-2.0f, 2.0f), me->GetPositionY() + frand(-1.5f, 1.5f), me->GetPositionZ(), me->GetOrientation(), TEMPSUMMON_TIMED_DESPAWN, 300000);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (!me->IsInCombat())
+        {
+            if (_events.ExecuteEvent() == EVENT_FLAMETHROWER)
+            {
+                DoCast(me, SPELL_FLAMETHROWER);
+                _events.ScheduleEvent(EVENT_FLAMETHROWER, urand(6000, 8000));
+            }
+            return;
+        }
+
+        if (!UpdateVictim())
+            return;
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        if (_events.ExecuteEvent() == EVENT_FLAMETHROWER)
+        {
+            DoCastVictim(SPELL_FLAMETHROWER);
+            _events.ScheduleEvent(EVENT_FLAMETHROWER, urand(10000, 16000));
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+};
+
+// Fuel Tank 59706: click it (npc_spellclick_spells 114953) and it blows up, burning the Scarlet around it
+struct npc_scm_fuel_tank : public ScriptedAI
+{
+    npc_scm_fuel_tank(Creature* creature) : ScriptedAI(creature), _exploded(false) { }
+
+    void Reset() override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        if (!me->HasAura(SPELL_FUEL_BARREL))
+            DoCast(me, SPELL_FUEL_BARREL, true);
+    }
+
+    void OnSpellClick(Unit* /*clicker*/, bool& /*result*/) override
+    {
+        if (_exploded)
+            return;
+
+        _exploded = true;
+        me->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+        DoCast(me, SPELL_BARREL_EXPLOSION, true);
+        me->DespawnOrUnsummon(500);
+    }
+
+    void DamageTaken(Unit* /*attacker*/, uint32& damage) override
+    {
+        damage = 0;
+    }
+
+    void UpdateAI(uint32 /*diff*/) override { }
+
+private:
+    bool _exploded;
+};
+
+// Frenzied Spirit 60033: works itself into a frenzy, stacking damage and size every few seconds
+struct npc_frenzied_spirit : public ScriptedAI
+{
+    npc_frenzied_spirit(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        me->RemoveAurasDueToSpell(SPELL_FRENZIED_SPIRIT);
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _events.ScheduleEvent(EVENT_FRENZY, 2000);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_FRENZY)
+        {
+            DoCast(me, SPELL_FRENZIED_SPIRIT, true);
+            _events.ScheduleEvent(EVENT_FRENZY, urand(3000, 4000));
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+};
+
+// Pile of Corpses 59722: raises Zombified Corpses until it is destroyed; it can't move or fight back
+struct npc_pile_of_corpses : public ScriptedAI
+{
+    npc_pile_of_corpses(Creature* creature) : ScriptedAI(creature), _summons(creature)
+    {
+        SetCombatMovement(false);
+    }
+
+    void Reset() override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        if (!me->HasAura(SPELL_PILE_OF_CORPSES))
+            DoCast(me, SPELL_PILE_OF_CORPSES, true);
+    }
+
+    void JustSummoned(Creature* summon) override
+    {
+        _summons.Summon(summon);
+    }
+
+    void SummonedCreatureDespawn(Creature* summon) override
+    {
+        _summons.Despawn(summon);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _summons.DespawnAll();
+    }
+
+    void UpdateAI(uint32 /*diff*/) override
+    {
+        UpdateVictim();
+    }
+
+private:
+    SummonList _summons;
+};
+
+// Scarlet Centurion 59746: cuts down the Zombified Corpses near it while no player is around
+struct npc_scarlet_centurion : public ScriptedAI
+{
+    npc_scarlet_centurion(Creature* creature) : ScriptedAI(creature), _retaliated(false) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        _events.ScheduleEvent(EVENT_FIGHT_ZOMBIE, 1500);
+        _retaliated = false;
+    }
+
+    void JustEngagedWith(Unit* who) override
+    {
+        if (who->GetEntry() == NPC_ZOMBIFIED_CORPSE)
+            return;
+
+        _events.Reset();
+        _events.ScheduleEvent(EVENT_CLEAVE, urand(2000, 4000));
+    }
+
+    void DamageTaken(Unit* /*attacker*/, uint32& damage) override
+    {
+        if (!_retaliated && me->HealthBelowPctDamaged(20, damage))
+        {
+            _retaliated = true;
+            DoCast(me, SPELL_RETALIATION, true);
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_FIGHT_ZOMBIE)
+        {
+            if (!me->IsInCombat())
+                if (Creature* zombie = me->FindNearestCreature(NPC_ZOMBIFIED_CORPSE, 10.0f))
+                    AttackStart(zombie);
+            _events.ScheduleEvent(EVENT_FIGHT_ZOMBIE, urand(5000, 6000));
+        }
+
+        if (!UpdateVictim())
+            return;
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        if (_events.ExecuteEvent() == EVENT_CLEAVE)
+        {
+            DoCastVictim(SPELL_CLEAVE);
+            _events.ScheduleEvent(EVENT_CLEAVE, urand(5000, 6000));
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+    bool _retaliated;
+};
+
+// Zombified Corpse 59771: hostile to the Crusade (faction 1962). A Centurion's blow finishes it a few seconds later.
+struct npc_zombified_corpse : public ScriptedAI
+{
+    npc_zombified_corpse(Creature* creature) : ScriptedAI(creature), _falling(false) { }
+
+    void DamageTaken(Unit* attacker, uint32& /*damage*/) override
+    {
+        if (_falling || !attacker || attacker->GetTypeId() == TYPEID_PLAYER || attacker->IsControlledByPlayer())
+            return;
+
+        _falling = true;
+        AttackStart(attacker);
+        _events.ScheduleEvent(EVENT_ZOMBIE_FALL, urand(3000, 5000));
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_ZOMBIE_FALL)
+        {
+            me->DisappearAndDie();
+            return;
+        }
+
+        if (!UpdateVictim())
+            return;
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+    bool _falling;
+};
+
+// Scarlet Zealot 58590: smites, heals the Crusade, raises its dead and leaves a Spirit of Redemption behind
+struct npc_scarlet_zealot : public ScriptedAI
+{
+    npc_scarlet_zealot(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        _resurrectGUID.Clear();
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _events.ScheduleEvent(EVENT_SMITE, urand(1000, 3000));
+        _events.ScheduleEvent(EVENT_HEAL, 10000);
+        _events.ScheduleEvent(EVENT_RESURRECTION, 15000);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        me->SummonCreature(NPC_SPIRIT_OF_REDEMPTION, me->GetPositionX() + frand(-2.0f, 2.0f), me->GetPositionY() + frand(-1.5f, 1.5f), me->GetPositionZ(), me->GetOrientation(), TEMPSUMMON_TIMED_DESPAWN, 12000);
+    }
+
+    void OnSuccessfulSpellCast(SpellInfo const* spell) override
+    {
+        if (spell->Id != SPELL_RESURRECTION)
+            return;
+
+        Creature* corpse = ObjectAccessor::GetCreature(*me, _resurrectGUID);
+        _resurrectGUID.Clear();
+        if (!corpse || corpse->IsAlive())
+            return;
+
+        corpse->setDeathState(JUST_RESPAWNED);
+        if (corpse->IsAIEnabled)
+            if (Unit* victim = me->GetVictim())
+                corpse->AI()->AttackStart(victim);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        _events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_SMITE:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 40.0f, true))
+                        DoCast(target, SPELL_SMITE);
+                    _events.ScheduleEvent(EVENT_SMITE, urand(4000, 6000));
+                    return;
+                case EVENT_HEAL:
+                    if (Creature* hurt = FindHurtScarlet(me, 40.0f))
+                        DoCast(hurt, SPELL_HEAL);
+                    else if (me->GetHealthPct() < 100.0f)
+                        DoCast(me, SPELL_HEAL);
+                    _events.ScheduleEvent(EVENT_HEAL, urand(9000, 14000));
+                    return;
+                case EVENT_RESURRECTION:
+                    if (Creature* corpse = FindScarletCorpse())
+                    {
+                        _resurrectGUID = corpse->GetGUID();
+                        me->SetFacingToObject(corpse);
+                        DoCast(corpse, SPELL_RESURRECTION);
+                    }
+                    _events.ScheduleEvent(EVENT_RESURRECTION, urand(15000, 25000));
+                    return;
+                default:
+                    break;
+            }
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    Creature* FindScarletCorpse() const
+    {
+        for (uint32 entry : { NPC_SCARLET_FANATIC, NPC_SCARLET_PURIFIER, NPC_SCARLET_ZEALOT, NPC_SCARLET_JUDICATOR, NPC_SCARLET_INITIATE })
+        {
+            std::list<Creature*> list;
+            me->GetCreatureListWithEntryInGrid(list, entry, 30.0f);
+            for (Creature* c : list)
+                if (!c->IsAlive() && !c->IsSummon())
+                    return c;
+        }
+        return nullptr;
+    }
+
+    EventMap _events;
+    ObjectGuid _resurrectGUID;
+};
+
+// Spirit of Redemption 58592: a dead Zealot's spirit, healing the Crusade for 12 seconds
+struct npc_scm_spirit_of_redemption : public ScriptedAI
+{
+    npc_scm_spirit_of_redemption(Creature* creature) : ScriptedAI(creature)
+    {
+        SetCombatMovement(false);
+    }
+
+    void Reset() override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+    }
+
+    void UpdateAI(uint32 /*diff*/) override
+    {
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        if (Creature* hurt = FindHurtScarlet(me, 40.0f))
+            DoCast(hurt, SPELL_REDEMPTION_HEAL);
+    }
+};
+
+void AddSC_scarlet_monastery()
+{
+    RegisterCreatureAI(npc_scm_hooded_crusader);
+    RegisterCreatureAI(npc_scarlet_flamethrower);
+    RegisterCreatureAI(npc_scm_fuel_tank);
+    RegisterCreatureAI(npc_frenzied_spirit);
+    RegisterCreatureAI(npc_pile_of_corpses);
+    RegisterCreatureAI(npc_scarlet_centurion);
+    RegisterCreatureAI(npc_zombified_corpse);
+    RegisterCreatureAI(npc_scarlet_zealot);
+    RegisterCreatureAI(npc_scm_spirit_of_redemption);
+}
