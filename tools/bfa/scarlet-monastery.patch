+ */
+
+#include "ScriptMgr.h"
+#include "InstanceScript.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "ScriptedCreature.h"
+#include "TemporarySummon.h"
+#include "scarlet_monastery.h"
+
+enum ThalnosSpells
+{
+    SPELL_SPIRIT_GALE               = 115289, // missile; the pool it leaves is areatrigger 220 (SQL)
+    SPELL_RAISE_FALLEN_CRUSADER     = 115139, // 5 s channel, a Fallen Crusader every second
+    SPELL_EVICT_SOUL                = 115297,
+    SPELL_SUMMON_EMPOWERING_SPIRITS = 115147,
+    SPELL_SPIRIT_GALE_AURA          = 115291,
+
+    SPELL_MIND_ROT                  = 115144, // Fallen Crusader
+    SPELL_CLONE_ME                  = 45204,  // Evicted Soul takes its player's looks
+};
+
+enum ThalnosEvents
+{
+    EVENT_SPIRIT_GALE               = 1,
+    EVENT_RAISE_FALLEN_CRUSADER,
+    EVENT_EVICT_SOUL,
+    EVENT_EMPOWERING_SPIRITS,
+
+    EVENT_MIND_ROT                  = 1,
+    EVENT_EMPOWER                   = 1,
+};
+
+enum ThalnosTexts
+{
+    TALK_AGGRO                      = 0, // My endless agony shall be yours, as well!
+    TALK_RAISE                      = 1, // No rest... for the angry dead!
+    TALK_EVICT                      = 2, // Seek out a vessel... and return!
+    TALK_SPIRITS                    = 3, // Claim a body, and wreak terrible vengeance!
+    TALK_DEATH                      = 4, // Can this be... the end, at last...?
+    TALK_EVICT_SOUL_ANN             = 5,
+    TALK_EMPOWERING_SPIRITS_ANN     = 6,
+};
+
+struct boss_thalnos_the_soulrender : public BossAI
+{
+    boss_thalnos_the_soulrender(Creature* creature) : BossAI(creature, DATA_THALNOS_THE_SOULRENDER) { }
+
+    void Reset() override
+    {
+        _Reset();
+        DespawnAdds();
+        me->SetReactState(REACT_AGGRESSIVE);
+        instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_SPIRIT_GALE_AURA);
+    }
+
+    void JustEngagedWith(Unit* who) override
+    {
+        BossAI::JustEngagedWith(who);
+        Talk(TALK_AGGRO);
+        events.ScheduleEvent(EVENT_SPIRIT_GALE, 1500);
+        events.ScheduleEvent(EVENT_RAISE_FALLEN_CRUSADER, urand(6500, 7000));
+        events.ScheduleEvent(EVENT_EVICT_SOUL, urand(25000, 26000));
+        events.ScheduleEvent(EVENT_EMPOWERING_SPIRITS, urand(40000, 42000));
+    }
+
+    void EnterEvadeMode(EvadeReason why) override
+    {
+        DespawnAdds();
+        instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_SPIRIT_GALE_AURA);
+        BossAI::EnterEvadeMode(why);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _JustDied();
+        Talk(TALK_DEATH);
+        DespawnAdds();
+        instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_SPIRIT_GALE_AURA);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_SPIRIT_GALE:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 100.0f, true))
+                        DoCast(target, SPELL_SPIRIT_GALE);
+                    events.ScheduleEvent(EVENT_SPIRIT_GALE, urand(7500, 13000));
+                    break;
+                case EVENT_RAISE_FALLEN_CRUSADER:
+                    Talk(TALK_RAISE);
+                    DoCast(me, SPELL_RAISE_FALLEN_CRUSADER);
+                    break;
+                case EVENT_EVICT_SOUL:
+                {
+                    Talk(TALK_EVICT);
+                    Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, NonTankTargetSelector(me));
+                    if (!target)
+                        target = me->GetVictim();
+                    if (target)
+                    {
+                        Talk(TALK_EVICT_SOUL_ANN, target);
+                        DoCast(target, SPELL_EVICT_SOUL);
+                    }
+                    events.ScheduleEvent(EVENT_EVICT_SOUL, urand(25000, 26000));
+                    break;
+                }
+                case EVENT_EMPOWERING_SPIRITS:
+                    Talk(TALK_SPIRITS);
+                    Talk(TALK_EMPOWERING_SPIRITS_ANN);
+                    DoCastAOE(SPELL_SUMMON_EMPOWERING_SPIRITS);
+                    events.ScheduleEvent(EVENT_EMPOWERING_SPIRITS, urand(40000, 42000));
+                    events.ScheduleEvent(EVENT_RAISE_FALLEN_CRUSADER, 20000);
+                    break;
+                default:
+                    break;
+            }
+
+            if (me->HasUnitState(UNIT_STATE_CASTING))
+                return;
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    // the Evicted Souls are summoned by the players' own aura, so they are not in the boss's summon list
+    void DespawnAdds()
+    {
+        summons.DespawnAll();
+        for (uint32 entry : { NPC_FALLEN_CRUSADER, NPC_EMPOWERING_SPIRIT, NPC_EMPOWERED_ZOMBIE, NPC_EVICTED_SOUL })
+        {
+            std::list<Creature*> adds;
+            me->GetCreatureListWithEntryInGrid(adds, entry, 200.0f);
+            for (Creature* add : adds)
+                add->DespawnOrUnsummon();
+        }
+    }
+};
+
+// Fallen Crusader 59884: rises around Thalnos and rots the mind of whoever it hits
+struct npc_fallen_crusader : public ScriptedAI
+{
+    npc_fallen_crusader(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(Unit* /*summoner*/) override
+    {
+        DoZoneInCombat();
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _events.ScheduleEvent(EVENT_MIND_ROT, urand(3500, 4200));
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_MIND_ROT)
+        {
+            DoCastVictim(SPELL_MIND_ROT);
+            _events.ScheduleEvent(EVENT_MIND_ROT, urand(3500, 4200));
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+};
+
+// Empowering Spirit 59893: kill it within 5 seconds or it becomes an Empowered Zombie
+struct npc_empowering_spirit : public ScriptedAI
+{
+    npc_empowering_spirit(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(Unit* /*summoner*/) override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        SetCombatMovement(false);
+        _events.ScheduleEvent(EVENT_EMPOWER, 5000);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_EMPOWER)
+        {
+            InstanceScript* instance = me->GetInstanceScript();
+            Creature* thalnos = instance ? instance->GetCreature(DATA_THALNOS_THE_SOULRENDER) : nullptr;
+            if (thalnos && thalnos->IsAlive() && thalnos->IsInCombat())
+                thalnos->SummonCreature(NPC_EMPOWERED_ZOMBIE, me->GetPosition(), TEMPSUMMON_CORPSE_TIMED_DESPAWN, 5000);
+            me->DespawnOrUnsummon();
+        }
+    }
+
+private:
+    EventMap _events;
+};
+
+// Evicted Soul 59974: a hostile copy of the player whose soul Thalnos evicted
+struct npc_evicted_soul : public ScriptedAI
+{
+    npc_evicted_soul(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(Unit* summoner) override
+    {
+        Player* player = summoner->ToPlayer();
+        if (!player)
+            player = me->SelectNearestPlayer(60.0f);
+        if (!player)
+            return;
+
+        if (InstanceScript* instance = me->GetInstanceScript())
+            if (Creature* thalnos = instance->GetCreature(DATA_THALNOS_THE_SOULRENDER))
+                me->SetFaction(thalnos->getFaction());
+
+        player->CastSpell(me, SPELL_CLONE_ME, true);
+        AttackStart(player);
+    }
+
+    void UpdateAI(uint32 /*diff*/) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        DoMeleeAttackIfReady();
+    }
+};
+
+void AddSC_boss_thalnos_the_soulrender()
+{
+    RegisterCreatureAIWithFactory(boss_thalnos_the_soulrender, GetScarletMonasteryAI);
+    RegisterCreatureAI(npc_fallen_crusader);
+    RegisterCreatureAI(npc_empowering_spirit);
+    RegisterCreatureAI(npc_evicted_soul);
+}
