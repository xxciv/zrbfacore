index 0000000..a21421d
--- /dev/null
+++ b/src/server/scripts/EasternKingdoms/ScarletMonastery/boss_thalnos_the_soulrender.cpp
@@ -0,0 +1,270 @@
+/*
+ * 2026 BFA-HavenCore
+ *
+ * Thalnos the Soulrender (Scarlet Monastery, map 1004), ported from the Pandaria 5.4.8 project (GPL v2 or later).
+ *
