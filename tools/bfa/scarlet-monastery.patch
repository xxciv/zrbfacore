+/*
+ * 2026 BFA-HavenCore
+ *
+ * Commander Durand and High Inquisitor Whitemane (Scarlet Monastery, map 1004),
+ * ported from the Pandaria 5.4.8 project (GPL v2 or later).
+ *
+ * Durand fights first. When he falls he only feigns death: Whitemane steps out of her door and
+ * fights. At half health she puts the party to sleep, walks to Durand and raises him, and from
+ * then on both fight until dead. Whitemane's death leaves the corpse marker the Blades of the
+ * Anointed need for "Unto Dust Thou Shalt Return".
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful, but WITHOUT
+ * ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for
+ * more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * with this program. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "ScriptMgr.h"
+#include "InstanceScript.h"
+#include "Map.h"
+#include "MotionMaster.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "ScriptedCreature.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+#include "SpellScript.h"
+#include "scarlet_monastery.h"
+
+enum DurandWhitemaneSpells
+{
+    SPELL_FLASH_OF_STEEL            = 115629, // Durand: charge and strike, six times in a row
+    SPELL_DASHING_STRIKE            = 115739, // Durand: damages everyone in a line to the target
+
+    SPELL_POWER_WORD_SHIELD         = 22187,  // Whitemane
+    SPELL_HOLY_SMITE                = 114848,
+    SPELL_HEAL                      = 36678,
+    SPELL_MASS_RESURRECTION         = 113134,
+    SPELL_DEEP_SLEEP                = 9256,
+    SPELL_SCARLET_RESURRECTION      = 9232,
+    SPELL_SUMMON_CORPSE_FOCUS       = 126789, // "High Inquisitor Whitemane's Corpse Spell Focus" for the Blades
+
+    SPELL_BLADES_OF_THE_ANOINTED    = 126787, // the quest item, both versions of the quest
+    SPELL_BLADES_OF_THE_ANOINTED_2  = 126843,
+};
+
+enum DurandWhitemaneEvents
+{
+    EVENT_FLASH_OF_STEEL            = 1,
+    EVENT_DASHING_STRIKE,
+
+    EVENT_SMITE                     = 1,
+    EVENT_HEAL,
+    EVENT_MASS_RESURRECTION,
+    EVENT_MASS_RESURRECTION_DONE,
+    EVENT_RAISE_DURAND,
+    EVENT_DURAND_RISES,
+};
+
+enum DurandWhitemaneTexts
+{
+    TALK_DURAND_AGGRO               = 0, // My legend begins NOW!
+    TALK_DURAND_STRIKE              = 1, // My blade is peerless!
+
+    TALK_WHITEMANE_AGGRO            = 0, // You shall pay for this treachery!
+    TALK_WHITEMANE_DEATH            = 1, // Mograine...
+    TALK_WHITEMANE_SLAY             = 2, // The Light has spoken!
+    TALK_WHITEMANE_RESURRECT        = 3, // Arise, my champion!
+};
+
+enum DurandWhitemaneMisc
+{
+    POINT_WHITEMANE_INTRO           = 1,
+    POINT_WHITEMANE_DURAND          = 2,
+
+    NPC_UNTO_DUST_CREDIT            = 64835, // quest 31514
+    NPC_UNTO_DUST_CREDIT_2          = 64840, // quest 31516
+};
+
+struct boss_commander_durand : public BossAI
+{
+    boss_commander_durand(Creature* creature) : BossAI(creature, DATA_COMMANDER_DURAND), _feigning(false), _raised(false) { }
+
+    void Reset() override
+    {
+        _Reset();
+        _feigning = false;
+        _raised = false;
+        _flashCount = 0;
+        _dashCount = 0;
+        me->SetReactState(REACT_AGGRESSIVE);
+        me->SetStandState(UNIT_STAND_STATE_STAND);
+        me->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+    }
+
+    void JustEngagedWith(Unit* who) override
+    {
+        BossAI::JustEngagedWith(who);
+        Talk(TALK_DURAND_AGGRO);
+        ScheduleFight();
+    }
+
+    void DamageTaken(Unit* /*attacker*/, uint32& damage) override
+    {
+        if (_feigning)
+        {
+            damage = 0;
+            return;
+        }
+
+        if (_raised || damage < me->GetHealth())
+            return;
+
+        Creature* whitemane = instance->GetCreature(DATA_HIGH_INQUISITOR_WHITEMANE);
+        if (!whitemane || !whitemane->IsAlive())
+            return;
+
+        // first death: he only feigns it, and Whitemane comes out
+        damage = 0;
+        _feigning = true;
+        events.Reset();
+        me->InterruptNonMeleeSpells(false);
+        me->RemoveAllAuras();
+        me->AttackStop();
+        me->StopMoving();
+        me->SetReactState(REACT_PASSIVE);
+        me->SetHealth(1);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+        me->SetStandState(UNIT_STAND_STATE_DEAD);
+
+        if (whitemane->IsAIEnabled)
+            whitemane->AI()->DoAction(ACTION_WHITEMANE_INTRO);
+    }
+
+    void DoAction(int32 action) override
+    {
+        switch (action)
+        {
+            case ACTION_DURAND_REVIVE:
+                if (!_feigning)
+                    break;
+                _feigning = false;
+                _raised = true;
+                me->SetStandState(UNIT_STAND_STATE_STAND);
+                me->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+                me->SetFullHealth();
+                me->SetReactState(REACT_AGGRESSIVE);
+                ScheduleFight();
+                if (Player* player = me->SelectNearestPlayer(80.0f))
+                    AttackStart(player);
+                break;
+            case ACTION_DURAND_RESET:
+                if (_feigning || me->IsInCombat())
+                    EnterEvadeMode(EVADE_REASON_OTHER);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void EnterEvadeMode(EvadeReason why) override
+    {
+        // lying "dead" while Whitemane fights: she decides when this is over
+        if (_feigning && instance->GetBossState(DATA_HIGH_INQUISITOR_WHITEMANE) == IN_PROGRESS)
+            return;
+
+        _feigning = false;
+        BossAI::EnterEvadeMode(why);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (_feigning)
+            return;
+
+        if (!UpdateVictim())
+            return;
+
+        events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_FLASH_OF_STEEL:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_MAXDISTANCE, 0, 60.0f, true))
+                        DoCast(target, SPELL_FLASH_OF_STEEL);
+                    if (++_flashCount < 6)
+                        events.ScheduleEvent(EVENT_FLASH_OF_STEEL, urand(500, 1000));
+                    else
+                    {
+                        _flashCount = 0;
+                        events.ScheduleEvent(EVENT_FLASH_OF_STEEL, urand(21000, 26000));
+                    }
+                    break;
+                case EVENT_DASHING_STRIKE:
+                    if (_dashCount == 0)
+                        Talk(TALK_DURAND_STRIKE);
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 40.0f, true))
+                    {
+                        // cut through everyone between him and the target, then come out behind it
+                        DoCast(target, SPELL_DASHING_STRIKE, true);
+                        Position dest = target->GetPosition();
+                        target->MovePositionToFirstCollision(dest, 3.0f, target->GetRelativeAngle(me) + float(M_PI));
+                        me->NearTeleportTo(dest.GetPositionX(), dest.GetPositionY(), dest.GetPositionZ(), me->GetAngle(target));
+                    }
+                    if (++_dashCount < 3)
+                        events.ScheduleEvent(EVENT_DASHING_STRIKE, urand(700, 1000));
+                    else
+                    {
+                        _dashCount = 0;
+                        events.ScheduleEvent(EVENT_DASHING_STRIKE, urand(24000, 25000));
+                    }
+                    break;
+                default:
+                    break;
+            }
+
+            if (me->HasUnitState(UNIT_STATE_CASTING))
+                return;
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    void ScheduleFight()
+    {
+        events.Reset();
+        _flashCount = 0;
+        _dashCount = 0;
+        events.ScheduleEvent(EVENT_FLASH_OF_STEEL, 9000);
+        events.ScheduleEvent(EVENT_DASHING_STRIKE, urand(24000, 25000));
+    }
+
+    bool _feigning;
+    bool _raised;
+    uint8 _flashCount = 0;
+    uint8 _dashCount = 0;
+};
+
+struct boss_high_inquisitor_whitemane_mop : public BossAI
+{
+    boss_high_inquisitor_whitemane_mop(Creature* creature) : BossAI(creature, DATA_HIGH_INQUISITOR_WHITEMANE), _raising(false), _raised(false) { }
+
+    void Reset() override
+    {
+        _Reset();
+        _raising = false;
+        _raised = false;
+        _raiseEvents.Reset();
+        // waits behind her door until Durand falls
+        me->SetReactState(REACT_PASSIVE);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+    }
+
+    void DoAction(int32 action) override
+    {
+        if (action != ACTION_WHITEMANE_INTRO || me->IsInCombat())
+            return;
+
+        instance->SetBossState(DATA_HIGH_INQUISITOR_WHITEMANE, IN_PROGRESS); // opens her door
+        me->GetMotionMaster()->MovePoint(POINT_WHITEMANE_INTRO, WhitemaneIntroPos);
+    }
+
+    void MovementInform(uint32 type, uint32 pointId) override
+    {
+        if (type != POINT_MOTION_TYPE)
+            return;
+
+        switch (pointId)
+        {
+            case POINT_WHITEMANE_INTRO:
+                me->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+                me->SetReactState(REACT_AGGRESSIVE);
+                if (Player* player = me->SelectNearestPlayer(80.0f))
+                    AttackStart(player);
+                else
+                    EnterEvadeMode(EVADE_REASON_NO_HOSTILES);
+                break;
+            case POINT_WHITEMANE_DURAND:
+                _raiseEvents.RescheduleEvent(EVENT_RAISE_DURAND, 100);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void JustEngagedWith(Unit* who) override
+    {
+        BossAI::JustEngagedWith(who);
+        Talk(TALK_WHITEMANE_AGGRO);
+        events.ScheduleEvent(EVENT_SMITE, 500);
+        events.ScheduleEvent(EVENT_HEAL, urand(9000, 13000));
+        events.ScheduleEvent(EVENT_MASS_RESURRECTION, 20000);
+    }
+
+    void AttackStart(Unit* target) override
+    {
+        // a caster: she keeps her distance
+        if (target && me->Attack(target, false))
+            me->GetMotionMaster()->MoveChase(target, 25.0f);
+    }
+
+    void KilledUnit(Unit* victim) override
+    {
+        if (victim->GetTypeId() == TYPEID_PLAYER)
+            Talk(TALK_WHITEMANE_SLAY);
+    }
+
+    void DamageTaken(Unit* /*attacker*/, uint32& damage) override
+    {
+        if (_raising && damage >= me->GetHealth())
+            damage = me->GetHealth() - 1;
+
+        if (_raised || _raising || !me->HealthBelowPctDamaged(50, damage))
+            return;
+
+        Creature* durand = instance->GetCreature(DATA_COMMANDER_DURAND);
+        if (!durand || !durand->IsAlive())
+            return;
+
+        // half health: everyone sleeps while she raises her champion
+        _raising = true;
+        events.Reset();
+        me->InterruptNonMeleeSpells(true);
+        me->SetReactState(REACT_PASSIVE);
+        me->AttackStop();
+        DoCastAOE(SPELL_DEEP_SLEEP, true);
+        DoCast(me, SPELL_POWER_WORD_SHIELD, true);
+        me->GetMotionMaster()->Clear();
+        me->GetMotionMaster()->MovePoint(POINT_WHITEMANE_DURAND, durand->GetPositionX() + frand(-1.5f, 1.5f), durand->GetPositionY() + frand(-0.8f, 0.8f), durand->GetPositionZ());
+        // in case the walk is cut short
+        _raiseEvents.ScheduleEvent(EVENT_RAISE_DURAND, 8000);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _JustDied();
+        Talk(TALK_WHITEMANE_DEATH);
+        DoCast(me, SPELL_SUMMON_CORPSE_FOCUS, true);
+    }
+
+    void EnterEvadeMode(EvadeReason why) override
+    {
+        _raising = false;
+        _raised = false;
+        _raiseEvents.Reset();
+        BossAI::EnterEvadeMode(why);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        // the raise runs while she is passive, so it has its own timers ahead of the victim check
+        _raiseEvents.Update(diff);
+        while (uint32 eventId = _raiseEvents.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_RAISE_DURAND:
+                    _raiseEvents.CancelEvent(EVENT_RAISE_DURAND);
+                    if (Creature* durand = instance->GetCreature(DATA_COMMANDER_DURAND))
+                    {
+                        me->StopMoving();
+                        me->SetFacingToObject(durand);
+                        Talk(TALK_WHITEMANE_RESURRECT);
+                        DoCast(durand, SPELL_SCARLET_RESURRECTION, true);
+                    }
+                    _raiseEvents.ScheduleEvent(EVENT_DURAND_RISES, 2000);
+                    break;
+                case EVENT_DURAND_RISES:
+                    _raising = false;
+                    _raised = true;
+                    instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_DEEP_SLEEP);
+                    if (Creature* durand = instance->GetCreature(DATA_COMMANDER_DURAND))
+                        if (durand->IsAIEnabled)
+                            durand->AI()->DoAction(ACTION_DURAND_REVIVE);
+                    me->SetReactState(REACT_AGGRESSIVE);
+                    if (Player* player = me->SelectNearestPlayer(80.0f))
+                        AttackStart(player);
+                    events.ScheduleEvent(EVENT_SMITE, 500);
+                    events.ScheduleEvent(EVENT_HEAL, urand(15000, 16000));
+                    events.ScheduleEvent(EVENT_MASS_RESURRECTION, 10000);
+                    break;
+                case EVENT_MASS_RESURRECTION_DONE:
+                    RaiseTheFallen();
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        if (_raising)
+            return;
+
+        events.Update(diff);
+
+        if (!UpdateVictim())
+            return;
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_SMITE:
+                    DoCastVictim(SPELL_HOLY_SMITE);
+                    events.ScheduleEvent(EVENT_SMITE, urand(2600, 3000));
+                    break;
+                case EVENT_HEAL:
+                {
+                    Creature* durand = _raised ? instance->GetCreature(DATA_COMMANDER_DURAND) : nullptr;
+                    if (durand && durand->IsAlive() && durand->GetHealthPct() < me->GetHealthPct())
+                        DoCast(durand, SPELL_HEAL);
+                    else
+                        DoCast(me, SPELL_HEAL);
+                    events.ScheduleEvent(EVENT_HEAL, urand(9000, 13000));
+                    break;
+                }
+                case EVENT_MASS_RESURRECTION:
+                    if (HasFallenToRaise())
+                    {
+                        DoCast(me, SPELL_MASS_RESURRECTION);
+                        if (SpellInfo const* info = sSpellMgr->GetSpellInfo(SPELL_MASS_RESURRECTION))
+                            _raiseEvents.ScheduleEvent(EVENT_MASS_RESURRECTION_DONE, info->CalcCastTime() + 200);
+                    }
+                    events.ScheduleEvent(EVENT_MASS_RESURRECTION, 20000);
+                    break;
+                default:
+                    break;
+            }
+
+            if (me->HasUnitState(UNIT_STATE_CASTING))
+                return;
+        }
+    }
+
+private:
+    std::list<Creature*> FallenScarlet() const
+    {
+        std::list<Creature*> fallen;
+        for (uint32 entry : { NPC_SCARLET_FANATIC, NPC_SCARLET_PURIFIER, NPC_SCARLET_ZEALOT, NPC_SCARLET_JUDICATOR, NPC_SCARLET_INITIATE })
+        {
+            std::list<Creature*> list;
+            me->GetCreatureListWithEntryInGrid(list, entry, 80.0f);
+            for (Creature* c : list)
+                if (!c->IsAlive())
+                    fallen.push_back(c);
+        }
+        return fallen;
+    }
+
+    bool HasFallenToRaise() const { return !FallenScarlet().empty(); }
+
+    // Mass Resurrection: the dead Crusade in the cathedral get back up
+    void RaiseTheFallen()
+    {
+        if (!me->IsAlive())
+            return;
+
+        for (Creature* corpse : FallenScarlet())
+        {
+            corpse->setDeathState(JUST_RESPAWNED);
+            if (corpse->IsAIEnabled)
+                if (Player* player = corpse->SelectNearestPlayer(100.0f))
+                    corpse->AI()->AttackStart(player);
+        }
+    }
+
+    EventMap _raiseEvents;
+    bool _raising;
+    bool _raised;
+};
+
+// Blades of the Anointed 126787 / 126843: used at Whitemane's corpse (spell focus), they lay her to rest
+class spell_scm_blades_of_the_anointed : public SpellScript
+{
+    PrepareSpellScript(spell_scm_blades_of_the_anointed);
+
+    // credit before target selection: the item's dummy effect has no nearby target to hit
+    void HandleBeforeCast()
+    {
+        if (Player* player = GetCaster()->ToPlayer())
+        {
+            player->KilledMonsterCredit(NPC_UNTO_DUST_CREDIT);
+            player->KilledMonsterCredit(NPC_UNTO_DUST_CREDIT_2);
+        }
+    }
+
+    void Register() override
+    {
+        BeforeCast += SpellCastFn(spell_scm_blades_of_the_anointed::HandleBeforeCast);
+    }
+};
+
+void AddSC_boss_durand_and_whitemane()
+{
+    RegisterCreatureAIWithFactory(boss_commander_durand, GetScarletMonasteryAI);
+    RegisterCreatureAIWithFactory(boss_high_inquisitor_whitemane_mop, GetScarletMonasteryAI);
+    RegisterSpellScript(spell_scm_blades_of_the_anointed);
+}
