+// SI:7 Ranger / Kor'kron Scout.
+//
+// Only the two behind the Suspicious Rock and the Inconspicuous Crate are
+// rescued through their hiding place. Every other one (the three caged ones
+// beside Lava Guard Gordoth, and the ones lying around the cave) is rescued
+// by talking to it. Their template keeps them unselectable, so before this
+// only the rock and the crate could be used.
+class npc_rfc_prisoner : public CreatureScript
+{
+public:
+    npc_rfc_prisoner() : CreatureScript("npc_rfc_prisoner") { }
+
+    struct npc_rfc_prisonerAI : public ScriptedAI
+    {
+        npc_rfc_prisonerAI(Creature* creature) : ScriptedAI(creature) { }
+
+        void Reset() override
+        {
+            me->SetReactState(REACT_PASSIVE);
+            _checkTimer = 1000;
+        }
+
+        void UpdateAI(uint32 diff) override
+        {
+            // Wait a moment so the hiding props near us have been created.
+            if (!_checkTimer)
+                return;
+
+            if (_checkTimer > diff)
+            {
+                _checkTimer -= diff;
+                return;
+            }
+            _checkTimer = 0;
+
+            if (!me->HasUnitFlag(UNIT_FLAG_STUNNED)) // already rescued
+                return;
+
+            if (me->FindNearestCreature(RagefireChasm::NPC_SUSPICIOUS_ROCK, 3.0f, true) ||
+                me->FindNearestCreature(RagefireChasm::NPC_INCONSPICUOUS_CRATE, 3.0f, true))
+                return;
+
+            me->RemoveUnitFlag(UNIT_FLAG_NOT_SELECTABLE);
+            me->AddNpcFlag(UNIT_NPC_FLAG_GOSSIP);
+        }
+
+    private:
+        uint32 _checkTimer = 1000;
+    };
+
+    CreatureAI* GetAI(Creature* creature) const override
+    {
+        return new npc_rfc_prisonerAI(creature);
+    }
+
+    bool OnGossipHello(Player* player, Creature* creature) override
+    {
+        CloseGossipMenuFor(player);
+
+        if (RagefireChasm::GetNeededCreditEntry(player) != creature->GetEntry())
+            return true;
+
+        // A caged prisoner opens its cage on the way out.
+        GameObject* cage = nullptr;
+        for (uint32 entry : { RagefireChasm::GO_RANGER_CAGE_1, RagefireChasm::GO_RANGER_CAGE_2, RagefireChasm::GO_RANGER_CAGE_3 })
+        {
+            if (GameObject* go = creature->FindNearestGameObject(entry, 3.0f))
+            {
+                cage = go;
+                break;
+            }
+        }
+
+        if (cage)
+            cage->UseDoorOrButton(0, false, player);
+
+        RagefireChasm::FreePrisoner(player, creature, cage ? static_cast<WorldObject*>(cage) : creature);
+        return true;
+    }
+};
