+    // .debug scenario: lists every step and criteria of the instance scenario you are in, with its progress
+    static bool HandleDebugScenarioCommand(ChatHandler* handler, char const* /*args*/)
+    {
+        Player* player = handler->GetSession()->GetPlayer();
+        Scenario* scenario = player->GetScenario();
+        if (!scenario || !scenario->GetData())
+        {
+            handler->SendSysMessage("You are not in a scenario.");
+            handler->SetSentErrorMessage(true);
+            return false;
+        }
+
+        LocaleConstant locale = handler->GetSessionDbcLocale();
+        ScenarioStepEntry const* currentStep = scenario->GetStep();
+        handler->PSendSysMessage("Scenario %u \"%s\", current step %u.", scenario->GetEntry()->ID, scenario->GetEntry()->Name->Str[locale], currentStep ? currentStep->ID : 0);
+
+        std::function<void(CriteriaTree const*, std::string const&)> printTree = [&](CriteriaTree const* tree, std::string const& indent)
+        {
+            std::ostringstream line;
+            line << indent << "tree " << tree->ID;
+            if (*tree->Entry->Description->Str[locale])
+                line << " \"" << tree->Entry->Description->Str[locale] << "\"";
+            line << " (operator " << int32(tree->Entry->Operator) << ", amount " << tree->Entry->Amount << ")";
+            if (Criteria const* criteria = tree->Criteria)
+            {
+                line << ": criteria " << criteria->ID << " " << CriteriaMgr::GetCriteriaTypeString(uint32(criteria->Entry->Type))
+                    << " (" << criteria->Entry->Type << ") asset " << criteria->Entry->Asset.ID
+                    << ", progress " << scenario->GetCriteriaCounter(criteria);
+                if (criteria->Entry->ModifierTreeId)
+                    line << ", modifier tree " << criteria->Entry->ModifierTreeId;
+                if (criteria->Entry->StartEvent)
+                    line << ", start event " << uint32(criteria->Entry->StartEvent) << "/" << criteria->Entry->StartAsset;
+                if (criteria->Entry->FailEvent)
+                    line << ", fail event " << uint32(criteria->Entry->FailEvent) << "/" << criteria->Entry->FailAsset;
+            }
+            handler->SendSysMessage(line.str().c_str());
+
+            for (CriteriaTree const* child : tree->Children)
+                printTree(child, indent + ". ");
+        };
+
+        for (auto const& stepPair : scenario->GetData()->Steps)
+        {
+            ScenarioStepEntry const* step = stepPair.second;
+            handler->PSendSysMessage("Step %u (order %u%s) \"%s\": state %u, criteria tree %u.", step->ID, uint32(step->OrderIndex),
+                step->IsBonusObjective() ? ", bonus" : "", step->Title->Str[locale], uint32(scenario->GetStepState(step)), step->Criteriatreeid);
+
+            if (CriteriaTree const* tree = sCriteriaMgr->GetCriteriaTree(step->Criteriatreeid))
+                printTree(tree, ". ");
+        }
+
+        return true;
     }
 
