+// Scarlet Defender 58998, called in by Harlan. They run in along the balconies in heavy armor.
+struct npc_harlan_scarlet_defender : public ScriptedAI
+{
+    npc_harlan_scarlet_defender(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(Unit* /*summoner*/) override
+    {
+        DoCast(me, SPELL_HEAVY_ARMOR, true);
+        me->SetReactState(REACT_PASSIVE);
+        me->GetMotionMaster()->MoveSmoothPath(1, urand(0, 1) ? DefenderPath1 : DefenderPath2, 6, false);
+    }
+
+    void MovementInform(uint32 type, uint32 pointId) override
+    {
+        if (type == EFFECT_MOTION_TYPE && pointId == 1)
+        {
+            me->SetReactState(REACT_AGGRESSIVE);
+            DoZoneInCombat();
+        }
+    }
+
+    void UpdateAI(uint32 /*diff*/) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        DoMeleeAttackIfReady();
+    }
+};
