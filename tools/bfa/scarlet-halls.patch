+// Master Archer 59175
+struct npc_scarlet_master_archer : public ScriptedAI
+{
+    npc_scarlet_master_archer(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        SetCombatMovement(false);
+        me->SetReactState(REACT_DEFENSIVE);
+    }
+
+    void DoAction(int32 actionId) override
+    {
+        switch (actionId)
+        {
+            case ACTION_FIRE_AT_LINE:
+                me->SetReactState(REACT_AGGRESSIVE);
+                DoZoneInCombat();
+                _events.ScheduleEvent(EVENT_FIRE_AT_ROW, urand(1000, 2000));
+                break;
+            case ACTION_MELEE:
+                _events.Reset();
+                SetCombatMovement(true);
+                me->SetReactState(REACT_AGGRESSIVE);
+                if (Player* player = me->SelectNearestPlayer(60.0f))
+                    AttackStart(player);
+                _events.ScheduleEvent(EVENT_BLEEDING_WOUND, urand(2500, 4500));
+                break;
+            case -1: // Lindon evaded
+                EnterEvadeMode(EVADE_REASON_OTHER);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        _events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_FIRE_AT_ROW:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 60.0f, true))
+                        DoCast(target, SPELL_PIERCING_ARROW);
+                    _events.ScheduleEvent(EVENT_FIRE_AT_ROW, urand(1500, 3000));
+                    break;
+                case EVENT_BLEEDING_WOUND:
+                    if (me->IsWithinMeleeRange(me->GetVictim()))
+                        DoCastVictim(SPELL_BLEEDING_WOUND);
+                    _events.ScheduleEvent(EVENT_BLEEDING_WOUND, urand(5500, 6500));
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+};
