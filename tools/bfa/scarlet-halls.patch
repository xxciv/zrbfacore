+// Angry Hound 58674
+// Chained to a post: ignores players until one comes within reach of the chain (5 yards), and while
+// still chained it can't follow anyone past the end of the chain. The first attack or damage it
+// takes snaps the chain (Chained comes off) and from then on it chases like any other hound.
+float const AngryHoundChainLength = 8.0f;
+
+struct npc_angry_hound : public ScriptedAI
+{
+    npc_angry_hound(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        _events.ScheduleEvent(EVENT_LEASH, 1000);
+        _chained = true;
+        _chasing = true;
+        me->SetReactState(REACT_PASSIVE);
+        // back on its post after a reset
+        if (!me->HasAura(SPELL_CHAINED))
+            DoCast(me, SPELL_CHAINED, true);
+    }
+
+    void JustEngagedWith(Unit* who) override
+    {
+        // pulled by an attack (from stealth, or from range) or by a neighbour calling for help;
+        // only the attack itself (damage or a hostile spell, below) snaps the chain
+        me->SetReactState(REACT_AGGRESSIVE);
+        AttackStart(who);
+    }
+
+    void DamageTaken(Unit* attacker, uint32& /*damage*/) override
+    {
+        if (attacker && attacker != me)
+            BreakChain();
+    }
+
+    void SpellHit(Unit* caster, SpellInfo const* spell) override
+    {
+        // a stun or snare from a player counts as an attack too
+        if (caster && caster != me && !spell->IsPositive() && me->IsValidAttackTarget(caster))
+            BreakChain();
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_LEASH)
+        {
+            // stakes can load after the hound, so keep trying until one is there
+            if (Creature* stake = me->FindNearestCreature(NPC_STAKE, 20.0f))
+                stake->CastSpell(me, SPELL_LEASHED, true);
+            else
+                _events.ScheduleEvent(EVENT_LEASH, 1000);
+        }
+
+        if (!me->IsInCombat())
+        {
+            if (Player* player = me->SelectNearestPlayer(5.0f))
+                if (me->IsValidAttackTarget(player))
+                {
+                    me->SetReactState(REACT_AGGRESSIVE);
+                    AttackStart(player);
+                }
+            return;
+        }
+
+        if (me->HasReactState(REACT_PASSIVE))
+            me->SetReactState(REACT_AGGRESSIVE);
+
+        if (!UpdateVictim())
+            return;
+
+        if (_chained)
+        {
+            // still on the chain: wait at the post for anyone out of reach, without resetting
+            Unit* victim = me->GetVictim();
+            bool const inReach = victim->GetDistance(me->GetHomePosition()) <= AngryHoundChainLength;
+            if (!inReach && _chasing)
+            {
+                _chasing = false;
+                me->GetMotionMaster()->Clear();
+                me->GetMotionMaster()->MovePoint(0, me->GetHomePosition());
+            }
+            else if (inReach && !_chasing)
+            {
+                _chasing = true;
+                me->GetMotionMaster()->Clear();
+                me->GetMotionMaster()->MoveChase(victim);
+            }
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    void BreakChain()
+    {
+        if (!_chained)
+            return;
+
+        _chained = false;
+        _events.Reset();
+        me->RemoveAurasDueToSpell(SPELL_LEASHED);
+        me->RemoveAurasDueToSpell(SPELL_CHAINED);
+        me->SetReactState(REACT_AGGRESSIVE);
+        if (!_chasing)
+        {
+            _chasing = true;
+            if (Unit* victim = me->GetVictim())
+            {
+                me->GetMotionMaster()->Clear();
+                me->GetMotionMaster()->MoveChase(victim);
+            }
+        }
+    }
+
+    EventMap _events;
+    bool _chained = true;
+    bool _chasing = true;
+};
