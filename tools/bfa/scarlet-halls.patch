+// Starving Hound 58876
+// Hungry Dog is a 30 s stun channel; the hound lets go after 4 s so a solo player is not pinned down.
+// When a Vigilant Watchman is hit by a thrown bucket of dog food, the hounds around him turn on him.
+struct npc_starving_hound : public ScriptedAI
+{
+    npc_starving_hound(Creature* creature) : ScriptedAI(creature), _fed(false) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        if (!_fed)
+            _events.ScheduleEvent(EVENT_HUNGRY_DOG, urand(5000, 8000));
+    }
+
+    void SetGUID(ObjectGuid guid, int32 /*id*/) override
+    {
+        // guid is a watchman covered in dog food
+        Creature* watchman = ObjectAccessor::GetCreature(*me, guid);
+        if (!watchman || _fed)
+            return;
+
+        _fed = true;
+        _events.Reset();
+        me->InterruptNonMeleeSpells(false);
+        me->SetFaction(FACTION_HOUNDS_TURNED);
+        me->CombatStop(true);
+        me->GetThreatManager().ClearAllThreat();
+        me->SetReactState(REACT_AGGRESSIVE);
+        AttackStart(watchman);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+        {
+            if (_fed && !me->HasUnitState(UNIT_STATE_EVADE) && me->GetEmoteState() != EMOTE_STATE_EAT)
+            {
+                // the watchman is gone: sit down and eat
+                me->SetFaction(35); // friendly to all
+                me->SetReactState(REACT_PASSIVE);
+                me->SetEmoteState(EMOTE_STATE_EAT);
+            }
+            return;
+        }
+
+        _events.Update(diff);
+
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_HUNGRY_DOG:
+                    if (Unit* victim = me->GetVictim())
+                        DoCast(victim, SPELL_HUNGRY_DOG);
+                    _events.ScheduleEvent(EVENT_HUNGRY_DOG_RELEASE, 4000);
+                    _events.ScheduleEvent(EVENT_HUNGRY_DOG, urand(20000, 25000));
+                    break;
+                case EVENT_HUNGRY_DOG_RELEASE:
+                    me->InterruptNonMeleeSpells(false, SPELL_HUNGRY_DOG);
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    EventMap _events;
+    bool _fed;
+};
