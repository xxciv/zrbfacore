+// Commander Lindon 59191
+// Stands at the end of the archery hall while his Master Archers shoot down the rows. Reaching him
+// (10 yards) ends the volleys and the whole crew draws blades.
+struct npc_commander_lindon : public BossAI
+{
+    npc_commander_lindon(Creature* creature) : BossAI(creature, DATA_COMMANDER_LINDON), _started(false), _melee(false), _explosion(false) { }
+
+    enum Texts
+    {
+        TALK_INTRO       = 1,
+        TALK_RANGE_REACH = 2,
+        TALK_MELEE_REACH = 3,
+    };
+
+    void Reset() override
+    {
+        _Reset();
+        _volleys.Reset();
+        _started = false;
+        _melee = false;
+        _explosion = false;
+        SetCombatMovement(false);
+        me->SetReactState(REACT_DEFENSIVE);
+    }
+
+    void MoveInLineOfSight(Unit* who) override
+    {
+        if (!_started && who->GetTypeId() == TYPEID_PLAYER && me->IsValidAttackTarget(who) &&
+            me->IsWithinDistInMap(who, 70.0f) && me->IsWithinLOSInMap(who))
+        {
+            _started = true;
+            Talk(TALK_INTRO);
+            me->SetReactState(REACT_AGGRESSIVE);
+            AttackStart(who);
+            DoZoneInCombat();
+            SendArchers(ACTION_FIRE_AT_LINE);
+            _volleys.ScheduleEvent(EVENT_SHIELD_BREAKER, urand(5000, 6000));
+        }
+    }
+
+    void DoAction(int32 actionId) override
+    {
+        if (actionId == ACTION_GROUND_EXPLOSION && _started && !_melee && !_explosion)
+        {
+            _explosion = true;
+            Talk(TALK_RANGE_REACH);
+            Position const& start = urand(0, 1) ? ExplodingStartPos1 : ExplodingStartPos2;
+            for (uint8 i = 0; i < 3; ++i)
+                me->CastSpell(start.GetPositionX() + 12.0f * i, start.GetPositionY(), start.GetPositionZ(), SPELL_EXPLODING_SHOT, true);
+        }
+    }
+
+    void EnterEvadeMode(EvadeReason why) override
+    {
+        if (instance)
+            instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_HEROIC_DEFENSE);
+        SendArchers(ACTION_MELEE, true);
+        BossAI::EnterEvadeMode(why);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _JustDied();
+        if (instance)
+            instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_HEROIC_DEFENSE);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        _volleys.Update(diff);
+        if (_volleys.ExecuteEvent() == EVENT_SHIELD_BREAKER)
+        {
+            if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 18.0f, true))
+                DoCast(target, SPELL_SHIELD_BREAKER, true);
+            _volleys.ScheduleEvent(EVENT_SHIELD_BREAKER, urand(4000, 6000));
+        }
+
+        if (!_melee)
+        {
+            if (Player* player = me->SelectNearestPlayer(10.0f))
+            {
+                _melee = true;
+                _volleys.Reset();
+                Talk(TALK_MELEE_REACH);
+                SetCombatMovement(true);
+                AttackStart(player);
+                SendArchers(ACTION_MELEE);
+                if (instance)
+                    instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_HEROIC_DEFENSE);
+            }
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    void SendArchers(int32 action, bool evading = false)
+    {
+        std::list<Creature*> archers;
+        me->GetCreatureListWithEntryInGrid(archers, NPC_MASTER_ARCHER, 60.0f);
+        for (Creature* archer : archers)
+            if (archer->IsAlive() && archer->IsAIEnabled && (!evading || archer->IsInCombat()))
+                archer->AI()->DoAction(evading ? -1 : action);
+    }
+
+    EventMap _volleys;
+    bool _started;
+    bool _melee;
+    bool _explosion;
+};
