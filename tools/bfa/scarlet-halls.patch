+    }
+
+    void JustSummoned(Creature* summon) override
+    {
+        _cannoneer = summon->GetGUID();
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+        if (_events.ExecuteEvent() != EVENT_SUMMON_CANNONEER || !_cannoneer.IsEmpty())
+            return;
+
+        // The stalker sits in the middle of the gun and faces its breech; the muzzle points the other
+        // way. On the stalker the cannoneer stood inside the barrel, and moved back he stood in front
+        // of the muzzle. He belongs beside the breech, facing where the gun fires.
+        Position pos = me->GetPosition();
+        me->MovePositionToFirstCollision(pos, std::sqrt(CannoneerForward * CannoneerForward + CannoneerSide * CannoneerSide), -std::atan2(CannoneerSide, CannoneerForward));
+        pos.SetOrientation(Position::NormalizeOrientation(me->GetOrientation() + float(M_PI)));
+        me->SummonCreature(NPC_SCARLET_CANNONEER, pos, TEMPSUMMON_CORPSE_TIMED_DESPAWN, 300 * IN_MILLISECONDS);
+    }
+
+    // towards the breech, then out to the gun's right
+    static constexpr float CannoneerForward = 1.5f;
+    static constexpr float CannoneerSide = 1.3f;
+
+private:
+    EventMap _events;
+    ObjectGuid _cannoneer;
+};
+
+// Scarlet Cannoneer 59293: shells players in the courtyard. The shell is fired by the cannoneer
+// himself: the gun is a level 1 friendly stalker, so its blasts hit nobody and did no damage.
+struct npc_scarlet_cannoneer : public ScriptedAI
+{
+    npc_scarlet_cannoneer(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        _events.Reset();
+        SetCombatMovement(false);
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _events.ScheduleEvent(EVENT_CANNON_READY, urand(1500, 4000));
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        _events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        if (_events.ExecuteEvent() == EVENT_CANNON_READY)
+        {
+            if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 40.0f, true))
+            {
+                DoCast(me, SPELL_FIRE_CANNON, true);
+                me->CastSpell(AimAt(target), SPELL_CANNON_BLAST_DAMAGE, true);
+            }
+            _events.ScheduleEvent(EVENT_CANNON_READY, urand(3000, 5000));
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    // The shell flies for a while and only hits within 3 yards of where it lands, so aimed at
+    // a walking player's feet it always landed behind them. Lead the target instead.
+    Position AimAt(Unit* target) const
+    {
+        Position pos = target->GetPosition();
+        if (!target->isMoving())
+            return pos;
+
+        SpellInfo const* shell = sSpellMgr->GetSpellInfo(SPELL_CANNON_BLAST_DAMAGE);
+        float flightTime = shell && shell->Speed > 0.0f ? me->GetDistance(target) / shell->Speed : 0.5f;
+        float travel = std::min(target->GetSpeed(target->IsWalking() ? MOVE_WALK : MOVE_RUN) * flightTime, 10.0f);
+
+        float direction = target->GetOrientation();
+        if (target->HasUnitMovementFlag(MOVEMENTFLAG_BACKWARD))
+            direction += float(M_PI);
+        if (target->HasUnitMovementFlag(MOVEMENTFLAG_STRAFE_LEFT))
+            direction += float(M_PI) / 2;
+        if (target->HasUnitMovementFlag(MOVEMENTFLAG_STRAFE_RIGHT))
+            direction -= float(M_PI) / 2;
+
+        target->MovePosition(pos, travel, direction - target->GetOrientation());
+        return pos;
+    }
+
+    EventMap _events;
+};
+
+// Hooded Crusader 64738: the one outside Koegler's library walks in once he is dead
+struct npc_scarlet_hooded_crusader : public ScriptedAI
+{
+    npc_scarlet_hooded_crusader(Creature* creature) : ScriptedAI(creature), _point(0) { }
+
+    enum Texts
+    {
+        TALK_INTRO = 0,
+        TALK_CODEX = 1,
+    };
+
+    void DoAction(int32 actionId) override
+    {
+        if (actionId == ACTION_CODEX && _point == 0)
+            _events.ScheduleEvent(EVENT_ESCORT, 1000);
+    }
+
+    void MovementInform(uint32 type, uint32 pointId) override
+    {
+        if (type != POINT_MOTION_TYPE)
+            return;
+
+        if (pointId == 0)
+        {
+            Talk(TALK_INTRO, me->SelectNearestPlayer(80.0f));
+            _point = 1;
+            _events.ScheduleEvent(EVENT_ESCORT, 6000);
+        }
+        else if (pointId == 1)
+        {
+            me->SetFacingTo(HoodedCrusaderPath[1].GetOrientation());
+            Talk(TALK_CODEX, me->SelectNearestPlayer(80.0f));
+            _point = 2;
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+        if (_events.ExecuteEvent() == EVENT_ESCORT && _point < 2)
+            me->GetMotionMaster()->MovePoint(_point, HoodedCrusaderPath[_point]);
+    }
+
+private:
+    EventMap _events;
+    uint8 _point;
+};
+
+// Throw Bucket of Meaty Dog Food 113029
+class spell_throw_bucket_meaty_dog : public SpellScript
+{
+    PrepareSpellScript(spell_throw_bucket_meaty_dog);
+
+    SpellCastResult CheckCast()
+    {
+        Unit* caster = GetCaster();
+        if (caster->IsInCombat())
+        {
+            caster->RemoveAurasDueToSpell(SPELL_CARRYING_BUCKET);
+            return SPELL_FAILED_AFFECTING_COMBAT;
+        }
+
+        return SPELL_CAST_OK;
+    }
+
+    void Register() override
+    {
+        OnCheckCast += SpellCheckCastFn(spell_throw_bucket_meaty_dog::CheckCast);
+    }
+};
+
+// Dog Food 111894: only Vigilant Watchmen near the splash count (the spell's own radius is 2 yards)
+class spell_scarlet_halls_dog_food : public SpellScript
+{
+    PrepareSpellScript(spell_scarlet_halls_dog_food);
+
+    void FilterTargets(std::list<WorldObject*>& targets)
+    {
+        targets.clear();
+
+        WorldLocation const* dest = GetExplTargetDest();
+        if (!dest)
+            return;
+
+        std::list<Creature*> watchmen;
+        GetCaster()->GetCreatureListWithEntryInGrid(watchmen, NPC_VIGILANT_WATCHMAN, 60.0f);
+        for (Creature* watchman : watchmen)
+            if (watchman->IsAlive() && watchman->GetExactDist2d(dest) <= 8.0f)
+                targets.push_back(watchman);
+    }
+
+    void HandleHit(SpellEffIndex /*effIndex*/)
+    {
+        Creature* watchman = GetHitCreature();
+        if (!watchman)
+            return;
+
+        watchman->InterruptNonMeleeSpells(false);
+        watchman->CastSpell(watchman, SPELL_HOUNDMASTER_EATEN, true);
+
+        std::list<Creature*> hounds;
+        watchman->GetCreatureListWithEntryInGrid(hounds, NPC_STARVING_HOUND, 20.0f);
+        for (Creature* hound : hounds)
+            if (hound->IsAlive() && hound->IsAIEnabled)
+                hound->AI()->SetGUID(watchman->GetGUID());
+    }
+
+    void Register() override
+    {
+        OnObjectAreaTargetSelect += SpellObjectAreaTargetSelectFn(spell_scarlet_halls_dog_food::FilterTargets, EFFECT_0, TARGET_UNIT_DEST_AREA_ENEMY);
+        OnEffectHitTarget += SpellEffectFn(spell_scarlet_halls_dog_food::HandleHit, EFFECT_0, SPELL_EFFECT_DUMMY);
+    }
+};
+
+// Heroic Defense 113436: the archery target goes back on its stand when the shield is dropped
+class spell_scarlet_halls_heroic_defense : public AuraScript
+{
+    PrepareAuraScript(spell_scarlet_halls_heroic_defense);
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        if (Unit* caster = GetCaster())
+            if (Creature* target = caster->ToCreature())
+                target->DespawnOrUnsummon(0, Seconds(5));
+    }
+
+    void Register() override
+    {
+        OnEffectRemove += AuraEffectRemoveFn(spell_scarlet_halls_heroic_defense::HandleRemove, EFFECT_1, SPELL_AURA_MOD_DECREASE_SPEED, AURA_EFFECT_HANDLE_REAL);
+    }
+};
+
+// AreaTrigger 7532: the archery hall
+class AreaTrigger_at_commander_lindon : public AreaTriggerScript
+{
+public:
+    AreaTrigger_at_commander_lindon() : AreaTriggerScript("AreaTrigger_at_commander_lindon") { }
+
+    bool OnTrigger(Player* player, AreaTriggerEntry const* /*trigger*/, bool entered) override
+    {
+        if (!entered)
+            return false;
+
+        if (InstanceScript* instance = player->GetInstanceScript())
+            if (Creature* lindon = instance->GetCreature(DATA_COMMANDER_LINDON))
+                if (lindon->IsAIEnabled)
+                    lindon->AI()->DoAction(ACTION_GROUND_EXPLOSION);
+
+        if (player->GetPositionX() > 950.0f)
+            player->RemoveAurasDueToSpell(SPELL_HEROIC_DEFENSE);
+
+        return false;
+    }
+};
+
+void AddSC_scarlet_halls()
+{
+    RegisterCreatureAI(npc_starving_hound);
+    RegisterCreatureAI(npc_angry_hound);
+    RegisterCreatureAI(npc_bucket_of_meaty_dog_food);
+    RegisterCreatureAI(npc_reinforced_archery_target);
+    RegisterCreatureAI(npc_commander_lindon);
+    RegisterCreatureAI(npc_scarlet_master_archer);
+    RegisterCreatureAI(npc_scarlet_cannon_stalker);
+    RegisterCreatureAI(npc_scarlet_cannoneer);
+    RegisterCreatureAI(npc_scarlet_hooded_crusader);
+    RegisterSpellScript(spell_throw_bucket_meaty_dog);
+    RegisterSpellScript(spell_scarlet_halls_dog_food);
+    RegisterAuraScript(spell_scarlet_halls_heroic_defense);
+    new AreaTrigger_at_commander_lindon();
+}
