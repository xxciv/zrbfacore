+// Blades of Light 111394: every second, hit everyone in the spin
+class spell_harlan_blades_of_light_proc : public SpellScript
+{
+    PrepareSpellScript(spell_harlan_blades_of_light_proc);
+
+    void HandleDummy(SpellEffIndex /*effIndex*/)
+    {
+        if (Unit* target = GetHitUnit())
+            GetCaster()->CastSpell(target, SPELL_BLADES_OF_LIGHT_HIT, true);
+    }
+
+    void Register() override
+    {
+        OnEffectHitTarget += SpellEffectFn(spell_harlan_blades_of_light_proc::HandleDummy, EFFECT_0, SPELL_EFFECT_DUMMY);
+    }
+};
+
+// Heavy Armor 113959: once the shield is broken the defender is left Unarmored
+class spell_harlan_heavy_armor : public AuraScript
+{
+    PrepareAuraScript(spell_harlan_heavy_armor);
+
+    void HandleRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        if (GetTargetApplication()->GetRemoveMode() == AURA_REMOVE_BY_ENEMY_SPELL)
+            GetTarget()->CastSpell(GetTarget(), SPELL_UNARMORED, true);
+    }
+
+    void Register() override
+    {
+        OnEffectRemove += AuraEffectRemoveFn(spell_harlan_heavy_armor::HandleRemove, EFFECT_1, SPELL_AURA_SCHOOL_ABSORB, AURA_EFFECT_HANDLE_REAL);
     }
 };
 
