+// Reinforced Archery Target 59163
+// The player picks the target up as a moving shield: it goes ahead of them and gives Heroic Defense
+// (75% less damage taken, slower, no attacking). Leaving the gauntlet or reaching Lindon drops it, and
+// it goes back on its stand.
+struct npc_reinforced_archery_target : public ScriptedAI
+{
+    npc_reinforced_archery_target(Creature* creature) : ScriptedAI(creature) { }
+
+    enum Texts
+    {
+        TALK_INTRO = 1,
+    };
+
+    void Reset() override
+    {
+        _carrier.Clear();
+        me->SetReactState(REACT_PASSIVE);
+        me->AddNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+    }
+
+    void OnSpellClick(Unit* clicker, bool& /*result*/) override
+    {
+        if (!me->HasNpcFlag(UNIT_NPC_FLAG_SPELLCLICK) || clicker->HasAura(SPELL_HEROIC_DEFENSE))
+            return;
+
+        // nothing left to shield against
+        if (InstanceScript* instance = me->GetInstanceScript())
+            if (instance->GetBossState(DATA_COMMANDER_LINDON) == DONE)
+                return;
+
+        // Added directly: as a cast it never landed, because the spell's first effect wants
+        // the player to be a vehicle the target rides on.
+        if (!me->AddAura(SPELL_HEROIC_DEFENSE, clicker))
+            return;
+
+        _carrier = clicker->GetGUID();
+        _moveTimer = 0;
+        me->RemoveNpcFlag(UNIT_NPC_FLAG_SPELLCLICK);
+        me->SetWalk(false);
+        Talk(TALK_INTRO, clicker);
+    }
+
+    void DamageTaken(Unit* /*attacker*/, uint32& damage) override
+    {
+        if (damage >= me->GetHealth())
+            damage = me->GetHealth() - 1;
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (_carrier.IsEmpty())
+            return;
+
+        // shield dropped (Lindon reached or dead, past the hall, carrier died): back on the stand
+        Unit* carrier = ObjectAccessor::GetUnit(*me, _carrier);
+        if (!carrier || !carrier->IsAlive() || !carrier->HasAura(SPELL_HEROIC_DEFENSE, me->GetGUID()))
+        {
+            _carrier.Clear();
+            me->DespawnOrUnsummon(0, Seconds(5));
+            return;
+        }
+
+        // held just in front of the carrier, bullseye towards the archers
+        if (_moveTimer > diff)
+        {
+            _moveTimer -= diff;
+            return;
+        }
+        _moveTimer = 100;
+
+        // lead further while the carrier walks, so the target never drops back level with them
+        float lead = ArcheryTargetLead;
+        if (carrier->isMoving())
+            lead += carrier->GetSpeed(MOVE_RUN) * 0.2f;
+
+        float x, y, z;
+        carrier->GetClosePoint(x, y, z, me->GetObjectSize(), lead, 0.0f);
+        float const facing = carrier->GetOrientation();
+
+        if (me->GetExactDist2d(x, y) > 0.5f)
+        {
+            Movement::MoveSplineInit init(me);
+            init.MoveTo(x, y, z, false);
+            init.SetVelocity(std::max(carrier->GetSpeed(MOVE_RUN) * 1.5f, 4.0f));
+            init.SetOrientationFixed(true);
+            init.SetFacing(facing);
+            init.Launch();
+        }
+        else if (me->movespline->Finalized())
+        {
+            float turn = Position::NormalizeOrientation(me->GetOrientation() - facing);
+            if (turn > 0.2f && turn < 2 * float(M_PI) - 0.2f)
+                me->SetFacingTo(facing);
+        }
+    }
+
+private:
+    static constexpr float ArcheryTargetLead = 1.0f;
+
+    ObjectGuid _carrier;
+    uint32 _moveTimer = 0;
+};
