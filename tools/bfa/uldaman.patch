+// The dig team at the entrance is spawned twice on the same spots, once per faction.
+// Only the team of the players inside stays.
+static bool IsAllianceDigTeam(uint32 entry)
+{
+    switch (entry)
+    {
+        case 46232: // Explorer's League Digger
+        case 46233: // Olga Runesworn
+        case 46234: // Lead Prospector Durdin
+        case 46247: // Kand Sandseeker
+            return true;
+        default:
+            return false;
+    }
+}
+
+static bool IsHordeDigTeam(uint32 entry)
+{
+    switch (entry)
+    {
+        case 46231: // Reliquary Digger
+        case 46235: // Lidia Sunglow
+        case 46236: // High Examiner Tae'thelan Bloodwatcher
+        case 46241: // Aoren Sunglow
+            return true;
+        default:
+            return false;
+    }
+}
