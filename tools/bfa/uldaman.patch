+        case 46231: // Reliquary Digger
+        case 46235: // Lidia Sunglow
+        case 46236: // High Examiner Tae'thelan Bloodwatcher
+        case 46241: // Aoren Sunglow
+            return true;
+        default:
+            return false;
+    }
+}
