--- a/src/server/game/Handlers/QuestHandler.cpp
+++ b/src/server/game/Handlers/QuestHandler.cpp
@@ -200,6 +200,23 @@ void WorldSession::HandleQuestgiverAcceptQuestOpcode(WorldPackets::Quest::QuestG
                 }
             }
 
+            // zrbfacore: a quest accepted from an NPC's quest list (greeting with two or more quests,
+            // e.g. Sharing the Land at Ahmo Thunderhorn or Tonga Runetotem) left the details page
+            // open: the client goes back to the quest list after Accept and ignores the plain close.
+            // Send the NPC's updated quest list instead, as retail does; close only when nothing is left.
+            if (object->GetTypeId() == TYPEID_UNIT || object->GetTypeId() == TYPEID_GAMEOBJECT)
+            {
+                if (_player->PlayerTalkClass->GetQuestListGiver() == object->GetGUID())
+                {
+                    _player->PrepareQuestMenu(object->GetGUID());
+                    if (!_player->PlayerTalkClass->GetQuestMenu().Empty())
+                    {
+                        _player->PlayerTalkClass->SendQuestGiverQuestListMessage(object);
+                        return;
+                    }
+                }
+            }
+
             _player->PlayerTalkClass->SendCloseGossip();
 
             return;
