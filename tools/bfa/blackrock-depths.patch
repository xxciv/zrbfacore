+        void SendScenarioEvent(uint32 eventId)
+        {
+            InstanceScenario* scenario = instance->ToInstanceMap() ? instance->ToInstanceMap()->GetInstanceScenario() : nullptr;
+            if (!scenario)
+                return;
+
+            // once: the scenario's progress is shared by the whole group
+            Map::PlayerList const& players = instance->GetPlayers();
+            for (Map::PlayerList::const_iterator itr = players.begin(); itr != players.end(); ++itr)
+                if (Player* player = itr->GetSource())
+                {
+                    scenario->SendScenarioEvent(player, eventId);
+                    return;
+                }
+        }
+
+        void OnPlayerEnter(Player* player) override
+        {
+            if (!_team)
+            {
+                _team = player->GetTeam();
+                for (ObjectGuid const& guid : _factionQuestgivers)
+                    if (Creature* questgiver = instance->GetCreature(guid))
+                        UpdateFactionQuestgiver(questgiver);
+            }
+
+            InstanceMap* map = instance->ToInstanceMap();
+            if (!map || map->GetInstanceScenario())
+                return;
+
+            if (_wing == WING_NONE)
+            {
+                _wing = WING_WHOLE_DUNGEON;
+                if (Group* group = player->GetGroup())
+                {
+                    if (group->isLFGGroup())
+                    {
+                        switch (sLFGMgr->GetDungeon(group->GetGUID()))
+                        {
+                            case LFG_DUNGEON_DETENTION_BLOCK: _wing = WING_DETENTION_BLOCK; break;
+                            case LFG_DUNGEON_UPPER_CITY:      _wing = WING_UPPER_CITY; break;
+                            default:                          _wing = WING_NONE; break; // Coren Direbrew and other events: no scenario
+                        }
+                    }
+                }
+
+                TC_LOG_DEBUG("scripts", "Instance Blackrock Depths: instance %u wing %u.", instance->GetInstanceId(), _wing);
+                if (_wing == WING_NONE)
+                    return;
+
+                BuildSaveData();
+                SaveToDB();
+            }
+
+            uint32 scenarioId = _wing == WING_DETENTION_BLOCK ? SCENARIO_DETENTION_BLOCK
+                : _wing == WING_UPPER_CITY ? SCENARIO_UPPER_CITY : SCENARIO_WHOLE_DUNGEON;
+            if (InstanceScenario* scenario = sScenarioMgr->CreateInstanceScenarioForMap(instance, scenarioId))
+                map->SetInstanceScenario(scenario);
+        }
