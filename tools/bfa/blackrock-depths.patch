+    LFG_DUNGEON_DETENTION_BLOCK         = 30,
+    LFG_DUNGEON_UPPER_CITY              = 276,
+
+    SCENARIO_DETENTION_BLOCK            = 669,
+    SCENARIO_UPPER_CITY                 = 670,
