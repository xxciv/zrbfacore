+// zrbfacore: the Kargath Expeditionary Force (Horde) and Morgan's Militia (Alliance) quest givers stand on the
+// same spots; only the entering player's side is shown.
+inline bool IsHordeQuestgiver(uint32 entry)
+{
+    switch (entry)
+    {
+        case 45815: case 45817: case 45818: case 45820: case 45821:
+        case 45823: case 45824: case 45839: case 45840:
+            return true;
+        default:
+            return false;
+    }
+}
+
+inline bool IsAllianceQuestgiver(uint32 entry)
+{
+    switch (entry)
+    {
+        case 45888: case 45890: case 45891: case 45892:
+        case 45894: case 45898: case 45899: case 45903:
+            return true;
+        default:
+            return false;
+    }
+}
