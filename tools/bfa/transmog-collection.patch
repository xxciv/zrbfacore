+    // .debug transmog <item id or link> [learn]
+    static bool HandleDebugTransmogCommand(ChatHandler* handler, char const* args)
+    {
+        if (!*args)
+            return false;
+
+        char* idStr = handler->extractKeyFromLink((char*)args, "Hitem");
+        if (!idStr)
+            return false;
+
+        uint32 itemId = uint32(atoul(idStr));
+        char const* option = strtok(nullptr, " ");
+        bool const learn = option && std::string(option) == "learn";
+
+        Player* player = handler->GetSession()->GetPlayer();
+        CollectionMgr* collection = handler->GetSession()->GetCollectionMgr();
+
+        ItemModifiedAppearanceEntry const* appearance = nullptr;
+        if (Item* item = player->GetItemByEntry(itemId, ITEM_SEARCH_EVERYWHERE))
+        {
+            appearance = item->GetItemModifiedAppearance();
+            handler->PSendSysMessage("Item %u is in your bags: soulbound %u, appearance modifier %u.", itemId, uint32(item->IsSoulBound()), item->GetBonus()->AppearanceModID);
+        }
+        else
+        {
+            appearance = sDB2Manager.GetItemModifiedAppearance(itemId, 0);
+            handler->PSendSysMessage("Item %u is not in your bags, checking its default appearance.", itemId);
+        }
+
+        if (appearance)
+        {
+            std::pair<bool, bool> known = collection->HasItemAppearance(appearance->ID);
+            uint32 block = appearance->ID / 32;
+            bool const inUpdateField = block < player->m_activePlayerData->Transmog.size() && (player->m_activePlayerData->Transmog[block] & (1u << (appearance->ID % 32)));
+            handler->PSendSysMessage("ItemModifiedAppearance %u (appearance %u, modifier %u, source type %d). Known by server: %u, temporary: %u, sent to client: %u.",
+                appearance->ID, uint32(appearance->ItemAppearanceID), uint32(appearance->ItemAppearanceModifierID), int32(appearance->TransmogSourceTypeEnum),
+                uint32(known.first), uint32(known.second), uint32(inUpdateField));
+        }
+
+        char const* reason = collection->GetAppearanceRejectReason(appearance);
+        handler->PSendSysMessage("Can collect: %s.", reason ? reason : "yes");
+        handler->PSendSysMessage("Account knows %u appearances; client update field has %u blocks.",
+            uint32(collection->GetKnownAppearanceCount()), uint32(player->m_activePlayerData->Transmog.size()));
+
+        if (learn && appearance)
+        {
+            collection->AddItemAppearance(appearance);
+            handler->PSendSysMessage("Learned ItemModifiedAppearance %u without the checks.", appearance->ID);
+        }
+
+        return true;
+    }
