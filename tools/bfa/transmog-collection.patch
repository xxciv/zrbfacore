 ###################################################################################################
 
+###################################################################################################
+# TRANSMOG COLLECTION
+#
+#    Transmog.CollectOnPickup
+#        Description: Learn an item's appearance as soon as it reaches the bags or bank
+#                     (loot, quest reward, vendor, mail, trade, guild bank), and for items
+#                     already there at the next login. Off follows retail 8.3.7, where an
+#                     appearance is only learned once the item is soulbound, so a
+#                     Bind on Equip item has to be equipped first.
+#        Default:     1 - (Enabled)
+#                     0 - (Disabled, retail 8.3.7)
+
+Transmog.CollectOnPickup = 1
+
+#    Transmog.CollectAnyClass
+#        Description: Learn appearances of every armor type and weapon type, not only the
+#                     ones the current character can wear. Appearances are account wide,
+#                     so an alt of the right class can then use them. Also ignores the
+#                     item's level, class, race and faction requirements.
+#        Default:     1 - (Enabled)
+#                     0 - (Disabled, retail 8.3.7)
+
+Transmog.CollectAnyClass = 1
+
+#    Transmog.CollectIgnoreLevel
+#        Description: With Transmog.CollectAnyClass = 0, still learn appearances of items
+#                     the character is too low level to wear.
+#        Default:     1 - (Enabled)
+#                     0 - (Disabled, retail 8.3.7)
+
+Transmog.CollectIgnoreLevel = 1
+
+#
+###################################################################################################
+
 ###################################################################################################
 # PLAYER INTERACTION
 #
