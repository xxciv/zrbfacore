+// zr: pet tamer battles. The core had the trainer team table (battlepet_npc_team_member) and the
+// trainer battle type, but nothing ever started a battle against a tamer. Called from the
+// "Let's do battle!" gossip option (Player::OnGossipSelect, GOSSIP_OPTION_PET_BATTLE).
+void WorldSession::StartPetBattleWithTrainer(Creature* trainer)
+{
+    if (!sWorld->getBoolConfig(CONFIG_PET_BATTLES) || !trainer || !_player->_petBattleId.IsEmpty())
+        return;
+
+    if (m_isPetBattleJournalLocked)
+    {
+        SendPetBattleRequestFailed(BATTLE_PET_REQUEST_NO_ACCOUNT_LOCK);
+        return;
+    }
+
+    std::vector<BattlePetNpcTeamMember> const* team = sBattlePetDataStore->FindPetBattleTrainerTeam(trainer->GetEntry());
+    if (!team || team->empty())
+        return;
+
+    if (sPetBattleSystem->GetRequest(_player->GetGUID()))
+        sPetBattleSystem->RemoveRequest(_player->GetGUID());
+
+    auto battleRequest = sPetBattleSystem->CreateRequest(_player->GetGUID());
+    battleRequest->RequestType = PET_BATTLE_TYPE_PVE;
+    battleRequest->OpponentGuid = trainer->GetGUID();
+    battleRequest->LocationResult = 0;
+
+    // Player stays where they are, the tamer stays where they are, the pets fight in between.
+    battleRequest->TeamPosition[PET_BATTLE_TEAM_1].Relocate(_player->GetPositionX(), _player->GetPositionY(), _player->GetPositionZ(), _player->GetAngle(trainer));
+    battleRequest->TeamPosition[PET_BATTLE_TEAM_2].Relocate(trainer->GetPositionX(), trainer->GetPositionY(), trainer->GetPositionZ(), trainer->GetAngle(_player));
+
+    float centerX = (_player->GetPositionX() + trainer->GetPositionX()) / 2.0f;
+    float centerY = (_player->GetPositionY() + trainer->GetPositionY()) / 2.0f;
+    float centerZ = std::max(_player->GetPositionZ(), trainer->GetPositionZ());
+    _player->UpdateAllowedPositionZ(centerX, centerY, centerZ);
+    battleRequest->PetBattleCenterPosition.Relocate(centerX, centerY, centerZ, _player->GetAngle(trainer));
+
+    auto canEnterResult = sPetBattleSystem->CanPlayerEnterInPetBattle(_player, battleRequest);
+    if (canEnterResult != BATTLE_PET_REQUEST_OK)
+    {
+        SendPetBattleRequestFailed(canEnterResult);
+        sPetBattleSystem->RemoveRequest(battleRequest->RequesterGuid);
+        return;
+    }
+
+    std::shared_ptr<BattlePetInstance> playerPets[MAX_PET_BATTLE_SLOTS];
+    std::shared_ptr<BattlePetInstance> trainerPets[MAX_PET_BATTLE_SLOTS];
+    size_t playerPetCount = 0;
+    size_t trainerPetCount = 0;
+
+    for (BattlePetNpcTeamMember const& member : *team)
+    {
+        if (trainerPetCount >= MAX_PET_BATTLE_SLOTS)
+            break;
+
+        BattlePetSpeciesEntry const* speciesInfo = sBattlePetSpeciesStore.LookupEntry(member.Specie);
+        if (!speciesInfo)
+            continue;
+
+        auto pet = std::make_shared<BattlePetInstance>();
+        pet->JournalID.Clear();
+        pet->Slot = trainerPetCount;
+        pet->NameTimeStamp = 0;
+        pet->Species = speciesInfo->ID;
+        pet->DisplayModelID = 0;
+        if (CreatureTemplate const* petTemplate = sObjectMgr->GetCreatureTemplate(speciesInfo->CreatureID))
+            if (CreatureModel const* model = petTemplate->GetFirstValidModel())
+                pet->DisplayModelID = model->CreatureDisplayID;
+        pet->XP = 0;
+        pet->Flags = 0;
+        pet->Health = 20000; // clamped to the real max health by PetBattle::AddPet
+
+        uint32 minLevel = std::max<uint32>(member.minlevel, 1);
+        uint32 maxLevel = std::max<uint32>(member.maxlevel, minLevel);
+        pet->Level = std::min<uint32>(urand(minLevel, maxLevel), BATTLE_PET_MAX_LEVEL);
+        pet->Breed = sBattlePetDataStore->GetRandomBreedID(member.BreedIDs);
+        pet->Quality = member.minquality;
+
+        // Abilities from the team table; a missing one falls back to the species' own ability for that slot
+        for (uint8 i = 0; i < MAX_PET_BATTLE_ABILITIES; ++i)
+            pet->Abilities[i] = member.Ability[i];
+
+        uint32 abilityLevels[MAX_PET_BATTLE_ABILITIES] = { };
+        for (auto const& speciesXAbilityInfo : sBattlePetSpeciesXAbilityStore)
+        {
+            if (speciesXAbilityInfo->BattlePetSpeciesID != pet->Species || speciesXAbilityInfo->RequiredLevel > pet->Level)
+                continue;
+
+            uint8 slot = speciesXAbilityInfo->SlotEnum;
+            if (slot >= MAX_PET_BATTLE_ABILITIES || member.Ability[slot])
+                continue;
+
+            if (!pet->Abilities[slot] || abilityLevels[slot] > speciesXAbilityInfo->RequiredLevel)
+            {
+                pet->Abilities[slot] = speciesXAbilityInfo->BattlePetAbilityID;
+                abilityLevels[slot] = speciesXAbilityInfo->RequiredLevel;
+            }
+        }
+
+        trainerPets[trainerPetCount++] = pet;
+    }
+
+    if (!trainerPetCount)
+    {
+        SendPetBattleRequestFailed(BATTLE_PET_REQUEST_TARGET_INVALID);
+        sPetBattleSystem->RemoveRequest(battleRequest->RequesterGuid);
+        return;
+    }
+
+    auto petSlots = _player->GetBattlePetCombatTeam();
+    for (size_t i = 0; i < MAX_PET_BATTLE_SLOTS; ++i)
+    {
+        if (!petSlots[i])
+            continue;
+
+        if (playerPetCount >= MAX_PET_BATTLE_SLOTS || playerPetCount >= _player->GetUnlockedPetBattleSlot())
+            break;
+
+        playerPets[playerPetCount] = std::make_shared<BattlePetInstance>();
+        playerPets[playerPetCount]->CloneFrom(petSlots[i]);
+        playerPets[playerPetCount]->Slot = playerPetCount;
+        playerPets[playerPetCount]->OriginalBattlePet = petSlots[i];
+
+        ++playerPetCount;
+    }
+
+    _player->AddUnitFlag(UNIT_FLAG_IMMUNE_TO_NPC);
+    _player->SetTarget(trainer->GetGUID());
+
+    SendPetBattleFinalizeLocation(battleRequest);
+
+    _player->SetFacingTo(_player->GetAngle(&battleRequest->TeamPosition[PET_BATTLE_TEAM_2]));
+    _player->SetRooted(true);
+
+    trainer->StopMoving();
+    trainer->SetFacingToObject(_player);
+
+    auto battle = sPetBattleSystem->CreateBattle();
+
+    battle->Teams[PET_BATTLE_TEAM_1]->OwnerGuid = _player->GetGUID();
+    battle->Teams[PET_BATTLE_TEAM_1]->PlayerGuid = _player->GetGUID();
+    battle->Teams[PET_BATTLE_TEAM_2]->OwnerGuid = trainer->GetGUID();
+
+    for (size_t i = 0; i < MAX_PET_BATTLE_SLOTS; ++i)
+    {
+        if (playerPets[i])
+            battle->AddPet(PET_BATTLE_TEAM_1, playerPets[i]);
+
+        if (trainerPets[i])
+            battle->AddPet(PET_BATTLE_TEAM_2, trainerPets[i]);
+    }
+
+    battle->BattleType = PET_BATTLE_TYPE_PVE;
+    battle->PveBattleType = PVE_BATTLE_PET_TRAINER;
+
+    _player->_petBattleId = battle->ID;
+    battle->Begin();
+
+    sPetBattleSystem->RemoveRequest(battleRequest->RequesterGuid);
+}
