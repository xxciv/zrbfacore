+// zr: pet tamer battles
+bool Player::HasOpenPetBattleTrainerObjective(uint32 trainerEntry) const
+{
+    for (uint8 i = 0; i < MAX_QUEST_LOG_SIZE; ++i)
+    {
+        uint32 questId = GetQuestSlotQuestId(i);
+        if (!questId)
+            continue;
+
+        Quest const* quest = sObjectMgr->GetQuestTemplate(questId);
+        if (!quest || GetQuestStatus(questId) != QUEST_STATUS_INCOMPLETE)
+            continue;
+
+        for (QuestObjective const& obj : quest->GetObjectives())
+            if (obj.Type == QUEST_OBJECTIVE_WINPETBATTLEAGAINSTNPC && uint32(obj.ObjectID) == trainerEntry && !GetQuestObjectiveData(quest, obj.StorageIndex))
+                return true;
+    }
+
+    return false;
+}
+
+bool Player::CanStartPetBattleWithTrainer(Creature const* trainer)
+{
+    if (!trainer || !sWorld->getBoolConfig(CONFIG_PET_BATTLES) || !HasBattlePetTraining())
+        return false;
+
+    std::vector<BattlePetNpcTeamMember> const* team = sBattlePetDataStore->FindPetBattleTrainerTeam(trainer->GetEntry());
+    if (!team || team->empty())
+        return false;
+
+    return HasOpenPetBattleTrainerObjective(trainer->GetEntry());
+}
+
+void Player::PetBattleTrainerCredit(ObjectGuid trainerGuid)
+{
+    uint32 trainerEntry = trainerGuid.GetEntry();
+    if (!trainerEntry)
+        return;
+
+    for (uint8 i = 0; i < MAX_QUEST_LOG_SIZE; ++i)
+    {
+        uint32 questId = GetQuestSlotQuestId(i);
+        if (!questId)
+            continue;
+
+        Quest const* quest = sObjectMgr->GetQuestTemplate(questId);
+        if (!quest || GetQuestStatus(questId) != QUEST_STATUS_INCOMPLETE)
+            continue;
+
+        for (QuestObjective const& obj : quest->GetObjectives())
+        {
+            if (obj.Type != QUEST_OBJECTIVE_WINPETBATTLEAGAINSTNPC || uint32(obj.ObjectID) != trainerEntry)
+                continue;
+
+            if (!GetQuestObjectiveData(quest, obj.StorageIndex))
+            {
+                SetQuestObjectiveData(obj, 1);
+                SendQuestUpdateAddCredit(quest, trainerGuid, obj, 1);
+            }
+        }
+
+        if (CanCompleteQuest(questId))
+            CompleteQuest(questId);
+    }
+}
