+
+// Player side of the update fields (m_values is only reachable from Player)
+void Player::SetArchaeologyDigsiteFields(std::vector<std::pair<uint16, uint32>> const& sites)
+{
+    ClearDynamicUpdateFieldValues(m_values.ModifyValue(&Player::m_activePlayerData).ModifyValue(&UF::ActivePlayerData::ResearchSites));
+    ClearDynamicUpdateFieldValues(m_values.ModifyValue(&Player::m_activePlayerData).ModifyValue(&UF::ActivePlayerData::ResearchSiteProgress));
+
+    for (auto const& site : sites)
+    {
+        AddDynamicUpdateFieldValue(m_values.ModifyValue(&Player::m_activePlayerData).ModifyValue(&UF::ActivePlayerData::ResearchSites)) = site.first;
+        AddDynamicUpdateFieldValue(m_values.ModifyValue(&Player::m_activePlayerData).ModifyValue(&UF::ActivePlayerData::ResearchSiteProgress)) = site.second;
+    }
+}
+
+void Player::SetArchaeologyProjectFields(std::vector<uint16> const& projects)
+{
+    ClearDynamicUpdateFieldValues(m_values.ModifyValue(&Player::m_activePlayerData).ModifyDynamicArrayValue(&UF::ActivePlayerData::Research, 0));
+
+    for (uint16 projectId : projects)
+        AddDynamicUpdateFieldValue(m_values.ModifyValue(&Player::m_activePlayerData).ModifyDynamicArrayValue(&UF::ActivePlayerData::Research, 0)).ResearchProjectID = int16(projectId);
+}
