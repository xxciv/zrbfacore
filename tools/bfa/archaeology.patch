     // .debug scenario: lists every step and criteria of the instance scenario you are in, with its progress
+    // zrbfacore: .debug archaeology            dig sites on this continent, research projects
+    //            .debug archaeology all        every dig site of the character
+    //            .debug archaeology reset      drop all dig sites and roll new ones
+    //            .debug archaeology go <n>     teleport into dig site <n> of the list
+    static bool HandleDebugArchaeologyCommand(ChatHandler* handler, char const* args)
+    {
+        Player* player = handler->GetSession()->GetPlayer();
+        ArchaeologyPlayerMgr& archaeology = player->GetArchaeologyMgr();
+        LocaleConstant locale = handler->GetSessionDbcLocale();
+
+        std::string option = args ? args : "";
+        std::string argument;
+        std::size_t space = option.find(' ');
+        if (space != std::string::npos)
+        {
+            argument = option.substr(space + 1);
+            option = option.substr(0, space);
+        }
+
+        if (!player->HasSkill(SKILL_ARCHAEOLOGY))
+            handler->PSendSysMessage("You don't have the Archaeology skill: no dig sites.");
+
+        if (option == "reset")
+        {
+            archaeology.ResetDigsites();
+            handler->PSendSysMessage("Dig sites rolled again: %u active.", uint32(archaeology.GetDigsites().size()));
+            return true;
+        }
+
+        DigsiteList const& digsites = archaeology.GetDigsites();
+
+        if (option == "go")
+        {
+            uint32 index = uint32(atoul(argument.c_str()));
+            if (index >= digsites.size())
+            {
+                handler->PSendSysMessage("No dig site %u (the list has %u).", index, uint32(digsites.size()));
+                return true;
+            }
+
+            ArchaeologyMgr::ResearchDigsitesEntry const* site = sArchaeologyMgr->GetDigsite(digsites[index].digsiteId);
+            float x = 0.0f, y = 0.0f;
+            if (!site || !sArchaeologyMgr->GetRandomPointInDigsite(site->id, 0.0f, 0.0f, 0.0f, x, y))
+                return false;
+
+            Map* map = sMapMgr->CreateBaseMap(site->mapId);
+            float z = std::max(map->GetStaticHeight(PhasingHandler::GetEmptyPhaseShift(), x, y, MAX_HEIGHT), map->GetWaterLevel(PhasingHandler::GetEmptyPhaseShift(), x, y));
+            if (player->IsInFlight())
+            {
+                player->GetMotionMaster()->MovementExpired();
+                player->CleanupAfterTaxiFlight();
+            }
+            else
+                player->SaveRecallPosition();
+            player->TeleportTo(site->mapId, x, y, z + 1.0f, player->GetOrientation());
+            return true;
+        }
+
+        bool all = option == "all";
+        int current = archaeology.GetDigsite(player->GetPositionX(), player->GetPositionY());
+
+        handler->PSendSysMessage("Archaeology skill %u/%u, %u dig sites in all, standing in: %s",
+            player->GetSkillValue(SKILL_ARCHAEOLOGY), player->GetMaxSkillValue(SKILL_ARCHAEOLOGY), uint32(digsites.size()),
+            current >= 0 ? std::to_string(current).c_str() : "none");
+
+        for (uint32 i = 0; i < digsites.size(); ++i)
+        {
+            ArchaeologyMgr::ResearchDigsitesEntry const* site = sArchaeologyMgr->GetDigsite(digsites[i].digsiteId);
+            if (!site || (!all && site->mapId != player->GetMapId()))
+                continue;
+
+            ResearchSiteEntry const* siteEntry = sResearchSiteStore.LookupEntry(site->id);
+            ResearchBranchEntry const* branch = sArchaeologyMgr->GetBranchByCurrency(site->currencyId);
+            std::string findText = "not rolled";
+            if (digsites[i].x != 0.0f || digsites[i].y != 0.0f)
+            {
+                std::ostringstream find;
+                find << "find at " << int32(digsites[i].x) << " " << int32(digsites[i].y);
+                if (site->mapId == player->GetMapId())
+                    find << " (" << int32(player->GetExactDist2d(digsites[i].x, digsites[i].y)) << " yd)";
+                findText = find.str();
+            }
+
+            handler->PSendSysMessage("[%u] site %u \"%s\" map %u, %s, finds %u/%u, %s", i, site->id,
+                siteEntry ? siteEntry->Name->Str[locale] : "?", site->mapId,
+                branch ? branch->Name->Str[locale] : "?", digsites[i].digCount,
+                uint32(ArchaeologyMgr::GetFindsPerDigsite(site->mapId)), findText.c_str());
+        }
+
+        for (uint16 projectId : archaeology.GetProjects())
+        {
+            ResearchProjectEntry const* project = sResearchProjectStore.LookupEntry(projectId);
+            if (!project)
+                continue;
+
+            ResearchBranchEntry const* branch = sResearchBranchStore.LookupEntry(project->ResearchBranchId);
+            handler->PSendSysMessage("Project %u \"%s\" (%s, %s), spell %d, needs %u fragments, has %u",
+                project->Id, project->Name->Str[locale], branch ? branch->Name->Str[locale] : "?",
+                project->Rarity ? "rare" : "common", project->SpellId, project->RequiredWeight,
+                branch ? player->GetCurrency(branch->CurrencyId) : 0);
+        }
+
+        return true;
+    }
