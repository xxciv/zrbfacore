+namespace
+{
+    // zrbfacore: expansion XP gates. At each old level cap, experience stops until the character turns
+    // in a quest in the next expansion's zones (or one of the quests that sends them there). Quests in
+    // a later expansion also open the earlier gates. Hidden tracking quests never count.
+    struct ExpansionXpGate
+    {
+        uint8 Level;
+        char const* Destination;
+        std::vector<int32> Zones;   // quest_template.QuestSortID (zone ids)
+        std::vector<uint32> Quests; // entry quests that are not sorted under one of the zones
+    };
+
+    std::vector<ExpansionXpGate> const ExpansionXpGates =
+    {
+        {  60, "Outland",                 { 3483, 3521, 3519, 3518, 3522, 3520, 3523, 3703 }, { 9407, 10119 } },
+        {  70, "Northrend",               { 3537, 495, 65, 394, 66, 3711, 67, 210, 4395 }, { } },
+        {  80, "the Cataclysm zones",     { 616, 5146, 4815, 5144, 5145, 5042, 5034, 4922, 5095, 5389 }, { 14482, 25924 } },
+        {  85, "Pandaria",                { 5785, 5805, 6134, 5841, 5842, 6138, 5840, 6507, 6757 }, { 29548, 29690 } },
+        {  90, "Draenor",                 { 6720, 6719, 6721, 6662, 6722, 6755, 6723, 7025, 6941 }, { 34398, 36881 } },
+        { 100, "the Broken Isles",        { 7334, 7558, 7503, 7541, 7637, 7502, 7543 }, { 40519, 43926 } },
+        { 110, "Kul Tiras or Zandalar",   { 8567, 8721, 9042, 8499, 8500, 8501, 9653 }, { 46727, 51443 } },
+    };
+
+    bool QuestOpensXpGate(Quest const* quest, ExpansionXpGate const& gate)
+    {
+        if (quest->HasFlag(QUEST_FLAGS_TRACKING))
+            return false;
+
+        if (std::find(gate.Quests.begin(), gate.Quests.end(), quest->GetQuestId()) != gate.Quests.end())
+            return true;
+
+        return std::find(gate.Zones.begin(), gate.Zones.end(), quest->GetZoneOrSort()) != gate.Zones.end();
+    }
+
+    // highest gate index this quest opens, -1 for none
+    int32 XpGateOpenedBy(Quest const* quest)
+    {
+        for (int32 i = int32(ExpansionXpGates.size()) - 1; i >= 0; --i)
+            if (QuestOpensXpGate(quest, ExpansionXpGates[i]))
+                return i;
+        return -1;
+    }
+}
+
+uint8 Player::GetLockedXpGateLevel(uint8 level) const
+{
+    if (!sConfigMgr->GetBoolDefault("ExpansionXpGate.Enable", true))
+        return 0;
+
+    // highest gate at or below this level
+    int32 gateIndex = -1;
+    for (int32 i = 0; i < int32(ExpansionXpGates.size()); ++i)
+        if (level >= ExpansionXpGates[i].Level)
+            gateIndex = i;
+
+    if (gateIndex < 0)
+        return 0;
+
+    if (m_xpGateCacheSize != m_RewardedQuests.size())
+    {
+        m_xpGateOpenIndex = -1;
+        for (uint32 questId : m_RewardedQuests)
+            if (Quest const* quest = sObjectMgr->GetQuestTemplate(questId))
+                m_xpGateOpenIndex = std::max(m_xpGateOpenIndex, XpGateOpenedBy(quest));
+        m_xpGateCacheSize = m_RewardedQuests.size();
+    }
+
+    int32 openIndex = m_xpGateOpenIndex;
+    if (m_xpGateRewardingQuest)
+        openIndex = std::max(openIndex, XpGateOpenedBy(m_xpGateRewardingQuest));
+
+    return openIndex >= gateIndex ? 0 : ExpansionXpGates[gateIndex].Level;
+}
+
+void Player::SendXpGateMessage(uint8 gateLevel, bool unlocked)
+{
+    for (ExpansionXpGate const& gate : ExpansionXpGates)
+    {
+        if (gate.Level != gateLevel)
+            continue;
+
+        if (unlocked)
+            ChatHandler(GetSession()).PSendSysMessage("|cff00ff00Experience unlocked:|r welcome to %s. You earn experience again everywhere.", gate.Destination);
+        else
+            ChatHandler(GetSession()).PSendSysMessage("|cffffd000Experience locked at level %u.|r Complete a quest in %s to keep earning experience. Quests elsewhere still give money, items and reputation.", uint32(gate.Level), gate.Destination);
+        return;
+    }
+}
