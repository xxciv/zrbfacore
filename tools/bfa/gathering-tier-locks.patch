--- a/src/server/game/Spells/Auras/SpellAuraEffects.cpp
+++ b/src/server/game/Spells/Auras/SpellAuraEffects.cpp
@@ -2446,13 +2446,27 @@ void AuraEffect::HandleAuraTrackResources(AuraApplication const* aurApp, uint8 m
     if (!target)
         return;
 
-    uint32 bitIndex = GetMiscValue() - 1;
-    uint32 index = bitIndex / 32;
-    uint32 flag = 1 << (bitIndex % 32);
-    if (apply)
-        target->AddTrackResourceFlag(index, flag);
-    else
-        target->RemoveTrackResourceFlag(index, flag);
+    auto setTrackedLockType = [target, apply](uint32 lockType)
+    {
+        uint32 bitIndex = lockType - 1;
+        uint32 index = bitIndex / 32;
+        uint32 flag = 1 << (bitIndex % 32);
+        if (apply)
+            target->AddTrackResourceFlag(index, flag);
+        else
+            target->RemoveTrackResourceFlag(index, flag);
+    };
+
+    setTrackedLockType(GetMiscValue());
+
+    // The client tracks an expansion herb or ore node by its expansion lock type (Classic to Kul Tiran
+    // Herbalism 32-39, Mining 40-47), so Find Herbs and Find Minerals mark those as well.
+    if (GetMiscValue() == LOCKTYPE_HERBALISM)
+        for (uint32 lockType = LOCKTYPE_CLASSIC_HERBALISM; lockType <= LOCKTYPE_KUL_TIRAN_HERBALISM; ++lockType)
+            setTrackedLockType(lockType);
+    else if (GetMiscValue() == LOCKTYPE_MINING)
+        for (uint32 lockType = LOCKTYPE_CLASSIC_MINING; lockType <= LOCKTYPE_KUL_TIRAN_MINING; ++lockType)
+            setTrackedLockType(lockType);
 }
 
