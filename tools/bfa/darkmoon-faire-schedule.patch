+// zrbfacore: monthly game events. A game_event row with occurence 0 runs every month from the first
+// Sunday at the time of day of its start_time, for `length` minutes (the retail Darkmoon Faire
+// schedule). A fixed occurence cannot do this: months differ in length, so the start day drifts.
+namespace
+{
+    std::map<uint16, uint32> MonthlyEventTimeOfDay;     // event id -> minutes after local midnight
+    std::map<uint16, time_t> MonthlyEventSkippedUntil;  // event id -> end of a window stopped by a GM
+
+    bool IsMonthlyEvent(GameEventData const& data)
+    {
+        return data.occurence == 0 && data.state == GAMEEVENT_NORMAL;
+    }
+
+    // Local start of the first Sunday of the given month (month may be out of 0-11, mktime normalises it).
+    time_t FirstSundayOfMonth(int year, int month, uint32 timeOfDay)
+    {
+        tm t = tm();
+        t.tm_year = year;
+        t.tm_mon = month;
+        t.tm_mday = 1;
+        t.tm_hour = 12;
+        t.tm_isdst = -1;
+        time_t firstDay = mktime(&t);
+        tm resolved = tm();
+        localtime_r(&firstDay, &resolved);
+
+        tm sunday = tm();
+        sunday.tm_year = resolved.tm_year;
+        sunday.tm_mon = resolved.tm_mon;
+        sunday.tm_mday = 1 + (7 - resolved.tm_wday) % 7;
+        sunday.tm_hour = int(timeOfDay / 60);
+        sunday.tm_min = int(timeOfDay % 60);
+        sunday.tm_isdst = -1;
+        return mktime(&sunday);
+    }
+
+    // Finds the window that contains `now` (returns true, its end in windowEnd) or the next window start.
+    bool GetMonthlyWindow(uint16 entry, GameEventData const& data, time_t now, time_t& windowEnd, time_t& nextStart)
+    {
+        uint32 timeOfDay = 0;
+        auto itr = MonthlyEventTimeOfDay.find(entry);
+        if (itr != MonthlyEventTimeOfDay.end())
+            timeOfDay = itr->second;
+
+        time_t skippedUntil = 0;
+        auto skip = MonthlyEventSkippedUntil.find(entry);
+        if (skip != MonthlyEventSkippedUntil.end())
+            skippedUntil = skip->second;
+
+        time_t length = time_t(data.length) * MINUTE;
+        tm local = tm();
+        localtime_r(&now, &local);
+
+        nextStart = 0;
+        for (int offset = -1; offset <= 2; ++offset)
+        {
+            time_t start = FirstSundayOfMonth(local.tm_year, local.tm_mon + offset, timeOfDay);
+            if (start <= now && now < start + length && start + length > skippedUntil)
+            {
+                windowEnd = start + length;
+                return true;
+            }
+            if (start > now && !nextStart)
+                nextStart = start;
+        }
+
+        // A GM `.event start` sets start to now: run that window too.
+        if (data.start <= now && now < data.start + length)
+        {
+            windowEnd = data.start + length;
+            return true;
+        }
+        return false;
+    }
+}
