         void OnPlayerEnter(Player* player) override
         {
             if (!TeamInInstance)
+            {
                 TeamInInstance = player->GetTeam();
+                UpdateTroops();
+            }
+        }
+
+        void Update(uint32 diff) override
+        {
+            if (_godfreyIntro || !TeamInInstance || GetBossState(DATA_LORD_WALDEN_EVENT) != DONE)
+                return;
+
+            if (_introCheckTimer > diff)
+            {
+                _introCheckTimer -= diff;
+                return;
+            }
+            _introCheckTimer = 1000;
+
+            Map::PlayerList const& players = instance->GetPlayers();
+            for (Map::PlayerList::const_iterator itr = players.begin(); itr != players.end(); ++itr)
+            {
+                Player* player = itr->GetSource();
+                if (player && player->IsAlive() && player->GetPositionZ() > GodfreyIntroMinZ && player->GetExactDist2d(&GodfreyIntroPos) < GodfreyIntroRange)
+                {
+                    _godfreyIntro = true;
+                    UpdateTroops();
+                    break;
+                }
+            }
+        }
+
+        bool IsSpawnGroupActive(uint32 groupId) const
+        {
+            if (!TeamInInstance)
+                return false;
+
+            bool const alliance = TeamInInstance == ALLIANCE;
+            bool const ashbury = GetBossState(DATA_BARON_ASHBURY_EVENT) == DONE;
+            bool const silverlaine = GetBossState(DATA_BARON_SILVERLAINE_EVENT) == DONE;
+            bool const springvale = GetBossState(DATA_COMMANDER_SPRINGVALE_EVENT) == DONE;
+            bool const walden = GetBossState(DATA_LORD_WALDEN_EVENT) == DONE;
+
+            switch (groupId)
+            {
+                case SPAWN_GROUP_ENTRANCE_ALLIANCE:                    return alliance && !ashbury;
+                case SPAWN_GROUP_ENTRANCE_HORDE:                       return !alliance && !ashbury;
+                case SPAWN_GROUP_DISEASE_CLOUDS_ENTRANCE:              return !alliance;
+                case SPAWN_GROUP_DISEASE_CLOUDS_BARON_ASHBURY:         return !alliance && ashbury;
+                case SPAWN_GROUP_DISEASE_CLOUDS_BARON_SILVERLAINE:     return !alliance && silverlaine;
+                case SPAWN_GROUP_DISEASE_CLOUDS_COMMANDER_SPRINGVALE:  return !alliance && springvale;
+                case SPAWN_GROUP_DISEASE_CLOUDS_LORD_WALDEN:           return !alliance && walden;
+                case SPAWN_GROUP_LORD_GODFREY_DEAD_TROUPS_ALLIANCE:    return alliance && walden;
+                case SPAWN_GROUP_LORD_GODFREY_DEAD_TROUPS_HORDE:       return !alliance && walden;
+                case SPAWN_GROUP_BARON_ASHBURY_TROUPS_ALLIANCE:        return alliance && ashbury && !silverlaine && !springvale && !walden;
+                case SPAWN_GROUP_BARON_ASHBURY_TROUPS_HORDE:           return !alliance && ashbury && !silverlaine && !springvale && !walden;
+                case SPAWN_GROUP_BARON_SILVERLAINE_TROUPS_ALLIANCE:    return alliance && silverlaine && !springvale && !walden;
+                case SPAWN_GROUP_BARON_SILVERLAINE_TROUPS_HORDE:       return !alliance && silverlaine && !springvale && !walden;
+                case SPAWN_GROUP_COMMANDER_SPRINGVALE_TROUPS_ALLIANCE: return alliance && springvale && !walden;
+                case SPAWN_GROUP_COMMANDER_SPRINGVALE_BELMONT:         return !alliance && springvale && !walden;
+                case SPAWN_GROUP_LORD_WALDEN_TROUPS_ALLIANCE:          return alliance && walden && !_godfreyIntro;
+                case SPAWN_GROUP_COMMANDER_SPRINGVALE_TROUPS_HORDE:    return !alliance && (springvale || walden) && !_godfreyIntro;
+                case SPAWN_GROUP_LORD_WALDEN_BELMONT:                  return !alliance && walden && !_godfreyIntro;
+                case SPAWN_GROUP_LORD_GODFREY_IVAR_BLOODFANG:          return alliance && _godfreyIntro;
+                case SPAWN_GROUP_LORD_GODFREY_BELMONT:                 return !alliance && _godfreyIntro;
+                default:                                               return false;
+            }
+        }
+
+        void UpdateTroopVisibility(Creature* creature, bool updateVisibility)
+        {
+            CreatureData const* data = creature->GetCreatureData();
+            if (!data || !data->spawnGroupData)
+                return;
+
+            uint32 groupId = data->spawnGroupData->groupId;
+            if (groupId < SPAWN_GROUP_SFK_FIRST || groupId > SPAWN_GROUP_SFK_LAST)
+                return;
+
+            bool const hidden = creature->GetPhaseShift().HasPhase(PHASE_SFK_HIDDEN_TROOPS);
+            bool const active = IsSpawnGroupActive(groupId);
+            if (active == !hidden)
+                return;
+
+            if (active)
+                PhasingHandler::InitDbPhaseShift(creature->GetPhaseShift(), data->phaseUseFlags, data->phaseId, data->phaseGroup);
+            else
+                PhasingHandler::InitDbPhaseShift(creature->GetPhaseShift(), PHASE_USE_FLAGS_NONE, PHASE_SFK_HIDDEN_TROOPS, 0);
+
+            if (updateVisibility && creature->IsInWorld())
+                creature->UpdateObjectVisibility();
+        }
+
+        void UpdateTroops()
+        {
+            for (auto const& pair : instance->GetCreatureBySpawnIdStore())
+                UpdateTroopVisibility(pair.second, true);
         }
 
