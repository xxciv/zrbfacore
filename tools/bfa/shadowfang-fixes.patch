+
+// The Alliance (Ivar Bloodfang's worgen) and Horde (Belmont's Forsaken) allies are both
+// spawned from the database, one copy for every stage of the run. The SQL fix puts each
+// copy in a spawn group (ids follow the Cataclysm Preservation Project); this script only
+// shows the groups that match the team in the instance and the bosses already killed,
+// and keeps every other copy in a phase no player is in.
+enum ShadowfangSpawnGroups
+{
+    SPAWN_GROUP_ENTRANCE_ALLIANCE                       = 412, // until Baron Ashbury is defeated
+    SPAWN_GROUP_ENTRANCE_HORDE                          = 413,
+    SPAWN_GROUP_DISEASE_CLOUDS_ENTRANCE                 = 414, // Horde only
+    SPAWN_GROUP_DISEASE_CLOUDS_BARON_ASHBURY            = 415,
+    SPAWN_GROUP_DISEASE_CLOUDS_BARON_SILVERLAINE        = 416,
+    SPAWN_GROUP_DISEASE_CLOUDS_COMMANDER_SPRINGVALE     = 417,
+    SPAWN_GROUP_DISEASE_CLOUDS_LORD_WALDEN              = 418,
+    SPAWN_GROUP_LORD_GODFREY_DEAD_TROUPS_ALLIANCE       = 419, // after Lord Walden
+    SPAWN_GROUP_LORD_GODFREY_DEAD_TROUPS_HORDE          = 420,
+    SPAWN_GROUP_BARON_ASHBURY_TROUPS_ALLIANCE           = 421, // after Baron Ashbury, until the next boss
+    SPAWN_GROUP_BARON_ASHBURY_TROUPS_HORDE              = 422,
+    SPAWN_GROUP_BARON_SILVERLAINE_TROUPS_ALLIANCE       = 423, // after Baron Silverlaine, until the next boss
+    SPAWN_GROUP_BARON_SILVERLAINE_TROUPS_HORDE          = 424,
+    SPAWN_GROUP_COMMANDER_SPRINGVALE_TROUPS_ALLIANCE    = 425, // after Commander Springvale, until Lord Walden
+    SPAWN_GROUP_LORD_WALDEN_TROUPS_ALLIANCE             = 427, // after Lord Walden, until the Godfrey intro
+    SPAWN_GROUP_COMMANDER_SPRINGVALE_TROUPS_HORDE       = 428, // after Springvale or Walden, until the Godfrey intro
+    SPAWN_GROUP_COMMANDER_SPRINGVALE_BELMONT            = 429, // after Commander Springvale, until Lord Walden
+    SPAWN_GROUP_LORD_WALDEN_BELMONT                     = 430, // after Lord Walden, until the Godfrey intro
+    SPAWN_GROUP_LORD_GODFREY_IVAR_BLOODFANG             = 431, // Godfrey intro
+    SPAWN_GROUP_LORD_GODFREY_BELMONT                    = 432,
+
+    SPAWN_GROUP_SFK_FIRST                               = SPAWN_GROUP_ENTRANCE_ALLIANCE,
+    SPAWN_GROUP_SFK_LAST                                = SPAWN_GROUP_LORD_GODFREY_BELMONT
+};
+
+// Not a Phase.db2 phase: no player is ever in it, so creatures given it are not seen and do not interact.
+// Set as the creature's database phase: PhasingHandler::AddPhase doesn't clear the "unphased" flag
+// of a creature spawned from the database, so it would stay visible to everyone.
+uint16 const PHASE_SFK_HIDDEN_TROOPS = 65535;
+
+// The Godfrey intro starts when a player reaches the landing outside Godfrey's room after Lord Walden.
+Position const GodfreyIntroPos = { -165.0f, 2181.0f, 152.0f };
+float const GodfreyIntroRange = 30.0f;
+float const GodfreyIntroMinZ = 145.0f;
 
