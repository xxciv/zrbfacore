     packet.SkillLineIDReward = quest->GetRewardSkillId();
     packet.NumSkillUpsReward = quest->GetRewardSkillPoints();
 
+    // zrbfacore: ported from TrinityCore master (e746cb2f, 0c7967d4). Every gossip NPC used to get
+    // LaunchGossip and every quest giver LaunchQuest, so the client left the quest window open
+    // (no Complete button) waiting for a gossip or quest menu the server never sent.
     if (questGiver)
     {
         if (questGiver->IsGossip())
-            packet.LaunchGossip = true;
-        else if (questGiver->IsQuestGiver())
-            packet.LaunchQuest = true;
