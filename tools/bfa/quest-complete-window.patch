+            packet.LaunchGossip = quest->HasFlag(QUEST_FLAGS_LAUNCH_GOSSIP_COMPLETE);
+
+        if (!quest->HasFlag(QUEST_FLAGS_AUTOCOMPLETE))
+            if (Quest const* rewardQuest = GetNextQuest(questGiver->GetGUID(), quest))
+                packet.UseQuestReward = const_cast<Player*>(this)->CanTakeQuest(rewardQuest, false);
+
+        if (questGiver->IsQuestGiver())
+            packet.LaunchQuest = !packet.UseQuestReward &&
+                (const_cast<Player*>(this)->GetQuestDialogStatus(const_cast<Creature*>(questGiver)) & ~(DIALOG_STATUS_UNAVAILABLE | DIALOG_STATUS_SCRIPTED_NO_STATUS)) != DIALOG_STATUS_NONE;
     }
 
     packet.HideChatMessage = hideChatMessage;
