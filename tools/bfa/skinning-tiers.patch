+#ifndef SkinningTiers_h__
+#define SkinningTiers_h__
+
+#include "CreatureData.h"
+#include "SharedDefines.h"
+#include <algorithm>
+#include <iterator>
+
+// Since 8.0 skinning is split per expansion: a beast is skinned with its own expansion's skill (Cataclysm
+// beasts with Cataclysm Skinning, 1-75), and skinning it raises that skill.
+struct SkinningTier
+{
+    uint32 SkillId;
+    int32 MinLevel;     // level of the expansion's first beasts, which need skill 1
+    int32 MaxLevel;     // level of its last beasts, which need the skill's max minus 25
+};
+
+SkinningTier const SkinningTiers[] =
+{
+    { SKILL_SKINNING_2,           1,  60 },
+    { SKILL_OUTLAND_SKINNING,    58,  70 },
+    { SKILL_NORTHREND_SKINNING,  68,  80 },
+    { SKILL_CATACLYSM_SKINNING,  80,  85 },
+    { SKILL_PANDARIA_SKINNING,   85,  90 },
+    { SKILL_DRAENOR_SKINNING,    90, 100 },
+    { SKILL_LEGION_SKINNING,     98, 110 },
+    { SKILL_KUL_TIRAN_SKINNING, 110, 120 },
+};
+
+// The creature's expansion comes from its template (HealthScalingExpansion). Many templates leave it at 0
+// (Classic) whatever their level, so a level above 60 picks the expansion by level instead.
+inline SkinningTier const& GetSkinningTier(CreatureTemplate const* cInfo)
+{
+    int32 expansion = cInfo->HealthScalingExpansion;
+    if (expansion <= 0 || expansion >= int32(std::size(SkinningTiers)))
+    {
+        int32 level = cInfo->minlevel;
+        expansion = 0;
+        while (expansion + 1 < int32(std::size(SkinningTiers)) && level > SkinningTiers[expansion].MaxLevel)
+            ++expansion;
+    }
+
+    return SkinningTiers[expansion];
+}
+
+inline bool IsClassicSkinningTier(SkinningTier const& tier)
+{
+    return tier.SkillId == SKILL_SKINNING_2;
+}
+
+// Skill an expansion beast needs: 1 at the expansion's first level, rising evenly to the skill's max minus 25 at
+// its last. Classic beasts keep the callers' own level formulas.
+inline int32 GetSkinningTierRequirement(SkinningTier const& tier, int32 level, int32 maxSkill)
+{
+    if (maxSkill <= 0)
+        maxSkill = 75;
+
+    int32 top = std::max(1, maxSkill - 25);
+    int32 req = 1 + (level - tier.MinLevel) * (top - 1) / std::max(1, tier.MaxLevel - tier.MinLevel);
+    return std::clamp(req, 1, top);
+}
+
+#endif // SkinningTiers_h__
