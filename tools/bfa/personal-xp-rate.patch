+    // zrbfacore: personal XP rate (.zrxp rate 0..1), kept in characters.character_xp_rate
+    std::mutex _xpRateLock;
+    std::unordered_map<ObjectGuid::LowType, float> _xpRates;
+
+    float GetXpRate(Player* player)
+    {
+        std::lock_guard<std::mutex> lock(_xpRateLock);
+        auto itr = _xpRates.find(player->GetGUID().GetCounter());
+        return itr != _xpRates.end() ? itr->second : 1.0f;
+    }
+
+    void SetXpRate(ObjectGuid::LowType guid, float rate)
+    {
+        std::lock_guard<std::mutex> lock(_xpRateLock);
+        if (rate >= 1.0f)
+            _xpRates.erase(guid);
+        else
+            _xpRates[guid] = rate;
+    }
