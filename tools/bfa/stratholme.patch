+InstanceScenario* ScenarioMgr::CreateInstanceScenarioForMap(Map* map, uint32 scenarioID) const
+{
+    auto itr = _scenarioData.find(scenarioID);
+    if (itr == _scenarioData.end())
+    {
+        TC_LOG_ERROR("scenario", "ScenarioMgr::CreateInstanceScenarioForMap: no scenario data for scenario %u (map %u).", scenarioID, map->GetId());
+        return nullptr;
+    }
+
+    return new InstanceScenario(map, &itr->second);
+}
