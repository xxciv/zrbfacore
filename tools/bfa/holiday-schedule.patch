+// zrbfacore: scheduled game events, for holidays a fixed `occurence` cannot follow.
+//   occurence 0: every month from the first Sunday, at the time of day of start_time (the retail
+//                Darkmoon Faire). Months differ in length, so a fixed period drifts.
+//   occurence 1: from each date of the event's holiday in Holidays.db2 (with hotfixes), the same
+//                dates the client calendar shows; for holidays that move every year (Easter,
+//                Thanksgiving, the lunar new year). A date with "any year" repeats every year.
+// Both run for `length` minutes from each start and stop at end_time.
+namespace
+{
+    enum : uint32
+    {
+        SCHEDULE_MONTHLY_FIRST_SUNDAY = 0,
+        SCHEDULE_HOLIDAY_DATES        = 1,
+    };
+
+    std::map<uint16, uint32> MonthlyEventTimeOfDay;       // event id -> minutes after local midnight
+    std::map<uint16, time_t> ScheduledEventSkippedUntil;  // event id -> end of a window stopped by a GM
+
+    bool IsScheduledEvent(GameEventData const& data)
+    {
+        return data.state == GAMEEVENT_NORMAL
+            && (data.occurence == SCHEDULE_MONTHLY_FIRST_SUNDAY || data.occurence == SCHEDULE_HOLIDAY_DATES);
+    }
+
+    // Local start of the first Sunday of the given month (month may be out of 0-11, mktime normalises it).
+    time_t FirstSundayOfMonth(int year, int month, uint32 timeOfDay)
+    {
+        tm t = tm();
+        t.tm_year = year;
+        t.tm_mon = month;
+        t.tm_mday = 1;
+        t.tm_hour = 12;
+        t.tm_isdst = -1;
+        time_t firstDay = mktime(&t);
+        tm resolved = tm();
+        localtime_r(&firstDay, &resolved);
+
+        tm sunday = tm();
+        sunday.tm_year = resolved.tm_year;
+        sunday.tm_mon = resolved.tm_mon;
+        sunday.tm_mday = 1 + (7 - resolved.tm_wday) % 7;
+        sunday.tm_hour = int(timeOfDay / 60);
+        sunday.tm_min = int(timeOfDay % 60);
+        sunday.tm_isdst = -1;
+        return mktime(&sunday);
+    }
+
+    // Holidays.db2 date: minute 6 bits, hour 5, weekday 3, day-1 6, month-1 4, year-2000 5 (31 = any year).
+    time_t HolidayDateToTime(uint32 date, int anyYear)
+    {
+        uint32 year = (date >> 24) & 0x1F;
+        tm t = tm();
+        t.tm_year = year == 0x1F ? anyYear : int(year) + 100;
+        t.tm_mon = int((date >> 20) & 0xF);
+        t.tm_mday = int((date >> 14) & 0x3F) + 1;
+        t.tm_hour = int((date >> 6) & 0x1F);
+        t.tm_min = int(date & 0x3F);
+        t.tm_isdst = -1;
+        return mktime(&t);
+    }
+
+    std::vector<time_t> GetScheduledStarts(uint16 entry, GameEventData const& data, time_t now)
+    {
+        std::vector<time_t> starts;
+        tm local = tm();
+        localtime_r(&now, &local);
+
+        if (data.occurence == SCHEDULE_MONTHLY_FIRST_SUNDAY)
+        {
+            uint32 timeOfDay = 0;
+            auto itr = MonthlyEventTimeOfDay.find(entry);
+            if (itr != MonthlyEventTimeOfDay.end())
+                timeOfDay = itr->second;
+            for (int offset = -1; offset <= 2; ++offset)
+                starts.push_back(FirstSundayOfMonth(local.tm_year, local.tm_mon + offset, timeOfDay));
+        }
+        else if (HolidaysEntry const* holiday = sHolidaysStore.LookupEntry(data.holiday_id))
+        {
+            for (uint32 date : holiday->Date)
+            {
+                if (!date)
+                    continue;
+                if (((date >> 24) & 0x1F) == 0x1F)
+                {
+                    for (int offset = -1; offset <= 1; ++offset)
+                        starts.push_back(HolidayDateToTime(date, local.tm_year + offset));
+                }
+                else
+                    starts.push_back(HolidayDateToTime(date, 0));
+            }
+        }
+        std::sort(starts.begin(), starts.end());
+        return starts;
+    }
+
+    // Finds the window that contains `now` (returns true, its end in windowEnd) or the next window start.
+    bool GetScheduledWindow(uint16 entry, GameEventData const& data, time_t now, time_t& windowEnd, time_t& nextStart)
+    {
+        time_t skippedUntil = 0;
+        auto skip = ScheduledEventSkippedUntil.find(entry);
+        if (skip != ScheduledEventSkippedUntil.end())
+            skippedUntil = skip->second;
+
+        time_t length = time_t(data.length) * MINUTE;
+        nextStart = 0;
+        for (time_t start : GetScheduledStarts(entry, data, now))
+        {
+            if (start <= now && now < start + length && start + length > skippedUntil)
+            {
+                windowEnd = start + length;
+                return true;
+            }
+            if (start > now && !nextStart)
+                nextStart = start;
+        }
+
+        // A GM `.event start` sets start to now: run that window too.
+        if (data.start <= now && now < data.start + length)
+        {
+            windowEnd = data.start + length;
+            return true;
+        }
+        return false;
+    }
+}
