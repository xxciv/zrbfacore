+// one faction's pool: first = the seven first regulars (warrior .. rogue) and warriorElite their elite;
+// block = the first of the 18 entries of sql/fixes/world/2026_11_26_32_tower_skirmish_all_classes.sql
+// for this faction and zone: block + 0-5 the regular paladin .. demon hunter, block + 6-17 the elite
+// frost mage .. demon hunter (table order)
+inline OPvPSkirmishSoldiers MakeSkirmishSoldiers(uint32 const (&first)[OPVP_SKIRMISH_FIRST_CLASSES], uint32 warriorElite, uint32 block, uint32 hunterPet, uint32 warlockPet)
+{
+    OPvPSkirmishSoldiers soldiers = { };
+    for (uint8 i = 0; i < OPVP_SKIRMISH_POOL_SIZE; ++i)
+    {
+        soldiers.regulars[i].entry = i < OPVP_SKIRMISH_FIRST_CLASSES ? first[i] : block + (i - OPVP_SKIRMISH_FIRST_CLASSES);
+        soldiers.elites[i].entry = i == OPVP_SKIRMISH_WARRIOR ? warriorElite : block + (OPVP_SKIRMISH_POOL_SIZE - OPVP_SKIRMISH_FIRST_CLASSES) + (i - 1);
+    }
+    soldiers.regulars[OPVP_SKIRMISH_HUNTER].pet = soldiers.elites[OPVP_SKIRMISH_HUNTER].pet = hunterPet;
+    soldiers.regulars[OPVP_SKIRMISH_WARLOCK].pet = soldiers.elites[OPVP_SKIRMISH_WARLOCK].pet = warlockPet;
+    return soldiers;
+}
