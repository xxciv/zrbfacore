+void LootTemplate::AddItemIfNoneDropped(Loot& loot, uint16 lootMode, Player const* player) const
+{
+    if (!player)
+        return;
+
+    // Plain and grouped items the player could be shown; references, currencies and quest items don't count
+    std::vector<LootStoreItem const*> candidates;
+    auto addCandidate = [&](LootStoreItem const* item)
+    {
+        if (item->reference || item->type != LOOT_ITEM_TYPE_ITEM || item->needs_quest || !(item->lootmode & lootMode) || !item->conditions.empty())
+            return;
+
+        if (LootItem(*item).AllowedForPlayer(player))
+            candidates.push_back(item);
+    };
+
+    for (LootStoreItem const* item : Entries)
+        addCandidate(item);
+
+    for (LootGroup* group : Groups)
+    {
+        if (!group)
+            continue;
+
+        for (LootStoreItem const* item : *group->GetExplicitlyChancedItemList())
+            addCandidate(item);
+        for (LootStoreItem const* item : *group->GetEqualChancedItemList())
+            addCandidate(item);
+    }
+
+    if (candidates.empty())
+        return;
+
+    auto qualityOf = [](uint32 itemId) -> uint32
+    {
+        ItemTemplate const* proto = sObjectMgr->GetItemTemplate(itemId);
+        return proto ? proto->GetQuality() : uint32(ITEM_QUALITY_POOR);
+    };
+
+    // Prefer the boss's own gear (uncommon or better) over cloth and junk when the table has any
+    uint32 minQuality = ITEM_QUALITY_POOR;
+    for (LootStoreItem const* item : candidates)
+    {
+        if (qualityOf(item->itemid) >= ITEM_QUALITY_UNCOMMON)
+        {
+            minQuality = ITEM_QUALITY_UNCOMMON;
+            break;
+        }
+    }
+
+    auto itr = loot.items.find(player->GetGUID());
+    if (itr != loot.items.end())
+        for (LootItem const& item : itr->second)
+            if (!item.currency && !item.needs_quest && qualityOf(item.itemid) >= minQuality)
+                return;                                     // the normal rolls already dropped one
+
+    candidates.erase(std::remove_if(candidates.begin(), candidates.end(), [&](LootStoreItem const* item)
+    {
+        return qualityOf(item->itemid) < minQuality;
+    }), candidates.end());
+
+    // Pick by drop chance, so a rare item stays rare; equal-chanced group entries weigh 1%
+    LootStoreItem const* item = *Trinity::Containers::SelectRandomWeightedContainerElement(candidates, [](LootStoreItem const* candidate)
+    {
+        return candidate->chance > 0.0f ? double(candidate->chance) : 1.0;
+    });
+
+    loot.AddItem(*item, player);
+}
