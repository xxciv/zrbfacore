+
+            ++_tries;
+            kit->InstallAccessory(NPC_BALLOON_CART_BUNNY, 0, true, TEMPSUMMON_MANUAL_DESPAWN, 0);
+        }
+
+    private:
+        uint32 _checkTimer;
+        uint8 _tries;
+    };
+
