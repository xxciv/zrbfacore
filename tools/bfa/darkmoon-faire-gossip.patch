 // 54485 - Jessica Rogers
+// zrbfacore: the game auras stayed on players who walked away from the booth.
+// Ring Toss: 20 yards from Jessica (the booth focus range). Shooting Gallery: 12 yards from
+// Rinling (his counter focus reaches 10 yards from a spot 3 yards away).
+static void RemoveGameAuraAwayFromBooth(Creature* me, uint32 spellId, float range, char const* text)
+{
+    Map::PlayerList const& players = me->GetMap()->GetPlayers();
+    for (Map::PlayerList::const_iterator itr = players.begin(); itr != players.end(); ++itr)
+    {
+        Player* player = itr->GetSource();
+        if (!player || !player->HasAura(spellId))
+            continue;
+
+        if (player->GetExactDist2d(me) <= range)
+            continue;
+
+        player->RemoveAurasDueToSpell(spellId);
+        me->Whisper(text, LANG_UNIVERSAL, player);
+    }
+}
