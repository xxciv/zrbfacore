+
+    struct npc_darkmoon_balloon_cartAI : public ScriptedAI
+    {
+        npc_darkmoon_balloon_cartAI(Creature* creature) : ScriptedAI(creature), _checkTimer(1000), _tries(0) { }
+
+        void UpdateAI(uint32 diff) override
+        {
+            if (_tries >= 5)
+                return;
+
+            if (_checkTimer > diff)
+            {
+                _checkTimer -= diff;
+                return;
+            }
+            _checkTimer = 2000;
+
+            Vehicle* kit = me->GetVehicleKit();
+            if (!kit || !me->GetVehicle())
