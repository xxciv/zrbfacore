+class at_darkmoon_firebird_ring : public AreaTriggerEntityScript
+{
+public:
+    at_darkmoon_firebird_ring() : AreaTriggerEntityScript("at_darkmoon_firebird_ring") { }
+
+    struct at_darkmoon_firebird_ringAI : AreaTriggerAI
+    {
+        at_darkmoon_firebird_ringAI(AreaTrigger* areatrigger) : AreaTriggerAI(areatrigger), _taken(false) { }
+
+        void OnCreate() override
+        {
+            at->SetDuration(FIREBIRD_RING_DURATION);
+        }
+
+        void OnUnitEnter(Unit* unit) override
+        {
+            if (unit && unit == at->GetCaster())
+                Take(unit->ToPlayer());
+        }
+
+        // A fast flier can pass through between two target-list updates; check the
+        // distance to the owner on every update as well.
+        void OnUpdate(uint32 /*diff*/) override
+        {
+            Unit* caster = at->GetCaster();
+            if (caster && caster->IsWithinDist3d(at, 6.0f))
+                Take(caster->ToPlayer());
+        }
+
+        void Take(Player* player)
+        {
+            if (_taken || !player || !IsFlyingFirebird(player))
+                return;
+
+            _taken = true;
+            player->CastSpell(player, SPELL_FIREBIRD_BLAZING_RING, true);
+            at->Remove();
+        }
+
+    private:
+        bool _taken;
+    };
+
+    AreaTriggerAI* GetAI(AreaTrigger* areatrigger) const override
+    {
+        return new at_darkmoon_firebird_ringAI(areatrigger);
+    }
