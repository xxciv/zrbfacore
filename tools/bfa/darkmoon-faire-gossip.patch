+// zrbfacore: Firebird's Challenge (Ziggie Sparks 85546, quest 36481, 15 rings). Wings of
+// Flame (170819) casts 170820 every 2.5 s, which triggers Summon Rings (170817): a script
+// effect with no script, so no ring ever appeared. It now puts a ring (170815, areatrigger
+// 3069) in the air 20-30 yards ahead of the player. Flying through your own ring casts
+// Blazing Ring (170823, kill credit 85559) and removes it; unused rings fade after 15 s.
+enum FirebirdChallenge
+{
+    SPELL_FIREBIRD_WINGS_OF_FLAME = 170819,
+    SPELL_FIREBIRD_RING_AT        = 170815,
+    SPELL_FIREBIRD_BLAZING_RING   = 170823,
+    SPELL_FIREBIRD_WINGS_PERIODIC = 170820,
+    FIREBIRD_RING_DURATION        = 15000,
+};
+
+// zrbfacore (2026-11-06 retest: the first ring never counted and no more came): Wings of
+// Flame 170819 itself may be short; the flight is the 170820 aura it keeps refreshing.
+static bool IsFlyingFirebird(Unit const* unit)
+{
+    return unit && (unit->HasAura(SPELL_FIREBIRD_WINGS_OF_FLAME) || unit->HasAura(SPELL_FIREBIRD_WINGS_PERIODIC));
+}
