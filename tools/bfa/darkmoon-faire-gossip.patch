+class spell_darkmoon_firebird_summon_rings : public SpellScriptLoader
+{
+public:
+    spell_darkmoon_firebird_summon_rings() : SpellScriptLoader("spell_darkmoon_firebird_summon_rings") { }
+
+    class spell_darkmoon_firebird_summon_rings_SpellScript : public SpellScript
+    {
+        PrepareSpellScript(spell_darkmoon_firebird_summon_rings_SpellScript);
+
+        void HandleScript(SpellEffIndex /*effIndex*/)
+        {
+            Player* player = GetHitUnit() ? GetHitUnit()->ToPlayer() : nullptr;
+            if (!player || !IsFlyingFirebird(player))
+                return;
+
+            float dist = frand(20.0f, 30.0f);
+            float angle = player->GetOrientation() + frand(-0.6f, 0.6f);
+            float x = player->GetPositionX() + dist * std::cos(angle);
+            float y = player->GetPositionY() + dist * std::sin(angle);
+            float z = player->GetPositionZ() + frand(-6.0f, 8.0f);
+
+            float ground = player->GetMap()->GetHeight(player->GetPhaseShift(), x, y, z + 50.0f, true, 100.0f);
+            if (z < ground + 6.0f)
+                z = ground + 6.0f;
+
+            player->CastSpell(x, y, z, SPELL_FIREBIRD_RING_AT, true);
+        }
+
+        void Register() override
+        {
+            OnEffectHitTarget += SpellEffectFn(spell_darkmoon_firebird_summon_rings_SpellScript::HandleScript, EFFECT_0, SPELL_EFFECT_SCRIPT_EFFECT);
+        }
+    };
+
+    SpellScript* GetSpellScript() const override
+    {
+        return new spell_darkmoon_firebird_summon_rings_SpellScript();
+    }
+};
