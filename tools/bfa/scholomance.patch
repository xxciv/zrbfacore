+#include "ScriptMgr.h"
+#include "ScriptedCreature.h"
+#include "GameObject.h"
+#include "InstanceScript.h"
+#include "MotionMaster.h"
+#include "Player.h"
+#include "scholomance.h"
+
+enum GandlingIntroTexts
+{
+    TALK_GANDLING_VISITORS      = 0, // My dear, it appears we have visitors! Friends of yours, Voss?
+    TALK_GANDLING_EMPOWER       = 1,
+    TALK_GANDLING_TIRED         = 2,
+    TALK_GANDLING_BEAUTIFUL     = 3,
+    TALK_GANDLING_MIRROR        = 4,
+    TALK_GANDLING_GIFT          = 5,
+    TALK_GANDLING_FATE          = 6, // Come, Voss, your fate awaits you.
+    TALK_GANDLING_FORGET        = 7, // Did you forget, girl? I am the Darkmaster! I command the undead!
+    TALK_GANDLING_RUNEBLADES    = 8, // Now turn your lovely runeblades on our guests, and fetch me their bones!
+    TALK_GANDLING_SPIRIT        = 9, // How intriguing, her spirit will not relinquish its grasp on this world.
+    TALK_GANDLING_WHAT          = 10, // What?!
+};
+
+enum ScholomanceEvents
+{
+    EVENT_TALK_1                = 1,
+    EVENT_TALK_2,
+    EVENT_TALK_3,
+    EVENT_TALK_4,
+    EVENT_TALK_5,
+    EVENT_GO_TO_DOOR,
+    EVENT_RUNEBLADES,
+    EVENT_LEAVE,
+    EVENT_AT_LILIAN,
+
+    EVENT_ESCORT                = 20,
+    EVENT_ALEXEI,
+};
+
+// Chillheart intro door 211259: opening it wakes Chillheart and the Talking Skull
+class go_chillheart_iron_door : public GameObjectScript
+{
+public:
+    go_chillheart_iron_door() : GameObjectScript("go_chillheart_iron_door") { }
+
+    bool OnGossipHello(Player* /*player*/, GameObject* go) override
+    {
+        if (Creature* chillheart = go->FindNearestCreature(NPC_INSTRUCTOR_CHILLHEART, 150.0f))
+            chillheart->AI()->DoAction(ACTION_INTRO);
+
+        if (Creature* skull = go->FindNearestCreature(NPC_TALKING_SKULL, 150.0f))
+            skull->AI()->DoAction(ACTION_INTRO);
+
+        return false; // the door opens as usual
+    }
+};
+
+// Darkmaster Gandling 58875, before the fight: taunts Lilian Voss over Rattlegore's hall,
+// then watches her fight from the gallery of her room
+struct npc_gandling_at_rattlegore : public ScriptedAI
+{
+    npc_gandling_at_rattlegore(Creature* creature) : ScriptedAI(creature), _instance(creature->GetInstanceScript()), _atLilian(false), _introStarted(false) { }
+
+    void InitializeAI() override
+    {
+        ScriptedAI::InitializeAI();
+
+        if (!_instance)
+            return;
+
+        if (_instance->GetBossState(DATA_LILIAN_VOSS) == DONE)
+            me->DespawnOrUnsummon();
+        else if (_instance->GetBossState(DATA_JANDICE_BAROV) == DONE)
+        {
+            // instance reloaded after the speech
+            _introStarted = true;
+            me->NearTeleportTo(GandlingTeleportPos);
+            me->SetHomePosition(GandlingTeleportPos);
+            _events.ScheduleEvent(EVENT_AT_LILIAN, 3000);
+        }
+    }
+
+    void Reset() override
+    {
+        // he floats in place (hover animation, set by his template addon); he never walks or flies:
+        // a humanoid moving through the air plays the swim animation
+        me->SetDisableGravity(true);
+        me->SetReactState(REACT_PASSIVE);
+        me->AddUnitFlag(UNIT_FLAG_NON_ATTACKABLE);
+        if (!_atLilian && !me->HasAura(SPELL_BONE_ARMOR_VISUAL))
+            me->AddAura(SPELL_BONE_ARMOR_VISUAL, me);
+    }
+
+    void AttackStart(Unit* /*who*/) override { }
+
+    void DoAction(int32 action) override
+    {
+        switch (action)
+        {
+            case ACTION_INTRO:
+                if (_introStarted)
+                    break;
+                _introStarted = true;
+                Talk(TALK_GANDLING_VISITORS);
+                if (_instance)
+                    if (Creature* lilian = _instance->GetCreature(DATA_LILIAN_VOSS))
+                        lilian->AI()->DoAction(ACTION_INTRO);
+                _events.ScheduleEvent(EVENT_TALK_1, 6000);
+                break;
+            case ACTION_DIFF_INTRO:
+                Talk(TALK_GANDLING_SPIRIT);
+                break;
+            case ACTION_REMOVE_LILIAN_SOUL:
+                Talk(TALK_GANDLING_WHAT);
+                _events.ScheduleEvent(EVENT_LEAVE, 4500);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void MovementInform(uint32 type, uint32 pointId) override
+    {
+        if (type != POINT_MOTION_TYPE)
+            return;
+
+        switch (pointId)
+        {
+            case 0: // Rattlegore's door: he vanishes and reappears above Lilian's room
+                Talk(TALK_GANDLING_FATE);
+                DoCast(me, SPELL_TELEPORT_VISUAL, true);
+                me->RemoveAurasDueToSpell(SPELL_BONE_ARMOR_VISUAL);
+                _events.ScheduleEvent(EVENT_AT_LILIAN, 1500);
+                break;
+            case 1:
+                DoCast(me, SPELL_TELEPORT_VISUAL, true);
+                me->DespawnOrUnsummon(500);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (_atLilian)
+        {
+            Player* player = me->SelectNearestPlayer(25.0f);
+            if (player && !player->IsGameMaster() && player->GetPositionZ() <= 109.0f)
+            {
+                _atLilian = false;
+                Talk(TALK_GANDLING_FORGET);
+                _events.ScheduleEvent(EVENT_RUNEBLADES, 8000);
+
+                if (_instance)
+                {
+                    if (Creature* lilian = _instance->GetCreature(DATA_LILIAN_VOSS))
+                        lilian->AI()->DoAction(ACTION_DIFF_INTRO);
+                    if (Creature* skull = _instance->GetCreature(DATA_TALKING_SKULL))
+                        skull->AI()->DoAction(ACTION_CONTINUE_MOVE);
+                }
+            }
+        }
+
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_TALK_1:
+                    Talk(TALK_GANDLING_EMPOWER);
+                    _events.ScheduleEvent(EVENT_TALK_2, 10000);
+                    break;
+                case EVENT_TALK_2:
+                    Talk(TALK_GANDLING_TIRED);
+                    _events.ScheduleEvent(EVENT_TALK_3, 10000);
+                    break;
+                case EVENT_TALK_3:
+                    Talk(TALK_GANDLING_BEAUTIFUL);
+                    _events.ScheduleEvent(EVENT_TALK_4, 10000);
+                    break;
+                case EVENT_TALK_4:
+                    Talk(TALK_GANDLING_MIRROR);
+                    _events.ScheduleEvent(EVENT_TALK_5, 10000);
+                    break;
+                case EVENT_TALK_5:
+                    Talk(TALK_GANDLING_GIFT);
+                    _events.ScheduleEvent(EVENT_GO_TO_DOOR, 6000);
+                    break;
+                case EVENT_GO_TO_DOOR:
+                    // he vanishes from Rattlegore's hall and reappears above Lilian's room
+                    me->RemoveAurasDueToSpell(SPELL_SOUL_RIP_VISUAL);
+                    me->RemoveAurasDueToSpell(SPELL_BONE_ARMOR_VISUAL);
+                    Talk(TALK_GANDLING_FATE);
+                    DoCast(me, SPELL_TELEPORT_VISUAL, true);
+                    _events.ScheduleEvent(EVENT_AT_LILIAN, 1500);
+                    break;
+                case EVENT_AT_LILIAN:
+                    me->NearTeleportTo(GandlingTeleportPos);
+                    me->SetHomePosition(GandlingTeleportPos);
+                    _atLilian = true;
+                    DoCast(me, SPELL_GANDLING_INTRO_CHANNEL, true);
+                    if (_instance)
+                        if (Creature* lilian = _instance->GetCreature(DATA_LILIAN_VOSS))
+                            me->CastSpell(lilian, SPELL_COSMETIC_SOUL_RIP, false);
+                    break;
+                case EVENT_RUNEBLADES:
+                    Talk(TALK_GANDLING_RUNEBLADES);
+                    break;
+                case EVENT_LEAVE:
+                    if (_instance)
+                        if (Creature* skull = _instance->GetCreature(DATA_TALKING_SKULL))
+                            skull->AI()->Talk(TALK_SKULL_GANDLING_LEAVE);
+                    me->InterruptNonMeleeSpells(true);
+                    me->RemoveAllAuras();
+                    DoCast(me, SPELL_TELEPORT_VISUAL, true);
+                    me->DespawnOrUnsummon(1000);
+                    break;
+                default:
+                    break;
+            }
+        }
+    }
+
+private:
+    InstanceScript* _instance;
+    EventMap _events;
+    bool _atLilian;
+    bool _introStarted;
+};
+
+// Talking Skull 64562: floats ahead of the group and comments on each boss
+struct npc_talking_skull : public ScriptedAI
+{
+    npc_talking_skull(Creature* creature) : ScriptedAI(creature), _instance(creature->GetInstanceScript()), _wp(0), _atGandling(false), _started(false) { }
+
+    void InitializeAI() override
+    {
+        ScriptedAI::InitializeAI();
+        me->SetWalk(true);
+        me->SetSpeedRate(MOVE_WALK, 2.3f);
+
+        if (!_instance)
+            return;
+
+        // instance reloaded: wait where the last boss left it
+        uint8 stop = 0;
+        if (_instance->GetBossState(DATA_LILIAN_VOSS) == DONE)
+            stop = 29;
+        else if (_instance->GetBossState(DATA_RATTLEGORE) == DONE)
+            stop = 14;
+        else if (_instance->GetBossState(DATA_JANDICE_BAROV) == DONE)
+            stop = 11;
+        else if (_instance->GetBossState(DATA_INSTRUCTOR_CHILLHEART) == DONE)
+            stop = 10;
+
+        if (stop)
+        {
+            _started = true;
+            _wp = stop + 1;
+            _atGandling = stop == 29;
+            me->NearTeleportTo(SkullPath[stop]);
+            me->SetHomePosition(SkullPath[stop]);
+        }
+    }
+
+    void AttackStart(Unit* /*who*/) override { }
+
+    void DoAction(int32 action) override
+    {
+        switch (action)
+        {
+            case ACTION_INTRO:
+                if (_started)
+                    break;
+                _started = true;
+                _events.ScheduleEvent(EVENT_ESCORT, urand(1000, 2000));
+                break;
+            case ACTION_CONTINUE_MOVE:
+                if (_started && !_atGandling)
+                    _events.ScheduleEvent(EVENT_ESCORT, urand(1000, 2000));
+                break;
+            case ACTION_ALEXEI:
+                _events.ScheduleEvent(EVENT_ALEXEI, urand(3000, 5000));
+                break;
+            default:
+                break;
+        }
+    }
+
+    void MovementInform(uint32 type, uint32 pointId) override
+    {
+        if (type != POINT_MOTION_TYPE || pointId != _wp)
+            return;
+
+        ++_wp;
+        me->SetHomePosition(me->GetPosition());
+
+        switch (pointId)
+        {
+            case 0:
+                Talk(TALK_SKULL_CHILLHEART_ENTRANCE);
+                Talk(TALK_SKULL_CHILLHEART);
+                break;
+            case 9:
+                Talk(TALK_SKULL_JANDICE_ENTRANCE);
+                _events.ScheduleEvent(EVENT_ESCORT, 4000);
+                break;
+            case 10:
+            case 14:
+                break;
+            case 11:
+                Talk(TALK_SKULL_RATTLEGORE_ENTRANCE);
+                break;
+            case 16:
+                Talk(TALK_SKULL_LILIAN_ENTRANCE);
+                break;
+            case 29:
+                Talk(TALK_SKULL_GANDLING_ENTRANCE);
+                _atGandling = true;
+                break;
+            default:
+                _events.ScheduleEvent(EVENT_ESCORT, 100);
+                break;
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_ESCORT:
+                    if (_wp < SKULL_PATH_SIZE)
+                        me->GetMotionMaster()->MovePoint(_wp, SkullPath[_wp], false);
+                    break;
+                case EVENT_ALEXEI:
+                    // Gandling is dead and Alexei's spirit is free (the instance summons him): the skull's work is done
+                    me->DespawnOrUnsummon();
+                    break;
+                default:
+                    break;
+            }
+        }
+    }
+
+private:
+    InstanceScript* _instance;
+    EventMap _events;
+    uint8 _wp;
+    bool _atGandling;
+    bool _started;
+};
+
+void AddSC_scholomance()
+{
+    new go_chillheart_iron_door();
+    RegisterCreatureAI(npc_gandling_at_rattlegore);
+    RegisterCreatureAI(npc_talking_skull);
+}
