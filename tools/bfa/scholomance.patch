+enum GandlingSpells
+{
+    SPELL_HARSH_LESSON          = 113395,
+    SPELL_IMMOLATE              = 113141,
+    SPELL_INCINERATE            = 113136,
+    SPELL_RISE                  = 113143,
+
+    SPELL_GANDLING_FIRE_AURA    = 114904, // on the stalker above him
+    SPELL_COSMETIC_CAST         = 21389,
+};
+
+enum GandlingEvents
+{
+    EVENT_IMMOLATE              = 1,
+    EVENT_RISE,
+    EVENT_HARSH_LESSON,
+    EVENT_INCINERATE,
+
+    EVENT_CHECK_ROOM            = 10,
+};
+
+enum GandlingTexts
+{
+    TALK_AGGRO                  = 0, // School is in session!
+    TALK_SLAY                   = 1, // Dunce.
+    TALK_DEATH                  = 2, // Class... dismissed.
+    TALK_HARSH_LESSON           = 3, // %s assigns $n a [Harsh Lesson]!
+};
+
+// Darkmaster Gandling 59080
+struct boss_grandmaster_gandling : public BossAI
+{
+    boss_grandmaster_gandling(Creature* creature) : BossAI(creature, DATA_GRANDMASTER_GANDLING) { }
+
+    void InitializeAI() override
+    {
+        SetCombatMovement(false);
+        BossAI::InitializeAI();
+    }
+
+    void Reset() override
+    {
+        _Reset();
+        me->setRegeneratingHealth(true);
+        me->SetReactState(REACT_AGGRESSIVE);
+        if (!me->HasAura(SPELL_COSMETIC_CAST))
+            DoCast(me, SPELL_COSMETIC_CAST, true);
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _JustEngagedWith();
+        Talk(TALK_AGGRO);
+        me->RemoveAurasDueToSpell(SPELL_COSMETIC_CAST);
+
+        events.ScheduleEvent(EVENT_INCINERATE, 500);
+        events.ScheduleEvent(EVENT_IMMOLATE, urand(5000, 10000));
+        events.ScheduleEvent(EVENT_HARSH_LESSON, urand(25000, 40000));
+        events.ScheduleEvent(EVENT_RISE, 45000);
+
+        if (Creature* fireStalker = me->FindNearestCreature(NPC_GANDLING_FIRE_STALKER, 50.0f))
+            fireStalker->RemoveAurasDueToSpell(SPELL_GANDLING_FIRE_AURA);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _JustDied();
+        Talk(TALK_DEATH);
+    }
+
+    void KilledUnit(Unit* victim) override
+    {
+        if (victim->GetTypeId() == TYPEID_PLAYER)
+            Talk(TALK_SLAY);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        if (!UpdateVictim())
+            return;
+
+        events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_INCINERATE:
+                    DoCastVictim(SPELL_INCINERATE);
+                    events.ScheduleEvent(EVENT_INCINERATE, urand(2500, 3000));
+                    break;
+                case EVENT_IMMOLATE:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 50.0f, true))
+                        DoCast(target, SPELL_IMMOLATE);
+                    events.ScheduleEvent(EVENT_IMMOLATE, urand(5000, 10000));
+                    break;
+                case EVENT_RISE:
+                    DoCast(me, SPELL_RISE);
+                    events.ScheduleEvent(EVENT_RISE, 70000);
+                    break;
+                case EVENT_HARSH_LESSON:
+                    HarshLesson();
+                    events.ScheduleEvent(EVENT_HARSH_LESSON, 60000);
+                    break;
+                default:
+                    break;
+            }
+
+            if (me->HasUnitState(UNIT_STATE_CASTING))
+                return;
+        }
+    }
+
+private:
+    // a player other than the tank is sent to one of the side classrooms full of test subjects;
+    // the classroom opens again once they are all dead. Never happens solo.
+    void HarshLesson()
+    {
+        std::list<Creature*> rooms;
+        me->GetCreatureListWithEntryInGrid(rooms, NPC_GANDLING_ROOM_STALKER, 200.0f);
+        if (rooms.empty())
+            return;
+
+        Unit* victim = me->GetVictim();
+        Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, [victim](Unit* unit)
+        {
+            return unit->GetTypeId() == TYPEID_PLAYER && unit != victim;
+        });
+        if (!target)
+            return;
+
+        Creature* room = Trinity::Containers::SelectRandomContainerElement(rooms);
+        DoCast(target, SPELL_HARSH_LESSON, true);
+        Talk(TALK_HARSH_LESSON, target);
+        target->ToPlayer()->TeleportTo(room->GetMapId(), room->GetPositionX(), room->GetPositionY(), room->GetPositionZ(), room->GetOrientation(), TELE_TO_NOT_LEAVE_COMBAT | TELE_TO_NOT_UNSUMMON_PET);
+    }
+};
+
+// Teleport Location 59167: one per Harsh Lesson classroom; opens its door once the expired
+// test subjects in the room are dead
+struct npc_gandling_room_stalker : public ScriptedAI
+{
+    npc_gandling_room_stalker(Creature* creature) : ScriptedAI(creature) { }
+
+    void Reset() override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        _events.ScheduleEvent(EVENT_CHECK_ROOM, 1000);
+    }
+
+    void AttackStart(Unit* /*who*/) override { }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+        if (_events.ExecuteEvent() != EVENT_CHECK_ROOM)
+            return;
+
+        if (HasAliveSubjectInRoom())
+        {
+            _events.ScheduleEvent(EVENT_CHECK_ROOM, 1000);
+            return;
+        }
+
+        if (GameObject* door = FindRoomDoor())
+            door->UseDoorOrButton();
+        me->DespawnOrUnsummon();
+    }
+
+private:
+    bool HasAliveSubjectInRoom()
+    {
+        std::list<Creature*> subjects;
+        me->GetCreatureListWithEntryInGrid(subjects, NPC_EXPIRED_TEST_SUBJECT, 45.0f);
+        for (Creature* subject : subjects)
+            if (subject->IsAlive() && std::abs(subject->GetPositionZ() - me->GetPositionZ()) < 5.0f)
+                return true;
+        return false;
+    }
+
+    GameObject* FindRoomDoor()
+    {
+        static uint32 const doors[] =
+        {
+            GO_HARSH_LESSON_EAST_LOW, GO_HARSH_LESSON_NORTH_LOW, GO_HARSH_LESSON_WEST_LOW,
+            GO_HARSH_LESSON_EAST_HIGH, GO_HARSH_LESSON_NORTH_HIGH, GO_HARSH_LESSON_WEST_HIGH
+        };
+
+        GameObject* closest = nullptr;
+        for (uint32 entry : doors)
+            if (GameObject* door = me->FindNearestGameObject(entry, 40.0f))
+                if (!closest || me->GetDistance(door) < me->GetDistance(closest))
+                    closest = door;
+        return closest;
+    }
+
+    EventMap _events;
+};
+
+void AddSC_boss_grandmaster_gandling()
+{
+    RegisterCreatureAI(boss_grandmaster_gandling);
+    RegisterCreatureAI(npc_gandling_room_stalker);
+}
