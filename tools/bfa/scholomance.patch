new file mode 100644
index 0000000..f106f56
--- /dev/null
+++ b/src/server/scripts/EasternKingdoms/Scholomance/boss_rattlegore.cpp
@@ -0,0 +1,295 @@
+/*
+ * 2026 BFA-HavenCore
+ *
+ * Rattlegore, Scholomance. Ported from the Pandaria 5.4.8 project (GPL v2 or later).
+ *
