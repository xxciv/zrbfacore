+#include "ScriptMgr.h"
+#include "ScriptedCreature.h"
+#include "Containers.h"
+#include "InstanceScript.h"
+#include "MotionMaster.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "Random.h"
+#include "SpellAuraEffects.h"
+#include "SpellScript.h"
+#include "TemporarySummon.h"
+#include "scholomance.h"
+
+enum ChillheartSpells
+{
+    SPELL_WRACK_SOUL            = 111631, // heroic: jumps from player to player
+    SPELL_ICE_WRATH             = 111610,
+    SPELL_TOUCH_OF_THE_GRAVE    = 111606,
+    SPELL_FRIGID_GRASP          = 111239, // on the Frostgrasp stalker
+    SPELL_FROST_GRASP           = 109295, // heroic only
+
+    SPELL_ARCANE_BOMB           = 113859,
+    SPELL_BURN                  = 111574,
+    SPELL_SHADOW_BOLT           = 113809,
+    SPELL_PHYLACTERY_FILLED     = 111256,
+};
+
+enum ChillheartEvents
+{
+    EVENT_WRACK_SOUL            = 1,
+    EVENT_ICE_WRATH,
+    EVENT_TOUCH_OF_THE_GRAVE,
+    EVENT_FRIGID_GRASP,
+    EVENT_MOVE_WALL,
+
+    EVENT_ARCANE_BOMB,
+    EVENT_SHADOW_BOLT,
+    EVENT_COSMETIC,
+};
+
+enum ChillheartTexts
+{
+    // voice only in this database, see ChillheartSounds
+    VOICE_INTRO                 = 0,
+    VOICE_AGGRO,
+    VOICE_WRACK_SOUL,
+    VOICE_FAKE_DEATH,
+    VOICE_DEATH,
+};
+
+uint32 const ChillheartSounds[] = { 29460, 29455, 29457, 29458, 29456 };
+
+uint8 const BOOKS_PER_TARGET = 1;
+
+// Instructor Chillheart 58633
+struct boss_instructor_chillheart : public BossAI
+{
+    boss_instructor_chillheart(Creature* creature) : BossAI(creature, DATA_INSTRUCTOR_CHILLHEART), _fakeDeath(false), _introDone(false) { }
+
+    void Reset() override
+    {
+        _Reset();
+        _fakeDeath = false;
+        me->setRegeneratingHealth(true);
+        me->SetReactState(REACT_AGGRESSIVE);
+        me->SetStandState(UNIT_STAND_STATE_STAND);
+        me->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+        RemoveBooks();
+
+        if (Creature* wall = me->FindNearestCreature(NPC_ICE_WALL_STALKER, 100.0f))
+            wall->AI()->DoAction(ACTION_DESTROY_WALL);
+
+        if (Creature* phylactery = me->FindNearestCreature(NPC_PHYLACTERY, 100.0f))
+            phylactery->AI()->EnterEvadeMode();
+
+        _events.ScheduleEvent(EVENT_COSMETIC, 2000);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _JustDied();
+        PlayVoiceLine(me, ChillheartSounds[VOICE_DEATH]);
+        RemoveBooks();
+
+        if (Creature* wall = me->FindNearestCreature(NPC_ICE_WALL_STALKER, 100.0f))
+            wall->AI()->DoAction(ACTION_DESTROY_WALL);
+    }
+
+    void EnterEvadeMode(EvadeReason why) override
+    {
+        BossAI::EnterEvadeMode(why);
+        summons.DespawnAll();
+        RemoveBooks();
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _JustEngagedWith();
+        PlayVoiceLine(me, ChillheartSounds[VOICE_AGGRO]);
+        me->InterruptNonMeleeSpells(false);
+
+        events.ScheduleEvent(EVENT_ICE_WRATH, urand(6500, 8000));
+        events.ScheduleEvent(EVENT_FRIGID_GRASP, urand(10000, 15000));
+        events.ScheduleEvent(EVENT_TOUCH_OF_THE_GRAVE, 1000);
+        if (IsHeroic())
+            events.ScheduleEvent(EVENT_WRACK_SOUL, 2500);
+
+        // the students channelling into the phylactery are sacrificed
+        std::list<Creature*> students;
+        me->GetCreatureListWithEntryInGrid(students, NPC_SCHOLOMANCE_NEOPHYTE, 150.0f);
+        me->GetCreatureListWithEntryInGrid(students, NPC_SCHOLOMANCE_ACOLYTE, 150.0f);
+        for (Creature* student : students)
+            if (student->IsAlive() && !student->IsInCombat())
+                student->KillSelf();
+
+        if (Creature* wall = me->FindNearestCreature(NPC_ICE_WALL_STALKER, 100.0f))
+            wall->AI()->DoAction(ACTION_ACTIVATE);
+    }
+
+    void JustSummoned(Creature* summon) override
+    {
+        BossAI::JustSummoned(summon);
+
+        if (summon->GetEntry() == NPC_FROSTGRASP_STALKER)
+        {
+            summon->SetReactState(REACT_PASSIVE);
+            summon->CastSpell(summon, SPELL_FRIGID_GRASP, false);
+            if (IsHeroic())
+                summon->CastSpell(summon, SPELL_FROST_GRASP, true);
+            summon->DespawnOrUnsummon(7000);
+        }
+    }
+
+    void DoAction(int32 action) override
+    {
+        switch (action)
+        {
+            case ACTION_INTRO:
+                if (!_introDone)
+                {
+                    _introDone = true;
+                    PlayVoiceLine(me, ChillheartSounds[VOICE_INTRO]);
+                }
+                break;
+            case ACTION_CHILLHEART_DEATH:
+                if (_fakeDeath && me->IsAlive())
+                    me->KillSelf();
+                break;
+            default:
+                break;
+        }
+    }
+
+    void DamageTaken(Unit* attacker, uint32& damage) override
+    {
+        if (_fakeDeath)
+        {
+            damage = 0;
+            return;
+        }
+
+        if (RealDamage(me, attacker, damage) < me->GetHealth())
+            return;
+
+        // he does not die: his soul flees into the phylactery, which has to be destroyed
+        damage = 0;
+        _fakeDeath = true;
+        PlayVoiceLine(me, ChillheartSounds[VOICE_FAKE_DEATH]);
+        events.Reset();
+        me->InterruptNonMeleeSpells(true);
+        me->SetReactState(REACT_PASSIVE);
+        me->AttackStop();
+        me->SetHealth(1);
+        me->SetStandState(UNIT_STAND_STATE_DEAD);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+
+        if (Creature* wall = me->FindNearestCreature(NPC_ICE_WALL_STALKER, 100.0f))
+            wall->AI()->DoAction(ACTION_DESTROY_WALL);
+
+        if (Creature* phylactery = me->FindNearestCreature(NPC_PHYLACTERY, 100.0f))
+            phylactery->AI()->DoAction(ACTION_ACTIVATE);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+        if (_events.ExecuteEvent() == EVENT_COSMETIC && !me->IsInCombat())
+        {
+            if (!me->HasUnitState(UNIT_STATE_CASTING))
+                if (Creature* phylactery = me->FindNearestCreature(NPC_PHYLACTERY, 100.0f))
+                    me->CastSpell(phylactery, SPELL_COSMETIC_SHADOW_CHANNEL, false);
+            _events.ScheduleEvent(EVENT_COSMETIC, 5000);
+        }
+
+        if (!UpdateVictim())
+            return;
+
+        events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING) || _fakeDeath)
+            return;
+
+        while (uint32 eventId = events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_WRACK_SOUL:
+                    PlayVoiceLine(me, ChillheartSounds[VOICE_WRACK_SOUL]);
+                    if (Unit* target = SelectTarget(SELECT_TARGET_MAXDISTANCE, 0, 60.0f, true))
+                        DoCast(target, SPELL_WRACK_SOUL);
+                    break;
+                case EVENT_FRIGID_GRASP:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 60.0f, true))
+                        me->SummonCreature(NPC_FROSTGRASP_STALKER, target->GetPosition(), TEMPSUMMON_TIMED_DESPAWN, 8000);
+                    events.ScheduleEvent(EVENT_FRIGID_GRASP, urand(10000, 15000));
+                    break;
+                case EVENT_TOUCH_OF_THE_GRAVE:
+                    DoCast(me, SPELL_TOUCH_OF_THE_GRAVE);
+                    events.ScheduleEvent(EVENT_TOUCH_OF_THE_GRAVE, urand(18000, 19000));
+                    break;
+                case EVENT_ICE_WRATH:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 70.0f, true))
+                        me->AddAura(SPELL_ICE_WRATH, target);
+                    events.ScheduleEvent(EVENT_ICE_WRATH, urand(11000, 16000));
+                    break;
+                default:
+                    break;
+            }
+
+            if (me->HasUnitState(UNIT_STATE_CASTING))
+                return;
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    void RemoveBooks()
+    {
+        std::list<Creature*> books;
+        me->GetCreatureListWithEntryInGrid(books, NPC_ANARCHIST_ARCANIST, 150.0f);
+        me->GetCreatureListWithEntryInGrid(books, NPC_ANTONIDAS_GUIDE, 150.0f);
+        me->GetCreatureListWithEntryInGrid(books, NPC_WANDERS_BOOK, 150.0f);
+        me->GetCreatureListWithEntryInGrid(books, NPC_ARCANE_BOMB_CHASE, 150.0f);
+        me->GetCreatureListWithEntryInGrid(books, NPC_ARCANE_BOMB, 150.0f);
+        for (Creature* book : books)
+            book->DespawnOrUnsummon();
+    }
+
+    EventMap _events;
+    bool _fakeDeath;
+    bool _introDone;
+};
+
+// Instructor Chillheart's Phylactery 58664: becomes attackable when Chillheart "dies" and
+// raises the flying books; destroying it finishes Chillheart for good
+struct npc_instructor_chillhearts_phylactery : public ScriptedAI
+{
+    npc_instructor_chillhearts_phylactery(Creature* creature) : ScriptedAI(creature), _active(false) { }
+
+    void Reset() override
+    {
+        _active = false;
+        me->SetReactState(REACT_PASSIVE);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+        me->RemoveAurasDueToSpell(SPELL_PHYLACTERY_FILLED);
+        _events.ScheduleEvent(EVENT_COSMETIC, 2000);
+    }
+
+    void AttackStart(Unit* /*who*/) override { }
+
+    void DoAction(int32 action) override
+    {
+        if (action != ACTION_ACTIVATE || _active)
+            return;
+
+        _active = true;
+        me->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+        DoCast(me, SPELL_FILL_PHYLACTERY, true);
+        DoCast(me, SPELL_PHYLACTERY_FILLED, true);
+        DoZoneInCombat();
+        SummonBooks();
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        if (Creature* chillheart = me->FindNearestCreature(NPC_INSTRUCTOR_CHILLHEART, 100.0f))
+            chillheart->AI()->DoAction(ACTION_CHILLHEART_DEATH);
+    }
+
+    void EnterEvadeMode(EvadeReason why) override
+    {
+        if (!_active)
+            return;
+
+        ScriptedAI::EnterEvadeMode(why);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        if (_events.ExecuteEvent() == EVENT_COSMETIC && !_active)
+        {
+            // students channel into the phylactery until Chillheart is pulled
+            std::list<Creature*> students;
+            me->GetCreatureListWithEntryInGrid(students, NPC_SCHOLOMANCE_ACOLYTE, 16.0f);
+            me->GetCreatureListWithEntryInGrid(students, NPC_SCHOLOMANCE_NEOPHYTE, 16.0f);
+            for (Creature* student : students)
+                if (student->IsAlive() && !student->IsInCombat() && !student->HasUnitState(UNIT_STATE_CASTING))
+                    student->CastSpell(me, SPELL_COSMETIC_SHADOW_CHANNEL, false);
+            _events.ScheduleEvent(EVENT_COSMETIC, 5000);
+        }
+    }
+
+private:
+    // stands in for Summon Books 111669: one book over each Book Spawn Target, the three kinds in turn
+    void SummonBooks()
+    {
+        static uint32 const bookEntries[3] = { NPC_ANARCHIST_ARCANIST, NPC_ANTONIDAS_GUIDE, NPC_WANDERS_BOOK };
+
+        std::list<Creature*> targets;
+        me->GetCreatureListWithEntryInGrid(targets, NPC_BOOK_SPAWN_TARGET, 100.0f);
+
+        uint8 kind = 0;
+        for (Creature* target : targets)
+        {
+            for (uint8 i = 0; i < BOOKS_PER_TARGET; ++i)
+            {
+                Position pos(target->GetPositionX() + frand(-3.0f, 3.0f), target->GetPositionY() + frand(-2.0f, 2.0f), me->GetPositionZ() + 7.0f, 0.0f);
+                me->SummonCreature(bookEntries[kind % 3], pos, TEMPSUMMON_MANUAL_DESPAWN);
+                ++kind;
+            }
+        }
+    }
+
+    EventMap _events;
+    bool _active;
+};
+
+// Ice Wall 68291: a frozen wall closes the room while Chillheart fights
+struct npc_ice_wall_stalker : public ScriptedAI
+{
+    npc_ice_wall_stalker(Creature* creature) : ScriptedAI(creature), _summons(me) { }
+
+    void Reset() override
+    {
+        me->SetReactState(REACT_PASSIVE);
+    }
+
+    void AttackStart(Unit* /*who*/) override { }
+
+    void JustSummoned(Creature* summon) override
+    {
+        _summons.Summon(summon);
+        summon->SetReactState(REACT_PASSIVE);
+        summon->CastSpell(summon, SPELL_ICE_WALL_DUMMY_2, false);
+    }
+
+    void DoAction(int32 action) override
+    {
+        switch (action)
+        {
+            case ACTION_ACTIVATE:
+                _summons.DespawnAll();
+                DoCast(me, SPELL_ICE_WALL_DUMMY_1);
+                for (uint8 i = 1; i <= 7; ++i) // the wall is ~70 yards wide
+                {
+                    me->SummonCreature(NPC_ICE_WALL_MOVE, me->GetPositionX() + 5.0f * i, me->GetPositionY(), me->GetPositionZ(), me->GetOrientation(), TEMPSUMMON_MANUAL_DESPAWN);
+                    me->SummonCreature(NPC_ICE_WALL_MOVE, me->GetPositionX() - 5.0f * i, me->GetPositionY(), me->GetPositionZ(), me->GetOrientation(), TEMPSUMMON_MANUAL_DESPAWN);
+                }
+                break;
+            case ACTION_DESTROY_WALL:
+                _summons.DespawnAll();
+                me->RemoveAurasDueToSpell(SPELL_ICE_WALL_DUMMY_1);
+                me->InterruptNonMeleeSpells(true);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void UpdateAI(uint32 /*diff*/) override { }
+
+private:
+    SummonList _summons;
+};
+
+// Magical tomes 59707, 66240, 59227 and the Arcane Bomb Chase 59711
+struct npc_magical_tomes : public ScriptedAI
+{
+    npc_magical_tomes(Creature* creature) : ScriptedAI(creature) { }
+
+    void IsSummonedBy(Unit* /*summoner*/) override
+    {
+        me->SetReactState(REACT_PASSIVE);
+        me->SetCanFly(true);
+        me->SetDisableGravity(true);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+        DoZoneInCombat();
+
+        switch (me->GetEntry())
+        {
+            case NPC_ANARCHIST_ARCANIST:
+                _events.ScheduleEvent(EVENT_ARCANE_BOMB, urand(1000, 3000));
+                me->GetMotionMaster()->MoveRandom(18.0f);
+                break;
+            case NPC_ANTONIDAS_GUIDE:
+                DoCast(me, SPELL_BURN, true);
+                me->GetMotionMaster()->MoveRandom(18.0f);
+                break;
+            case NPC_WANDERS_BOOK:
+                _events.ScheduleEvent(EVENT_SHADOW_BOLT, urand(1000, 3000));
+                me->GetMotionMaster()->MoveRandom(18.0f);
+                break;
+            case NPC_ARCANE_BOMB_CHASE:
+                // a slow orb that drops to the floor and explodes there
+                me->SetSpeedRate(MOVE_RUN, 0.4f);
+                me->SetSpeedRate(MOVE_WALK, 0.4f);
+                me->SetSpeedRate(MOVE_FLIGHT, 0.4f);
+                DoCast(me, SPELL_ARCANE_BOMB_COSMETIC_SPHERE, true);
+                if (Creature* mark = me->SummonCreature(NPC_ARCANE_BOMB, me->GetPositionX(), me->GetPositionY(), me->GetPositionZ() - 7.0f, 0.0f, TEMPSUMMON_TIMED_DESPAWN, 20000))
+                {
+                    mark->SetReactState(REACT_PASSIVE);
+                    mark->CastSpell(mark, SPELL_ARCANE_BOMB_COSMETIC, false);
+                    _mark = mark->GetGUID();
+                }
+                me->GetMotionMaster()->MovePoint(0, me->GetPositionX(), me->GetPositionY(), me->GetPositionZ() - 7.0f, false);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void DamageTaken(Unit* /*attacker*/, uint32& damage) override
+    {
+        damage = 0;
+    }
+
+    void AttackStart(Unit* /*who*/) override { }
+
+    void MovementInform(uint32 type, uint32 pointId) override
+    {
+        if (type != POINT_MOTION_TYPE || pointId != 0 || me->GetEntry() != NPC_ARCANE_BOMB_CHASE)
+            return;
+
+        DoCast(me, SPELL_ARCANE_BOMB, true);
+        if (Creature* mark = ObjectAccessor::GetCreature(*me, _mark))
+            mark->DespawnOrUnsummon();
+        me->DespawnOrUnsummon(500);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_ARCANE_BOMB:
+                    me->SummonCreature(NPC_ARCANE_BOMB_CHASE, me->GetPosition(), TEMPSUMMON_TIMED_DESPAWN, 30000);
+                    _events.ScheduleEvent(EVENT_ARCANE_BOMB, urand(4000, 6000));
+                    break;
+                case EVENT_SHADOW_BOLT:
+                    if (Player* target = SelectRandomPlayer(80.0f))
+                        me->CastSpell(target, SPELL_SHADOW_BOLT, false);
+                    _events.ScheduleEvent(EVENT_SHADOW_BOLT, urand(3000, 5000));
+                    break;
+                default:
+                    break;
+            }
+        }
+    }
+
+private:
+    Player* SelectRandomPlayer(float range)
+    {
+        std::list<Player*> players;
+        me->GetPlayerListInGrid(players, range);
+        players.remove_if([](Player* player) { return !player->IsAlive() || player->IsGameMaster(); });
+        if (players.empty())
+            return nullptr;
+
+        return Trinity::Containers::SelectRandomContainerElement(players);
+    }
+
+    EventMap _events;
+    ObjectGuid _mark;
+};
+
+// Wrack Soul 111631: when it fades it jumps to another player
+class spell_chillheart_wrack_soul : public AuraScript
+{
+    PrepareAuraScript(spell_chillheart_wrack_soul);
+
+    void OnRemove(AuraEffect const* /*aurEff*/, AuraEffectHandleModes /*mode*/)
+    {
+        if (GetTargetApplication()->GetRemoveMode() != AURA_REMOVE_BY_EXPIRE)
+            return;
+
+        Unit* caster = GetCaster();
+        if (!caster || !caster->IsAlive() || !caster->IsInCombat())
+            return;
+
+        std::list<Player*> players;
+        GetTarget()->GetPlayerListInGrid(players, 40.0f);
+        players.remove_if([this](Player* player) { return player == GetTarget() || !player->IsAlive() || player->IsGameMaster(); });
+        if (players.empty())
+            return;
+
+        caster->CastSpell(Trinity::Containers::SelectRandomContainerElement(players), SPELL_WRACK_SOUL, true);
+    }
+
+    void Register() override
+    {
+        OnEffectRemove += AuraEffectRemoveFn(spell_chillheart_wrack_soul::OnRemove, EFFECT_0, SPELL_AURA_PERIODIC_DAMAGE, AURA_EFFECT_HANDLE_REAL);
+    }
+};
+
+void AddSC_boss_instructor_chillheart()
+{
+    RegisterCreatureAI(boss_instructor_chillheart);
+    RegisterCreatureAI(npc_instructor_chillhearts_phylactery);
+    RegisterCreatureAI(npc_ice_wall_stalker);
+    RegisterCreatureAI(npc_magical_tomes);
+    RegisterAuraScript(spell_chillheart_wrack_soul);
+}
