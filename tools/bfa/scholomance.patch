+enum LilianSpells
+{
+    SPELL_SHADOW_SHIV           = 111775,
+    SPELL_DEATHS_GRASP          = 111570,
+    SPELL_DEATHS_GRASP_EFFECT   = 111573,
+    SPELL_DARK_BLAZE_DUMMY      = 111587,
+
+    // her soul
+    SPELL_UNLEASHED_ANGUISH     = 111649,
+    SPELL_FIXATE_ANGER          = 115350,
+};
+
+enum LilianEvents
+{
+    // fight
+    EVENT_SHADOW_SHIV           = 1,
+    EVENT_DEATHS_GRASP,
+    EVENT_DARK_BLAZE,
+    EVENT_SOUL_DISMISS,
+    EVENT_SUMMON_SOUL,
+
+    // story
+    EVENT_TALK_1                = 10,
+    EVENT_TALK_2,
+    EVENT_TALK_3,
+    EVENT_TALK_4,
+    EVENT_TALK_5,
+    EVENT_SPECIAL,
+    EVENT_INTRO_DONE,
+    EVENT_DIE_NECROMANCER,
+    EVENT_PURIFIED,
+
+    // soul
+    EVENT_FIXATE_ANGER          = 20,
+    EVENT_RESURRECT,
+};
+
+enum LilianTexts
+{
+    TALK_WONT_LET_YOU           = 0,  // I...won't let you...
+    TALK_CANT_FIGHT_HIM         = 1,  // I can't...fight him...
+    TALK_IT_BURNS               = 2,  // It burns...my soul...it burns!!!!
+    TALK_END_IT                 = 3,  // END IT! NOW! Before he can...
+    TALK_DIE_NECROMANCER        = 4,  // DIE, NECROMANCER!
+    TALK_SOUL_FADES_ANN         = 12, // Lilian's Soul fades into the spirit realm! It can no longer be harmed!
+
+    // Lilian's Soul
+    TALK_SOUL_FIXATE            = 0,
+};
+
+// her lines while Gandling taunts her at Rattlegore: voice only in this database
+uint32 const LilianIntroSounds[] = { 29469, 29470, 29471, 29472, 29475 };
+uint32 const LILIAN_SOUND_SHADOWSTEP = 29473;
+
+uint32 const FACTION_HOSTILE    = 14;
+uint32 const FACTION_FRIENDLY   = 35;
+
+// Lilian Voss 59200. She starts in Rattlegore's hall under Gandling's control, is sent to her
+// own room, fights the group there, loses her body at 50%, fights on beside her soul and finally
+// turns on Gandling.
+struct boss_lilian_voss : public BossAI
+{
+    boss_lilian_voss(Creature* creature) : BossAI(creature, DATA_LILIAN_VOSS), _ready(false), _soulPhase(false), _purified(false) { }
+
+    void InitializeAI() override
+    {
+        SetCombatMovement(false);
+        BossAI::InitializeAI();
+
+        // instance reloaded after Gandling's speech: she already waits in her room
+        if (instance && instance->GetBossState(DATA_JANDICE_BAROV) == DONE)
+            MoveToHerRoom();
+    }
+
+    void Reset() override
+    {
+        _Reset();
+        _soulPhase = false;
+        _purified = false;
+        me->setRegeneratingHealth(true);
+        me->SetStandState(UNIT_STAND_STATE_STAND);
+        me->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+
+        if (_ready)
+        {
+            me->SetFaction(FACTION_HOSTILE);
+            me->SetReactState(REACT_AGGRESSIVE);
+        }
+        else
+        {
+            me->SetFaction(FACTION_FRIENDLY);
+            me->SetReactState(REACT_PASSIVE);
+        }
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        if (!_ready)
+            return;
+
+        _JustEngagedWith();
+        Talk(TALK_CANT_FIGHT_HIM);
+        me->RemoveAurasDueToSpell(SPELL_COSMETIC_SOUL_RIP);
+        me->RemoveAurasDueToSpell(SPELL_LILIAN_KNEEL);
+        ScheduleTasks();
+    }
+
+    void ScheduleTasks() override
+    {
+        events.ScheduleEvent(EVENT_SHADOW_SHIV, urand(3500, 5000));
+        events.ScheduleEvent(EVENT_DEATHS_GRASP, 10000);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _JustDied();
+        RemoveSoul();
+    }
+
+    void EnterEvadeMode(EvadeReason why) override
+    {
+        if (!_ready || _purified)
+            return;
+
+        RemoveSoul();
+        BossAI::EnterEvadeMode(why);
+    }
+
+    void DoAction(int32 action) override
+    {
+        switch (action)
+        {
+            case ACTION_INTRO:
+                _storyEvents.ScheduleEvent(EVENT_TALK_1, 3000);
+                break;
+            case ACTION_DIFF_INTRO:
+                Talk(TALK_WONT_LET_YOU);
+                _storyEvents.ScheduleEvent(EVENT_INTRO_DONE, 6000);
+                break;
+            case ACTION_LILIAN_RESURRECTED:
+                me->RemoveAllAuras();
+                me->SetStandState(UNIT_STAND_STATE_STAND);
+                me->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+                me->SetReactState(REACT_AGGRESSIVE);
+                ScheduleTasks();
+                if (Player* player = me->SelectNearestPlayer(100.0f))
+                    AttackStart(player);
+                break;
+            default:
+                break;
+        }
+    }
+
+    void MovementInform(uint32 type, uint32 pointId) override
+    {
+        if (type == EFFECT_MOTION_TYPE && pointId == EVENT_JUMP)
+        {
+            DoCastAOE(SPELL_SHADOW_SHIV, true);
+            if (_purified)
+                _storyEvents.ScheduleEvent(EVENT_PURIFIED, 9000);
+            return;
+        }
+
+        if (type == POINT_MOTION_TYPE && pointId == 0)
+        {
+            // at Rattlegore's door she steps into the shadows
+            PlayVoiceLine(me, LILIAN_SOUND_SHADOWSTEP);
+            DoCast(me, SPELL_SHADOW_STEP_VISUAL, true);
+            _storyEvents.ScheduleEvent(EVENT_SPECIAL, 1500);
+        }
+    }
+
+    void DamageTaken(Unit* attacker, uint32& damage) override
+    {
+        if (_purified || !_ready)
+        {
+            damage = 0;
+            return;
+        }
+
+        uint32 realDamage = RealDamage(me, attacker, damage);
+
+        if (!_soulPhase && me->HealthBelowPctDamaged(50, realDamage))
+        {
+            // Gandling tears her soul out of her body
+            _soulPhase = true;
+            if (realDamage >= me->GetHealth())
+            {
+                damage = 0;
+                me->SetHealth(1);
+            }
+            events.Reset();
+            me->InterruptNonMeleeSpells(true);
+            me->AttackStop();
+            me->SetReactState(REACT_PASSIVE);
+            DoCast(me, SPELL_LILIAN_VOSS_DEAD, true);
+            me->GetMotionMaster()->MovePoint(1, LilianDeathPoint);
+            Talk(TALK_IT_BURNS);
+
+            if (Creature* gandling = instance->GetCreature(DATA_GRANDMASTER_GANDLING_INTRO))
+                gandling->AI()->DoAction(ACTION_DIFF_INTRO);
+
+            events.ScheduleEvent(EVENT_SOUL_DISMISS, 9000);
+            return;
+        }
+
+        if (_soulPhase && realDamage >= me->GetHealth())
+        {
+            // beaten, she breaks free and turns on Gandling
+            damage = 0;
+            _purified = true;
+            events.Reset();
+            me->InterruptNonMeleeSpells(true);
+            me->RemoveAllAuras();
+            me->AttackStop();
+            me->SetFaction(FACTION_FRIENDLY);
+            me->SetReactState(REACT_PASSIVE);
+            me->setRegeneratingHealth(false);
+            RemoveSoul();
+            Talk(TALK_DIE_NECROMANCER);
+            _storyEvents.ScheduleEvent(EVENT_DIE_NECROMANCER, 2500);
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _storyEvents.Update(diff);
+
+        while (uint32 eventId = _storyEvents.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_TALK_1:
+                    PlayVoiceLine(me, LilianIntroSounds[0]);
+                    _storyEvents.ScheduleEvent(EVENT_TALK_2, 10000);
+                    break;
+                case EVENT_TALK_2:
+                    PlayVoiceLine(me, LilianIntroSounds[1]);
+                    _storyEvents.ScheduleEvent(EVENT_TALK_3, 10000);
+                    break;
+                case EVENT_TALK_3:
+                    PlayVoiceLine(me, LilianIntroSounds[2]);
+                    _storyEvents.ScheduleEvent(EVENT_TALK_4, 10000);
+                    break;
+                case EVENT_TALK_4:
+                    PlayVoiceLine(me, LilianIntroSounds[3]);
+                    _storyEvents.ScheduleEvent(EVENT_TALK_5, 18000);
+                    break;
+                case EVENT_TALK_5:
+                    PlayVoiceLine(me, LilianIntroSounds[4]);
+                    me->CombatStop(true);
+                    me->SetReactState(REACT_PASSIVE);
+                    me->SetWalk(false);
+                    me->GetMotionMaster()->MovePoint(0, GandlingLilianDoorPoint);
+                    break;
+                case EVENT_SPECIAL:
+                    if (Creature* rattlegore = instance->GetCreature(DATA_RATTLEGORE))
+                        rattlegore->AI()->DoAction(ACTION_INTRO);
+                    MoveToHerRoom();
+                    break;
+                case EVENT_INTRO_DONE:
+                    me->SetFaction(FACTION_HOSTILE);
+                    me->SetReactState(REACT_AGGRESSIVE);
+                    if (Player* player = me->SelectNearestPlayer(60.0f))
+                        AttackStart(player);
+                    break;
+                case EVENT_DIE_NECROMANCER:
+                    if (Creature* gandling = instance->GetCreature(DATA_GRANDMASTER_GANDLING_INTRO))
+                    {
+                        me->GetMotionMaster()->MoveJump(gandling->GetPositionX(), gandling->GetPositionY(), 107.76f, me->GetOrientation(), 20.0f, 30.0f, EVENT_JUMP);
+                        gandling->AI()->DoAction(ACTION_REMOVE_LILIAN_SOUL);
+                    }
+                    else
+                        _storyEvents.ScheduleEvent(EVENT_PURIFIED, 3000);
+                    break;
+                case EVENT_PURIFIED:
+                    me->KillSelf();
+                    return;
+                default:
+                    break;
+            }
+        }
+
+        if (!UpdateVictim())
+            return;
+
+        events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_SHADOW_SHIV:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 50.0f, true))
+                        me->GetMotionMaster()->MoveJump(target->GetPositionX(), target->GetPositionY(), target->GetPositionZ(), me->GetOrientation(), 10.0f, 10.0f, EVENT_JUMP);
+                    events.ScheduleEvent(EVENT_SHADOW_SHIV, urand(16700, 20000));
+                    break;
+                case EVENT_DEATHS_GRASP:
+                    DoCast(me, SPELL_DEATHS_GRASP);
+                    events.ScheduleEvent(EVENT_DARK_BLAZE, 3500);
+                    events.ScheduleEvent(EVENT_DEATHS_GRASP, 40000);
+                    break;
+                case EVENT_DARK_BLAZE:
+                    // the floor where she pulled everyone in catches dark fire
+                    if (Creature* blaze = me->SummonCreature(NPC_DARK_BLAZE, me->GetPosition(), TEMPSUMMON_TIMED_DESPAWN, 30000))
+                    {
+                        blaze->SetFaction(FACTION_HOSTILE);
+                        blaze->SetReactState(REACT_PASSIVE);
+                        blaze->AddAura(SPELL_DARK_BLAZE_DUMMY, blaze);
+                    }
+                    break;
+                case EVENT_SOUL_DISMISS:
+                    Talk(TALK_END_IT);
+                    Talk(TALK_SOUL_FADES_ANN);
+                    me->AddUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+                    me->SetStandState(UNIT_STAND_STATE_DEAD);
+                    events.ScheduleEvent(EVENT_SUMMON_SOUL, 4000);
+                    break;
+                case EVENT_SUMMON_SOUL:
+                    me->SummonCreature(NPC_LILIAN_SOUL, me->GetPosition(), TEMPSUMMON_MANUAL_DESPAWN);
+                    break;
+                default:
+                    break;
+            }
+
+            if (me->HasUnitState(UNIT_STATE_CASTING))
+                return;
+        }
+
+        if (!_soulPhase || me->GetReactState() == REACT_AGGRESSIVE)
+            DoMeleeAttackIfReady();
+    }
+
+private:
+    void MoveToHerRoom()
+    {
+        _ready = true;
+        me->NearTeleportTo(LilianTeleportPos);
+        me->SetHomePosition(LilianTeleportPos);
+        DoCast(me, SPELL_LILIAN_KNEEL, true);
+        me->SetReactState(REACT_PASSIVE);
+
+        if (Creature* gandling = instance->GetCreature(DATA_GRANDMASTER_GANDLING_INTRO))
+            gandling->CastSpell(me, SPELL_COSMETIC_SOUL_RIP, false);
+    }
+
+    void RemoveSoul()
+    {
+        summons.DespawnEntry(NPC_LILIAN_SOUL);
+    }
+
+    EventMap _storyEvents;
+    bool _ready;
+    bool _soulPhase;
+    bool _purified;
+};
+
+// Lilian's Soul 58791: fixates on players; once "killed" it cannot be harmed any more and
+// raises Lilian's body to fight beside it
+struct npc_lilian_soul : public ScriptedAI
+{
+    npc_lilian_soul(Creature* creature) : ScriptedAI(creature), _instance(creature->GetInstanceScript()), _immortal(false) { }
+
+    void IsSummonedBy(Unit* /*summoner*/) override
+    {
+        DoZoneInCombat();
+        DoCast(me, SPELL_UNLEASHED_ANGUISH, true);
+        _events.ScheduleEvent(EVENT_FIXATE_ANGER, urand(4000, 5000));
+        if (Player* player = me->SelectNearestPlayer(100.0f))
+            AttackStart(player);
+    }
+
+    void DoAction(int32 action) override
+    {
+        if (action == ACTION_REMOVE_LILIAN_SOUL)
+            me->DespawnOrUnsummon();
+    }
+
+    void DamageTaken(Unit* attacker, uint32& damage) override
+    {
+        if (_immortal)
+        {
+            damage = 0;
+            return;
+        }
+
+        if (RealDamage(me, attacker, damage) < me->GetHealth())
+            return;
+
+        damage = 0;
+        _immortal = true;
+        _events.Reset();
+        me->RemoveAllAuras();
+        me->AttackStop();
+        me->SetReactState(REACT_PASSIVE);
+        me->AddUnitFlag(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_NON_ATTACKABLE));
+        me->GetMotionMaster()->MoveRandom(4.0f);
+        _events.ScheduleEvent(EVENT_RESURRECT, 5000);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        // should not happen (the soul turns immortal instead), but never leave Lilian lying there
+        if (!_immortal && _instance)
+            if (Creature* lilian = _instance->GetCreature(DATA_LILIAN_VOSS))
+                lilian->AI()->DoAction(ACTION_LILIAN_RESURRECTED);
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _events.Update(diff);
+
+        while (uint32 eventId = _events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_FIXATE_ANGER:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 50.0f, true))
+                    {
+                        me->GetThreatManager().AddThreat(target, 10000.0f);
+                        me->AddAura(SPELL_FIXATE_ANGER, target);
+                        Talk(TALK_SOUL_FIXATE, target);
+                    }
+                    _events.ScheduleEvent(EVENT_FIXATE_ANGER, 10000);
+                    break;
+                case EVENT_RESURRECT:
+                    me->SetFullHealth();
+                    me->GetMotionMaster()->Clear();
+                    me->SetReactState(REACT_AGGRESSIVE);
+                    if (_instance)
+                        if (Creature* lilian = _instance->GetCreature(DATA_LILIAN_VOSS))
+                            lilian->AI()->DoAction(ACTION_LILIAN_RESURRECTED);
+                    DoCast(me, SPELL_UNLEASHED_ANGUISH, true);
+                    if (Player* player = me->SelectNearestPlayer(100.0f))
+                    {
+                        AttackStart(player);
+                        me->GetMotionMaster()->MoveChase(player);
+                    }
+                    _events.ScheduleEvent(EVENT_FIXATE_ANGER, urand(4000, 5000));
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        if (!UpdateVictim())
+            return;
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    InstanceScript* _instance;
+    EventMap _events;
+    bool _immortal;
+};
+
+// Blazing Soul 111642: only burns players
+class spell_lilian_blazing_soul : public SpellScript
+{
+    PrepareSpellScript(spell_lilian_blazing_soul);
+
+    void FilterTargets(std::list<WorldObject*>& targets)
+    {
+        targets.remove_if([](WorldObject* target) { return target->GetTypeId() != TYPEID_PLAYER; });
+    }
+
+    void Register() override
+    {
+        OnObjectAreaTargetSelect += SpellObjectAreaTargetSelectFn(spell_lilian_blazing_soul::FilterTargets, EFFECT_0, TARGET_UNIT_SRC_AREA_ENEMY);
+    }
+};
+
+// Death's Grasp 111570: everyone hit is pulled to Lilian
+class spell_lilian_deaths_grasp : public SpellScript
+{
+    PrepareSpellScript(spell_lilian_deaths_grasp);
+
+    bool Validate(SpellInfo const* /*spellInfo*/) override
+    {
+        return ValidateSpellInfo({ SPELL_DEATHS_GRASP_EFFECT });
+    }
+
+    void HandleScript(SpellEffIndex effIndex)
+    {
+        PreventHitDefaultEffect(effIndex);
+        if (Unit* target = GetHitUnit())
+            target->CastSpell(GetCaster(), SPELL_DEATHS_GRASP_EFFECT, true);
+    }
+
+    void Register() override
+    {
+        OnEffectHitTarget += SpellEffectFn(spell_lilian_deaths_grasp::HandleScript, EFFECT_0, SPELL_EFFECT_SCRIPT_EFFECT);
+    }
+};
+
+void AddSC_boss_lilian_voss()
+{
+    RegisterCreatureAI(boss_lilian_voss);
+    RegisterCreatureAI(npc_lilian_soul);
+    RegisterSpellScript(spell_lilian_blazing_soul);
+    RegisterSpellScript(spell_lilian_deaths_grasp);
+}
