+ */
+
+#include "ScriptMgr.h"
+#include "ScriptedCreature.h"
+#include "Containers.h"
+#include "InstanceScript.h"
+#include "Map.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "SpellAuras.h"
+#include "SpellScript.h"
+#include "scholomance.h"
+
+enum RattlegoreSpells
+{
+    SPELL_RUSTING               = 113763,
+    SPELL_BONE_SPIKE            = 113999,
+    SPELL_SOULFLAME             = 114007,
+    SPELL_SOULFLAME_DAMAGE      = 114009,
+};
+
+enum RattlegoreEvents
+{
+    EVENT_SOULFLAME             = 1,
+    EVENT_BONE_SPIKE,
+    EVENT_REMOVE_SOULFLAME,
+
+    EVENT_CHECK_BONEWEAVER      = 10,
+    EVENT_REVEAL,
+};
+
+enum RattlegoreTexts
+{
+    TALK_SUMMONED               = 0, // RATTLEGORE!
+    TALK_BONE_PILE_ANN          = 1, // Click on a Bone Pile to protect yourself from Bone Spike!
+};
+
+uint32 const DISPLAY_INVISIBLE  = 11686;
+
+// Rattlegore 59153: rises from the bones once the Boneweavers are dead
+struct boss_rattlegore : public BossAI
+{
+    boss_rattlegore(Creature* creature) : BossAI(creature, DATA_RATTLEGORE), _revealed(false), _waiting(false) { }
+
+    void InitializeAI() override
+    {
+        BossAI::InitializeAI();
+
+        if (!_revealed)
+        {
+            me->SetDisplayId(DISPLAY_INVISIBLE);
+            me->SetReactState(REACT_PASSIVE);
+            me->AddUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+
+            // instance reloaded after Gandling's speech: wait for the Boneweavers straight away
+            if (instance && instance->GetBossState(DATA_JANDICE_BAROV) == DONE)
+                DoAction(ACTION_INTRO);
+        }
+    }
+
+    void Reset() override
+    {
+        _Reset();
+        me->setRegeneratingHealth(true);
+        if (_revealed)
+            me->SetReactState(REACT_AGGRESSIVE);
+
+        if (instance)
+            instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_BONE_ARMOR);
+
+        RemoveSoulflame();
+        ShowBonePiles(false);
+    }
+
+    void JustEngagedWith(Unit* /*who*/) override
+    {
+        _JustEngagedWith();
+        ShowBonePiles(true);
+        Talk(TALK_BONE_PILE_ANN);
+        DoCast(me, SPELL_RUSTING, true);
+        events.ScheduleEvent(EVENT_SOULFLAME, urand(3500, 6000));
+        events.ScheduleEvent(EVENT_BONE_SPIKE, 10000);
+    }
+
+    void JustDied(Unit* /*killer*/) override
+    {
+        _JustDied();
+        if (instance)
+            instance->DoRemoveAurasDueToSpellOnPlayers(SPELL_BONE_ARMOR);
+        ShowBonePiles(false);
+        RemoveSoulflame();
+    }
+
+    void EnterEvadeMode(EvadeReason why) override
+    {
+        if (!_revealed)
+            return;
+
+        RemoveSoulflame();
+        BossAI::EnterEvadeMode(why);
+    }
+
+    void DoAction(int32 action) override
+    {
+        if (action == ACTION_INTRO && !_revealed && !_waiting)
+        {
+            _waiting = true;
+            _introEvents.ScheduleEvent(EVENT_CHECK_BONEWEAVER, 1000);
+        }
+    }
+
+    void UpdateAI(uint32 diff) override
+    {
+        _introEvents.Update(diff);
+
+        while (uint32 eventId = _introEvents.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_CHECK_BONEWEAVER:
+                    if (me->FindNearestCreature(NPC_BONEWEAVER, 60.0f, true))
+                    {
+                        _introEvents.ScheduleEvent(EVENT_CHECK_BONEWEAVER, 500);
+                        break;
+                    }
+                    DoCast(me, SPELL_BONE_WHIRLWIND, true);
+                    DoCast(me, SPELL_BONE_STORM_COSMETIC, true);
+                    _introEvents.ScheduleEvent(EVENT_REVEAL, 5000);
+                    break;
+                case EVENT_REVEAL:
+                    _revealed = true;
+                    me->RemoveAllAuras();
+                    me->SetDisplayId(me->GetNativeDisplayId());
+                    me->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_NOT_SELECTABLE));
+                    me->SetReactState(REACT_AGGRESSIVE);
+                    Talk(TALK_SUMMONED);
+                    break;
+                default:
+                    break;
+            }
+        }
+
+        if (!_revealed || !UpdateVictim())
+            return;
+
+        events.Update(diff);
+
+        if (me->HasUnitState(UNIT_STATE_CASTING))
+            return;
+
+        while (uint32 eventId = events.ExecuteEvent())
+        {
+            switch (eventId)
+            {
+                case EVENT_SOULFLAME:
+                    IgniteSoulflames();
+                    events.ScheduleEvent(EVENT_REMOVE_SOULFLAME, 15000);
+                    events.ScheduleEvent(EVENT_SOULFLAME, urand(18000, 22000));
+                    break;
+                case EVENT_REMOVE_SOULFLAME:
+                    RemoveSoulflame();
+                    break;
+                case EVENT_BONE_SPIKE:
+                    if (Unit* target = SelectTarget(SELECT_TARGET_RANDOM, 0, 60.0f, true))
+                        DoCast(target, SPELL_BONE_SPIKE);
+                    events.ScheduleEvent(EVENT_BONE_SPIKE, 15000);
+                    break;
+                default:
+                    break;
+            }
+
+            if (me->HasUnitState(UNIT_STATE_CASTING))
+                return;
+        }
+
+        DoMeleeAttackIfReady();
+    }
+
+private:
+    void ShowBonePiles(bool show)
+    {
+        std::list<Creature*> bonePiles;
+        me->GetCreatureListWithEntryInGrid(bonePiles, NPC_BONE_PILE, 200.0f);
+        for (Creature* bonePile : bonePiles)
+            bonePile->SetVisible(show);
+    }
+
+    // two of the six braziers burst into soulflame for 15 seconds
+    void IgniteSoulflames()
+    {
+        RemoveSoulflame();
+
+        std::list<Creature*> braziers;
+        me->GetCreatureListWithEntryInGrid(braziers, NPC_SOULFLAME_ACTIVATED_STALKER, 150.0f);
+        if (braziers.empty())
+            return;
+
+        Trinity::Containers::RandomResize(braziers, 2);
+        for (Creature* brazier : braziers)
+        {
+            // the stalker template is shared and friendly; the flames have to hurt players
+            brazier->SetFaction(14);
+            brazier->SetReactState(REACT_PASSIVE);
+            brazier->AddAura(SPELL_SOULFLAME, brazier);
+            _soulflames.push_back(brazier->GetGUID());
+        }
+    }
+
+    void RemoveSoulflame()
+    {
+        for (ObjectGuid const& guid : _soulflames)
+            if (Creature* brazier = ObjectAccessor::GetCreature(*me, guid))
+            {
+                brazier->RemoveAurasDueToSpell(SPELL_SOULFLAME);
+                brazier->RestoreFaction();
+            }
+
+        _soulflames.clear();
+    }
+
+    EventMap _introEvents;
+    GuidVector _soulflames;
+    bool _revealed;
+    bool _waiting;
+};
+
+// Bone Spike 113999: a Bone Armor (from clicking a Bone Pile) absorbs one spike
+class spell_rattlegore_bone_spike : public SpellScript
+{
+    PrepareSpellScript(spell_rattlegore_bone_spike);
+
+    void HandleDamage(SpellEffIndex /*effIndex*/)
+    {
+        Unit* target = GetHitUnit();
+        if (target && target->HasAura(SPELL_BONE_ARMOR))
+        {
+            SetHitDamage(0);
+            target->RemoveAurasDueToSpell(SPELL_BONE_ARMOR);
+        }
+    }
+
+    void Register() override
+    {
+        OnEffectHitTarget += SpellEffectFn(spell_rattlegore_bone_spike::HandleDamage, EFFECT_0, SPELL_EFFECT_SCHOOL_DAMAGE);
+    }
+};
+
+// Soulflame 114009: burns players standing in the brazier's flames
+class spell_rattlegore_soulflame : public SpellScript
+{
+    PrepareSpellScript(spell_rattlegore_soulflame);
+
+    void SelectTargets(std::list<WorldObject*>& targets)
+    {
+        targets.clear();
+
+        Unit* caster = GetCaster();
+        float const maxDist = 2.7f + caster->GetObjectScale();
+
+        Map::PlayerList const& players = caster->GetMap()->GetPlayers();
+        for (Map::PlayerList::const_iterator itr = players.begin(); itr != players.end(); ++itr)
+            if (Player* player = itr->GetSource())
+                if (player->IsAlive() && !player->IsGameMaster() && player->GetExactDist2d(caster) <= maxDist)
+                    targets.push_back(player);
+    }
+
+    void Register() override
+    {
+        OnObjectAreaTargetSelect += SpellObjectAreaTargetSelectFn(spell_rattlegore_soulflame::SelectTargets, EFFECT_0, TARGET_UNIT_SRC_AREA_ENEMY);
+    }
+};
+
+void AddSC_boss_rattlegore()
+{
+    RegisterCreatureAI(boss_rattlegore);
+    RegisterSpellScript(spell_rattlegore_bone_spike);
+    RegisterSpellScript(spell_rattlegore_soulflame);
+}
