diff --git a/src/server/game/Handlers/ChatHandler.cpp b/src/server/game/Handlers/ChatHandler.cpp
index 9a0593b..1e9044b 100644
--- a/src/server/game/Handlers/ChatHandler.cpp
+++ b/src/server/game/Handlers/ChatHandler.cpp
@@ -97,6 +97,26 @@ void WorldSession::HandleChatMessage(ChatMsg type, uint32 lang, std::string msg,
 {
     Player* sender = GetPlayer();
 
+    // zrbfacore: the WoW Circle client polls the server with chat commands of its own:
+    // its built-in ticket UI sends ".ticket CUticketGet" and its addon loader ".addon load".
+    // HavenCore has no such commands, so for a player ParseCommands fails and the text was
+    // broadcast as chat (guild, say, ...). Drop these silently. The text is matched anywhere in
+    // the message, because a plain prefix check at the start of the message missed some of them.
+    if (msg.find("ticket CU") != std::string::npos || msg.find("addon load") != std::string::npos)
+    {
+        // log the first few with their bytes, to see exactly what the client sends
+        static std::atomic<uint32> loggedPolls(0);
+        if (loggedPolls++ < 5)
+        {
+            std::string hex;
+            for (unsigned char c : msg)
+                hex += Trinity::StringFormat("%02X ", uint32(c));
+            TC_LOG_INFO("server.worldserver", "zrbfacore: dropped client poll (chat type %u, lang %u) from %s: '%s' [%s]",
+                uint32(type), lang, GetPlayerInfo().c_str(), msg.c_str(), hex.c_str());
+        }
+        return;
+    }
+
     if (lang == LANG_UNIVERSAL && type != CHAT_MSG_EMOTE)
     {
         TC_LOG_ERROR("entities.player.cheat", "CMSG_MESSAGECHAT: Possible hacking-attempt: %s tried to send a message in universal language", GetPlayerInfo().c_str());
