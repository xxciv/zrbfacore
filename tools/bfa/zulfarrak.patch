+        static void HidePyramidBoss(Creature* creature, bool hide)
+        {
+            creature->SetVisible(!hide);
+            creature->SetReactState(hide ? REACT_PASSIVE : REACT_AGGRESSIVE);
+            if (hide)
+                creature->AddUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_IMMUNE_TO_PC));
+            else
+                creature->RemoveUnitFlag(UnitFlags(UNIT_FLAG_NON_ATTACKABLE | UNIT_FLAG_IMMUNE_TO_PC));
+        }
+
+        void SendScenarioEvent(uint32 eventId)
+        {
+            InstanceMap* map = instance->ToInstanceMap();
+            InstanceScenario* scenario = map ? map->GetInstanceScenario() : nullptr;
+            if (!scenario)
+                return;
+
+            // once: the scenario's progress is shared by the whole group
+            Map::PlayerList const& players = instance->GetPlayers();
+            for (Map::PlayerList::const_iterator itr = players.begin(); itr != players.end(); ++itr)
+                if (Player* player = itr->GetSource())
+                {
+                    scenario->SendScenarioEvent(player, eventId);
+                    return;
+                }
+        }
