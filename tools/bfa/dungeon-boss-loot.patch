+bool Scenario::HasKillCriteria(uint32 creatureEntry) const
+{
+    if (!_data)
+        return false;
+
+    bool found = false;
+    for (auto const& stepPair : _data->Steps)
+    {
+        CriteriaTree const* stepTree = sCriteriaMgr->GetCriteriaTree(stepPair.second->Criteriatreeid);
+        if (!stepTree)
+            continue;
+
+        // "Lady Anacondra defeated": a kill criteria needed once. Counted kills ("Defeat 20 ...") are trash.
+        CriteriaMgr::WalkCriteriaTree(stepTree, [&](CriteriaTree const* tree)
+        {
+            if (tree->Criteria && tree->Criteria->Entry->Type == CRITERIA_TYPE_KILL_CREATURE &&
+                uint32(tree->Criteria->Entry->Asset.CreatureID) == creatureEntry && tree->Entry->Amount <= 1)
+                found = true;
+        });
+
+        if (found)
+            return true;
+    }
+
+    return false;
+}
