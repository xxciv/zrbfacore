+                    break;
+                }
+                instance->SetData(DATA_LAYOUT, layout == LAYOUT_CLASSIC ? LAYOUT_REDESIGN : LAYOUT_CLASSIC);
+                handler.PSendSysMessage("The deeps shift. This is now the %s Blackfathom Deeps.", LayoutName(instance->GetData(DATA_LAYOUT)));
+                break;
+            default:
+                break;
+        }
+        return true;
+    }
+};
