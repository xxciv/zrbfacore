@@ -1547,6 +1547,26 @@ void Spell::DoCreateItem(uint32 /*i*/, uint32 itemtype, ItemContext context /*=
 
         // we succeeded in creating at least one item, so a levelup is possible
         player->UpdateCraftSkill(m_spellInfo->Id);
+
+        // zrbfacore: guild crafting achievements (Mix Master, Better Leveling Through
+        // Chemistry, Master Crafter, Set the Oven to "Cataclysmic") were never credited.
+        // Their modifier trees filter by the created item (class, quality, item level).
+        if (player->GetGuildId())
+        {
+            SkillLineAbilityMapBounds bounds = sSpellMgr->GetSkillLineAbilityMapBounds(m_spellInfo->Id);
+            for (SkillLineAbilityMap::const_iterator itr = bounds.first; itr != bounds.second; ++itr)
+            {
+                SkillLineEntry const* skill = sSkillLineStore.LookupEntry(itr->second->SkillLine);
+                if (!skill)
