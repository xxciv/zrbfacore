+// zrbfacore: guild reputation (faction 1168). Retail grants it to guild members for
+// every quest turned in that is not gray to them (1 reputation per 360 guild
+// experience, 60,000 guild experience per quest = ~167 before bonuses such as the
+// Guild Champion tabards). HavenCore never granted any, so the guild vendor
+// reputation locks could not be earned. Base amount: Guild.QuestReputation.
+static constexpr uint32 GUILD_REPUTATION_FACTION_ID = 1168;
+
+static void RewardGuildReputationForQuest(Player* player, Quest const* quest)
+{
+    if (!player->GetGuildId())
+        return;
+
+    int32 baseRep = sConfigMgr->GetIntDefault("Guild.QuestReputation", 167);
+    if (baseRep <= 0)
+        return;
+
+    int32 questLevel = player->GetQuestLevel(quest);
+    if (questLevel <= 0)
+        questLevel = player->getLevel();
+    if (questLevel <= int32(Trinity::XP::GetGrayLevel(player->getLevel())))
+        return;                                             // gray quests give nothing
+
+    FactionEntry const* guildFaction = sFactionStore.LookupEntry(GUILD_REPUTATION_FACTION_ID);
+    if (!guildFaction)
+        return;
+
+    int32 rep = player->CalculateReputationGain(REPUTATION_SOURCE_QUEST, questLevel, baseRep, GUILD_REPUTATION_FACTION_ID);
+    if (rep > 0)
+        player->GetReputationMgr().ModifyReputation(guildFaction, rep);
+}
