+// Camp Narache battle: Fledgling Braves 36942 fight Bristleback Invaders 36943 forever (NPC hits
+// stop at 80% health). A player who attacks an invader takes it over: the invader drops the
+// braves and fights only that player, the braves move on to other invaders, and NPC hits no
+// longer touch it.
+namespace CampNaracheBattle
+{
+    enum
+    {
+        NPC_BRISTLEBACK_INVADER = 36943
+    };
+
+    // A player, or a pet / guardian / charmed unit a player controls.
+    bool IsPlayerSide(Unit const* unit)
+    {
+        return unit && unit->GetCharmerOrOwnerPlayerOrPlayerItself();
+    }
+
+    // A creature that is fighting a player (or a player's pet).
+    bool IsTakenByPlayer(Unit const* unit)
+    {
+        return unit && unit->GetTypeId() == TYPEID_UNIT && IsPlayerSide(unit->GetVictim());
+    }
+
+    // NPC damage stops at 80% health. It never raises health: the old code set the health back
+    // up to 80%, so a brave's hit healed an invader a player had already brought lower.
+    void CapNpcDamage(Creature* me, uint32& damage)
+    {
+        uint64 minimumHealth = me->CountPctFromMaxHealth(80);
+        uint64 health = me->GetHealth();
+        if (health <= minimumHealth)
+            damage = 0;
+        else if (damage > health - minimumHealth)
+            damage = uint32(health - minimumHealth);
+    }
+}
