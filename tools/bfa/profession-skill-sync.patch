+// The parent profession skill (Herbalism, Mining, Skinning, ...) is what the client checks gathering nodes
+// against and what the skinning cast check reads. Keep it at the highest of its expansion skills, so learning
+// or raising a lower one (Cataclysm Skinning 1) doesn't drag it below the one the player actually uses.
+static void SyncParentProfessionSkill(Player* player, uint32 parentSkillId)
+{
+    std::vector<SkillLineEntry const*> const* childSkillLines = sDB2Manager.GetSkillLinesForParentSkill(parentSkillId);
+    if (!childSkillLines)
+        return;
+
+    SkillLineEntry const* best = nullptr;
+    uint16 bestValue = 0;
+    for (SkillLineEntry const* childSkillLine : *childSkillLines)
+    {
+        if (childSkillLine->ParentTierIndex <= 0)
+            continue;
+
+        uint16 value = player->GetPureSkillValue(childSkillLine->ID);
+        if (value > bestValue)
+        {
+            best = childSkillLine;
+            bestValue = value;
+        }
+    }
+
+    if (!best)
+        return;
+
+    uint16 bestMax = player->GetPureMaxSkillValue(best->ID);
+    if (player->GetPureSkillValue(parentSkillId) != bestValue ||
+        player->GetPureMaxSkillValue(parentSkillId) != bestMax ||
+        player->GetSkillStep(parentSkillId) != best->ParentTierIndex)
+        player->SetSkill(parentSkillId, best->ParentTierIndex, bestValue, bestMax);
+}
