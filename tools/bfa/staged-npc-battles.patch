diff --git a/src/server/game/Entities/Unit/Unit.cpp b/src/server/game/Entities/Unit/Unit.cpp
index cc154e8..86b1d7e 100644
--- a/src/server/game/Entities/Unit/Unit.cpp
+++ b/src/server/game/Entities/Unit/Unit.cpp
@@ -733,6 +733,24 @@ uint32 Unit::DealDamage(Unit* victim, uint32 damage, CleanDamage const* cleanDam
     // Hook for OnDamage Event
     sScriptMgr->OnDamage(this, victim, damage, spellProto);
 
+    // Staged NPC battles (Sentinel Hill, Ruins of Gilneas, ...): a creature flagged
+    // CREATURE_FLAG_EXTRA_NO_NPC_DAMAGE_BELOW_85PCT takes no damage from other creatures below 85%
+    // health, so the two sides fight on forever. Players and their pets, totems and guardians deal
+    // full damage.
+    if (Creature* victimCreature = victim->ToCreature())
+    {
+        if (damage && victimCreature != this && !GetCharmerOrOwnerPlayerOrPlayerItself() &&
+            (victimCreature->GetCreatureTemplate()->flags_extra & CREATURE_FLAG_EXTRA_NO_NPC_DAMAGE_BELOW_85PCT))
+        {
+            uint64 minimumHealth = victimCreature->CountPctFromMaxHealth(85);
+            uint64 health = victimCreature->GetHealth();
+            if (health <= minimumHealth)
+                damage = 0;
+            else if (damage > health - minimumHealth)
+                damage = uint32(health - minimumHealth);
+        }
+    }
+
     if (victim->IsPlayer() && this != victim)
     {
         // Signal to pets that their owner was attacked - except when DOT.
