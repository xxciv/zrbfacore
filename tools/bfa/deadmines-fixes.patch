+// 91032 - Drunken Haze (Mine Bunny)
+// The 10 s snare and slow stay. Its Inebriate effect set the player's drunk
+// value to 100, which is stored on the character and only sobers by 1 every
+// 9 s, so the player stayed smashed for about 15 minutes after the fight.
+class spell_dm_drunken_haze : public SpellScriptLoader
+{
+public:
+    spell_dm_drunken_haze() : SpellScriptLoader("spell_dm_drunken_haze") { }
+
+    class spell_dm_drunken_haze_SpellScript : public SpellScript
+    {
+        PrepareSpellScript(spell_dm_drunken_haze_SpellScript);
+
+        void PreventInebriate(SpellEffIndex effIndex)
+        {
+            PreventHitDefaultEffect(effIndex);
+        }
+
+        void Register() override
+        {
+            OnEffectHitTarget += SpellEffectFn(spell_dm_drunken_haze_SpellScript::PreventInebriate, EFFECT_ALL, SPELL_EFFECT_INEBRIATE);
+        }
+    };
+
+    SpellScript* GetSpellScript() const override
+    {
+        return new spell_dm_drunken_haze_SpellScript();
+    }
+};
