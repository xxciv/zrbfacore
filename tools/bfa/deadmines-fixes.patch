+++ b/src/server/scripts/EasternKingdoms/Deadmines/instance_deadmines.cpp
@@ -194,19 +194,29 @@ public:
 
         void OnGameObjectCreate(GameObject* go) override
         {
+            // Boss states survive a restart or grid unload, but doors are
+            // re-created closed. Open them again for bosses already killed.
             switch (go->GetEntry())
             {
                 case GO_FACTORY_DOOR: // Door after first boss
                     FactoryDoorGUID = go->GetGUID();
+                    if (GetBossState(DATA_GLUBTOK) == DONE)
+                        go->SetGoState(GO_STATE_ACTIVE);
                     break;
                 case GO_FOUNDRY_DOOR: // Door before ship
                     FoundaryDoorGUID = go->GetGUID();
+                    if (GetBossState(DATA_FOEREAPER) == DONE)
+                        go->SetGoState(GO_STATE_ACTIVE);
                     break;
                 case GO_HEAVY_DOOR_HELIX:
                     HeavyDoorGUID = go->GetGUID();
+                    if (GetBossState(DATA_HELIX) == DONE)
+                        go->SetGoState(GO_STATE_ACTIVE);
                     break;
                 case GO_IRONCLAD_DOOR:
                     IroncladDoorGUID = go->GetGUID();
+                    if (GetBossState(DATA_RIPSNARL) == DONE)
+                        go->SetGoState(GO_STATE_ACTIVE_ALTERNATIVE);
                     break;
             }
         }
