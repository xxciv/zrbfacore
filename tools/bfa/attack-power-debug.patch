+    // zrbfacore: .debug attackpower [spellId]
+    // Prints your attack power fields and the totals the server uses. With a spell id and a
+    // selected target, also prints how each attack power based damage effect of that spell is
+    // computed (coefficient after spell mods, percent done modifier, damage before the target's
+    // own modifiers, armor and crit).
+    static bool HandleDebugAttackPowerCommand(ChatHandler* handler, char const* args)
+    {
+        Player* player = handler->GetSession()->GetPlayer();
+        if (!player)
+            return false;
+
+        UF::UnitData const& data = *player->m_unitData;
+        handler->PSendSysMessage("AttackPower %d, ModPos %d, ModNeg %d, Multiplier %.3f",
+            int32(data.AttackPower), int32(data.AttackPowerModPos), int32(data.AttackPowerModNeg), float(data.AttackPowerMultiplier));
+        handler->PSendSysMessage("RangedAttackPower %d, ModPos %d, ModNeg %d, Multiplier %.3f",
+            int32(data.RangedAttackPower), int32(data.RangedAttackPowerModPos), int32(data.RangedAttackPowerModNeg), float(data.RangedAttackPowerMultiplier));
+        handler->PSendSysMessage("Weapon attack power: main hand %d, off hand %d, ranged %d",
+            int32(data.MainHandWeaponAttackPower), int32(data.OffHandWeaponAttackPower), int32(data.RangedWeaponAttackPower));
+        handler->PSendSysMessage("Total attack power: main hand %.1f, off hand %.1f, ranged %.1f (white hits use %.1f)",
+            player->GetTotalAttackPowerValue(BASE_ATTACK), player->GetTotalAttackPowerValue(OFF_ATTACK),
+            player->GetTotalAttackPowerValue(RANGED_ATTACK), player->GetTotalAttackPowerValue(BASE_ATTACK, false));
+        handler->PSendSysMessage("Main hand weapon damage %.1f - %.1f",
+            player->GetWeaponDamageRange(BASE_ATTACK, MINDAMAGE), player->GetWeaponDamageRange(BASE_ATTACK, MAXDAMAGE));
+
+        Unit* target = handler->getSelectedUnit();
+        if (target && target != player)
+        {
+            std::ostringstream auras;
+            for (auto const& app : target->GetAppliedAuras())
+                auras << ' ' << app.first;
+            handler->PSendSysMessage("Target %s level %u, armor %u, health %u/%u, auras:%s",
+                target->GetName().c_str(), uint32(target->getLevel()), target->GetArmor(), uint32(target->GetHealth()), uint32(target->GetMaxHealth()),
+                auras.str().empty() ? " none" : auras.str().c_str());
+            handler->PSendSysMessage("Multipliers: your damage x%.3f, target health x%.3f, target armor x%.3f, 100 physical after armor %u",
+                player->GetDamageMultiplierForTarget(target), target->GetHealthMultiplierForTarget(player),
+                target->GetArmorMultiplierForTarget(player), player->CalcArmorReducedDamage(player, target, 100, nullptr, BASE_ATTACK));
+            uint32 meleeDone = player->MeleeDamageBonusDone(target, 100, BASE_ATTACK);
+            uint32 meleeTaken = target->MeleeDamageBonusTaken(player, meleeDone, BASE_ATTACK);
+            handler->PSendSysMessage("A 100 damage main hand hit: after your bonuses %u, after target's %u, after armor %u",
+                meleeDone, meleeTaken, player->CalcArmorReducedDamage(player, target, meleeTaken, nullptr, BASE_ATTACK));
+        }
+
+        if (!*args)
+            return true;
+
+        uint32 spellId = handler->extractSpellIdFromLink((char*)args);
+        SpellInfo const* spellInfo = sSpellMgr->GetSpellInfo(spellId);
+        if (!spellInfo)
+        {
+            handler->PSendSysMessage("Spell %u not found.", spellId);
+            return true;
+        }
+
+        if (!target || target == player)
+        {
+            handler->SendSysMessage("Select a target to see the spell's damage against it.");
+            return true;
+        }
+
+        for (SpellEffectInfo const* effect : spellInfo->GetEffectsForDifficulty(DIFFICULTY_NONE))
+        {
+            if (!effect || effect->BonusCoefficientFromAP <= 0.0f)
+                continue;
+
+            float coeff = effect->BonusCoefficientFromAP * 100.0f;
+            player->ApplySpellMod(spellInfo->Id, SPELLMOD_BONUS_MULTIPLIER, coeff);
+            float pctDone = player->SpellDamagePctDone(target, spellInfo, SPELL_DIRECT_DAMAGE);
+            float flatDamage = 100.0f;
+            player->ApplySpellMod(spellInfo->Id, SPELLMOD_DAMAGE, flatDamage);
+            uint32 done = player->SpellDamageBonusDone(target, spellInfo, 0, SPELL_DIRECT_DAMAGE, effect);
+            uint32 taken = target->SpellDamageBonusTaken(player, spellInfo, done, SPELL_DIRECT_DAMAGE, effect);
+            uint32 armored = player->IsDamageReducedByArmor(spellInfo->GetSchoolMask(), spellInfo) ? player->CalcArmorReducedDamage(player, target, taken, spellInfo, BASE_ATTACK) : taken;
+            handler->PSendSysMessage("%s effect %u: AP coefficient %.4f, after spell mods %.4f, percent done x%.3f, damage spell mods x%.3f, damage done %u",
+                spellInfo->SpellName->Str[handler->GetSessionDbcLocale()], effect->EffectIndex, effect->BonusCoefficientFromAP,
+                coeff / 100.0f, pctDone, flatDamage / 100.0f, done);
+            handler->PSendSysMessage("%s effect %u: after target's modifiers %u, after armor %u, after damage multiplier %u",
+                spellInfo->SpellName->Str[handler->GetSessionDbcLocale()], effect->EffectIndex, taken, armored,
+                uint32(armored * player->GetDamageMultiplierForTarget(target)));
+        }
+        return true;
+    }
 };
 
