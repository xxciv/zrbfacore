@@ -61,15 +99,121 @@ public:
     {
         instance_dire_maul_InstanceMapScript(InstanceMap* map) : InstanceScript(map)
         {
+            SetHeaders(DataHeader);
             SetBossNumber(EncounterCount);
+            _generatorsOff = 0;
+        }
+
+        void OnCreatureCreate(Creature* creature) override
+        {
+            InstanceScript::OnCreatureCreate(creature);
+
+            if (creature->GetEntry() == NPC_IMMOLTHAR)
+            {
+                _immoltharGUID = creature->GetGUID();
+                if (_generatorsOff == AllGeneratorsOff)
+                    creature->RemoveUnitFlag(UNIT_FLAG_NON_ATTACKABLE);
+                else
+                    creature->AddUnitFlag(UNIT_FLAG_NON_ATTACKABLE);
+            }
+        }
+
+        void OnGameObjectCreate(GameObject* go) override
+        {
+            InstanceScript::OnGameObjectCreate(go);
+
+            if (go->GetEntry() == GO_FORCE_FIELD)
+            {
+                _forceFieldGUID = go->GetGUID();
+                go->SetGoState(_generatorsOff == AllGeneratorsOff ? GO_STATE_ACTIVE : GO_STATE_READY);
+                return;
+            }
+
+            for (uint8 i = 0; i < ShieldGeneratorCount; ++i)
+            {
+                if (go->GetEntry() != GeneratorEntries[i])
+                    continue;
+
+                _generatorGUIDs[i] = go->GetGUID();
+                // READY = running (beam to the force field), ACTIVE = shut down
+                go->SetGoState((_generatorsOff & (1 << i)) ? GO_STATE_ACTIVE : GO_STATE_READY);
+                return;
+            }
         }
+
+        void OnUnitDeath(Unit* unit) override
+        {
+            Creature* creature = unit->ToCreature();
+            if (!creature || !IsGeneratorGuard(creature->GetEntry()))
+                return;
+
+            int8 index = GetGeneratorIndexForGuard(creature);
+            if (index < 0 || (_generatorsOff & (1 << index)))
+                return;
+
+            // Any guard of this generator still alive?
+            for (uint32 entry : { uint32(NPC_ARCANE_ABERRATION), uint32(NPC_MANA_REMNANT) })
+            {
+                std::list<Creature*> guards;
+                creature->GetCreatureListWithEntryInGrid(guards, entry, 250.0f);
+                for (Creature* guard : guards)
+                    if (guard != creature && guard->IsAlive() && GetGeneratorIndexForGuard(guard) == index)
+                        return;
+            }
+
+            ShutDownGenerator(uint8(index));
+        }
+
+        void ShutDownGenerator(uint8 index)
+        {
+            _generatorsOff |= (1 << index);
+
+            if (GameObject* generator = instance->GetGameObject(_generatorGUIDs[index]))
+                generator->SetGoState(GO_STATE_ACTIVE);
+
+            DoSendEventScenario(EVENT_SHIELD_GENERATOR_OFF);
+
+            if (_generatorsOff == AllGeneratorsOff)
+            {
+                if (GameObject* forceField = instance->GetGameObject(_forceFieldGUID))
+                    forceField->SetGoState(GO_STATE_ACTIVE);
+
+                if (Creature* immolthar = instance->GetCreature(_immoltharGUID))
+                    immolthar->RemoveUnitFlag(UNIT_FLAG_NON_ATTACKABLE);
+            }
+
+            SaveToDB();
+        }
+
+        uint32 GetData(uint32 type) const override
+        {
+            if (type == DATA_SHIELD_GENERATORS)
+                return _generatorsOff;
+            return 0;
+        }
+
+        void ReadSaveDataMore(std::istringstream& data) override
+        {
+            data >> _generatorsOff;
+            _generatorsOff &= AllGeneratorsOff;
+        }
+
+        void WriteSaveDataMore(std::ostringstream& data) override
+        {
+            data << _generatorsOff;
+        }
+
+    private:
+        uint32 _generatorsOff;
+        ObjectGuid _generatorGUIDs[ShieldGeneratorCount];
+        ObjectGuid _forceFieldGUID;
+        ObjectGuid _immoltharGUID;
     };
 
