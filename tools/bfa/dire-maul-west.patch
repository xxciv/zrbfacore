+    // Generator spawn points; a guard belongs to the generator nearest to its home position
+    Position const GeneratorPos[ShieldGeneratorCount] =
+    {
+        {  12.9413f, 277.931f,  -8.9329f },
+        { -92.3456f, 442.670f,  28.5470f },
+        { 121.2220f, 429.092f,  28.4548f },
