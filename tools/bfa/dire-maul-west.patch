+    };
+
+    float const GuardRange = 40.0f;      // guards stand within 17 yards of their generator; generators are 160+ yards apart
+    uint32 const AllGeneratorsOff = (1 << ShieldGeneratorCount) - 1;
+
+    bool IsGeneratorGuard(uint32 entry)
+    {
+        return entry == NPC_ARCANE_ABERRATION || entry == NPC_MANA_REMNANT;
+    }
+
+    int8 GetGeneratorIndexForGuard(Creature const* creature)
+    {
+        Position const& home = creature->GetHomePosition();
+        for (uint8 i = 0; i < ShieldGeneratorCount; ++i)
