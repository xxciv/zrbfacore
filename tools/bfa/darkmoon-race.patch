+/*
+ * zrbfacore: Darkmoon Carousel rides.
+ *
+ * The platform (gameobject 216666) is a client-animated transport: the client
+ * spins it one full turn clockwise every 12 seconds (TransportRotation.db2),
+ * but this core has no passengers for that kind of transport, so the five
+ * rides (Dragon 68231, Gryphon 68232, Murloc 68233, Rocket 68238, Wyvern
+ * 68239) used to stand still while the floor turned under them. Each ride now
+ * circles the pole at the platform's speed on a cyclic spline, keeping its
+ * spawn radius and its place in the ring, and faces the way the carousel
+ * turns. Players on a ride are vehicle passengers, so they turn with it and
+ * can leave with the Leave Vehicle button (the seats allow exit). Riding
+ * starts Whee! (46668), which spell_darkmoon_carousel_whee keeps topping up.
+ */
+namespace DarkmoonCarousel
+{
+    float const CENTER_X = -4031.01f;            // platform spawn 1270005
+    float const CENTER_Y = 6352.32f;
+    uint32 const TURN_MS = 12000;                 // one clockwise turn
+    uint8 const STEPS = 36;
+    uint32 const RESYNC_MS = 5 * MINUTE * IN_MILLISECONDS;
+    uint32 const SPELL_CAROUSEL_WHEE = 46668;
+    uint32 const MAP_DARKMOON_ISLAND = 974;
+    float const MAX_RADIUS = 15.0f;
+
+    // Angle the platform has turned through, from the shared game clock, so
+    // every ride keeps the same place in the ring.
+    float PlatformAngle()
+    {
+        return -2.0f * float(M_PI) * float(GameTime::GetGameTimeMS() % TURN_MS) / float(TURN_MS);
+    }
+
+    struct npc_darkmoon_carousel_ride : public ScriptedAI
+    {
+        npc_darkmoon_carousel_ride(Creature* creature) : ScriptedAI(creature)
+        {
+            Position const& home = creature->GetHomePosition();
+            float dx = home.GetPositionX() - CENTER_X;
+            float dy = home.GetPositionY() - CENTER_Y;
+            _radius = std::sqrt(dx * dx + dy * dy);
+            _baseAngle = std::atan2(dy, dx);
+            _z = home.GetPositionZ();
+        }
+
+        void Reset() override
+        {
+            _placed = false;
+            _resyncTimer = 0;
+        }
+
+        Position RingPoint(float angle) const
+        {
+            // Facing the way a clockwise ring travels: a quarter turn back.
+            return Position(CENTER_X + _radius * std::cos(angle), CENTER_Y + _radius * std::sin(angle), _z,
+                Position::NormalizeOrientation(angle - float(M_PI) / 2.0f));
+        }
+
+        void Spin()
+        {
+            float angle = _baseAngle + PlatformAngle();
+            float step = 2.0f * float(M_PI) / STEPS;
+
+            Movement::MoveSplineInit init(me);
+            float length = 0.0f;
+            G3D::Vector3 last;
+            for (uint8 i = 0; i < STEPS; ++i)
+            {
+                Position p = RingPoint(angle - step * i);
+                G3D::Vector3 point(p.GetPositionX(), p.GetPositionY(), p.GetPositionZ());
+                if (i)
+                    length += (point - last).length();
+                init.Path().push_back(point);
+                last = point;
+            }
+            length += (init.Path().front() - last).length();
+
+            init.SetCyclic();
+            init.SetWalk(true);
+            init.SetVelocity(length * 1000.0f / float(TURN_MS));
+            init.Launch();
+        }
+
+        void UpdateAI(uint32 diff) override
+        {
+            // Only the carousel on Darkmoon Island; other copies stay put.
+            if (me->GetMapId() != MAP_DARKMOON_ISLAND || _radius > MAX_RADIUS)
+                return;
+
+            if (!_placed)
+            {
+                // Start on the ring where the platform has carried this ride.
+                _placed = true;
+                me->NearTeleportTo(RingPoint(_baseAngle + PlatformAngle()));
+                _resyncTimer = 500;
+                return;
+            }
+
+            if (_resyncTimer <= diff)
+            {
+                Spin();
+                _resyncTimer = RESYNC_MS;
+            }
+            else
+                _resyncTimer -= diff;
+        }
+
+        void PassengerBoarded(Unit* passenger, int8 /*seatId*/, bool apply) override
+        {
+            if (apply && passenger->GetTypeId() == TYPEID_PLAYER)
+                passenger->CastSpell(passenger, SPELL_CAROUSEL_WHEE, true);
+        }
+
+        // Rides never fight and never go home.
+        void EnterEvadeMode(EvadeReason /*why*/) override { }
+
+    private:
+        float _radius = 0.0f;
+        float _baseAngle = 0.0f;
+        float _z = 0.0f;
+        bool _placed = false;
+        uint32 _resyncTimer = 0;
+    };
+}
