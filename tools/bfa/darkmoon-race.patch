+    Creature* NearestStake(Creature* stake)
+    {
+        std::list<Creature*> stakes;
+        stake->GetCreatureListWithEntryInGrid(stakes, NPC_TRIPWIRE_STAKE, TRIPWIRE_SPAN);
+        Creature* nearest = nullptr;
+        for (Creature* other : stakes)
+            if (other != stake && (!nearest || stake->GetExactDist2d(other) < stake->GetExactDist2d(nearest)))
+                nearest = other;
+        return nearest;
+    }
+
+    float Dist2d(Position const& a, float x, float y)
+    {
+        return std::sqrt((a.GetPositionX() - x) * (a.GetPositionX() - x) + (a.GetPositionY() - y) * (a.GetPositionY() - y));
+    }
