+        player->RemoveAurasDueToSpell(SPELL_ON_A_TRIAL);
+        player->RemoveAurasDueToSpell(SPELL_SPEED_BOOST);
+        player->RemoveAurasDueToSpell(SPELL_ELECTRIFIED_TRIPWIRE);
+        if (player->IsMounted() && !player->HasAuraType(SPELL_AURA_MOUNTED))
+            player->Dismount();
+    }
+
+    void EndRace(Player* player, bool canceled, char const* reason = nullptr)
+    {
+        auto itr = Racers.find(player->GetGUID());
+        if (itr == Racers.end())
+            return;
+
+        Racer& racer = itr->second;
+        DespawnMarker(player, racer);
+        RemoveRaceAuras(player);
+
+        if (canceled)
+        {
+            ResetObjectives(player, racer.Track->QuestId);
+            Notify(player, std::string("Race canceled") + (reason ? std::string(": ") + reason : std::string()) +
+                ". Run through the start banner again with a Darkmoon Game Token to retry.");
+        }
+
+        Racers.erase(itr);
+    }
+
+    void StartRace(Player* player, Course const* course)
+    {
+        if (!player->HasItemCount(ITEM_DARKMOON_GAME_TOKEN))
+        {
+            uint32& warned = TokenWarnings[player->GetGUID()];
+            if (!warned)
+            {
+                Notify(player, "You need a Darkmoon Game Token to start the race.");
+                warned = 10 * IN_MILLISECONDS;
+            }
+            return;
+        }
+
+        player->DestroyItemCount(ITEM_DARKMOON_GAME_TOKEN, 1, true);
+
+        player->RemoveAurasByType(SPELL_AURA_MOUNTED);
+        player->RemoveAurasByType(SPELL_AURA_MOD_SHAPESHIFT);
+        player->CastSpell(player, SPELL_RACING_STRIDER, true);
+        if (Aura* aura = player->GetAura(SPELL_RACING_STRIDER))
+        {
+            aura->SetMaxDuration(-1);
+            aura->SetDuration(-1);
+        }
+        if (!player->IsMounted())
+            if (CreatureTemplate const* strider = sObjectMgr->GetCreatureTemplate(NPC_DARKMOON_STRIDER))
+                player->Mount(ObjectMgr::ChooseDisplayId(strider)->CreatureDisplayID);
+
+        if (Aura* aura = player->AddAura(SPELL_ON_A_TRIAL, player))
+        {
+            aura->SetMaxDuration(-1);
+            aura->SetDuration(-1);
+        }
+
+        Racer& racer = Racers[player->GetGUID()];
+        racer = Racer();
+        racer.Track = course;
+        player->KilledMonsterCredit(NPC_CREDIT_START);
+        player->CastSpell(player, SPELL_SOUND_BELL, true);
+        SpawnMarker(player, racer);
+
+        Notify(player, std::string("The race is on! Head for the ") + course->Posts[0].Name +
+            ". The bell tolls every " + std::to_string(RACE_TOLL_MS / IN_MILLISECONDS) + " seconds.");
+    }
+
+    void FinishRace(Player* player, Racer& racer)
+    {
+        Course const* course = racer.Track;
+        uint32 tolls = racer.Tolls;
+
+        player->KilledMonsterCredit(NPC_CREDIT_END);
+        player->KilledMonsterCredit(NPC_CREDIT_PASSED);
+
+        if (course->Enthusiast)
+            player->CastSpell(player, SPELL_ACH_RACE_ENTHUSIAST, true);
+
+        for (uint8 i = 0; i < course->AchievementCount; ++i)
+            if (tolls <= course->Achievements[i].MaxTolls)
+                player->CastSpell(player, course->Achievements[i].Spell, true);
+
+        Notify(player, "Race complete in " + std::to_string(tolls) + " tolls (" +
+            std::to_string(racer.Elapsed / IN_MILLISECONDS) + " seconds). Turn in the quest at the race official.");
+
+        EndRace(player, false);
+    }
+
+    void BoostAura(Player* player, uint32 spellId, int32 durationMs)
+    {
+        if (Aura* aura = player->AddAura(spellId, player))
+        {
+            aura->SetMaxDuration(durationMs);
+            aura->SetDuration(durationMs);
+        }
+    }
+
+    float DistToSegment2d(Position const& p, Creature const* a, Creature const* b)
+    {
+        float ax = a->GetPositionX(), ay = a->GetPositionY();
+        float bx = b->GetPositionX(), by = b->GetPositionY();
+        float px = p.GetPositionX(), py = p.GetPositionY();
+        float dx = bx - ax, dy = by - ay;
+        float len = dx * dx + dy * dy;
+        float t = len > 0.0f ? ((px - ax) * dx + (py - ay) * dy) / len : 0.0f;
+        t = std::max(0.0f, std::min(1.0f, t));
+        float cx = ax + t * dx - px, cy = ay + t * dy - py;
+        return std::sqrt(cx * cx + cy * cy);
+    }
+
+    void ApplyPowerup(Player* player, Racer& racer, Creature* pad)
+    {
+        racer.PowerupCooldowns[pad->GetSpawnId()] = 5 * IN_MILLISECONDS;
+
+        uint32 effect = pad->GetEntry();
+        if (effect == NPC_POWERUP_ROTATING)
+            effect = RAND(NPC_POWERUP_BLINK, NPC_POWERUP_ROCKET, NPC_POWERUP_JUMP);
+
+        switch (effect)
+        {
+            case NPC_POWERUP_DASH:
+            case NPC_POWERUP_LOOT:
+                BoostAura(player, SPELL_SPEED_BOOST, 4 * IN_MILLISECONDS);
+                break;
+            case NPC_POWERUP_JUMP:
+                player->JumpTo(25.0f, 12.0f, true);
+                break;
+            case NPC_POWERUP_ROCKET:
+                player->JumpTo(40.0f, 20.0f, true);
+                break;
+            case NPC_POWERUP_BLINK:
+            {
+                Position dest = player->GetPosition();
+                player->MovePositionToFirstCollision(dest, 20.0f, 0.0f);
+                player->NearTeleportTo(dest.GetPositionX(), dest.GetPositionY(), dest.GetPositionZ(), player->GetOrientation());
+                break;
+            }
+            default:
+                break;
+        }
+        racer.ZapImmune = std::max<uint32>(racer.ZapImmune, 1500);
+    }
+
+    void HandleCourse(Player* player, Racer& racer, uint32 diff)
+    {
+        for (auto itr = racer.PowerupCooldowns.begin(); itr != racer.PowerupCooldowns.end();)
+        {
+            if (itr->second <= diff)
+                itr = racer.PowerupCooldowns.erase(itr);
+            else
+            {
+                itr->second -= diff;
+                ++itr;
+            }
+        }
+        racer.ZapImmune = racer.ZapImmune > diff ? racer.ZapImmune - diff : 0;
+
+        // Checkpoint banners: speed boost and 7 seconds of water walking, once each.
+        std::list<Creature*> found;
+        player->GetCreatureListWithEntryInGrid(found, NPC_CHECKPOINT, CHECKPOINT_RADIUS);
+        for (Creature* checkpoint : found)
+        {
+            if (!racer.Checkpoints.insert(checkpoint->GetSpawnId()).second)
+                continue;
+            BoostAura(player, SPELL_SPEED_BOOST, 3 * IN_MILLISECONDS);
+            BoostAura(player, SPELL_WATER_WALKING, 7 * IN_MILLISECONDS);
+        }
+
+        // Powerup pads.
+        static uint32 const powerups[] = { NPC_POWERUP_DASH, NPC_POWERUP_JUMP, NPC_POWERUP_ROCKET, NPC_POWERUP_BLINK, NPC_POWERUP_LOOT, NPC_POWERUP_ROTATING };
+        for (uint32 entry : powerups)
+        {
+            found.clear();
+            player->GetCreatureListWithEntryInGrid(found, entry, POWERUP_RADIUS);
+            for (Creature* pad : found)
+            {
+                if (racer.PowerupCooldowns.count(pad->GetSpawnId()) || !pad->IsAlive())
+                    continue;
+                ApplyPowerup(player, racer, pad);
+                // Picked up: the pad disappears and comes back after a while.
+                pad->DespawnOrUnsummon(1, Seconds(POWERUP_RESPAWN_S));
+            }
+        }
+
+        // Electrified tripwires between stakes.
+        if (!racer.ZapImmune && !player->HasAura(SPELL_ELECTRIFIED_TRIPWIRE))
+        {
+            std::vector<Creature*> stakes;
+            player->GetCreatureListWithEntryInGrid(stakes, NPC_TRIPWIRE_STAKE, TRIPWIRE_SPAN + 2.0f);
+            bool zapped = false;
+            for (size_t i = 0; i < stakes.size() && !zapped; ++i)
+            {
+                auto partner = TripwirePartners.find(stakes[i]->GetSpawnId());
+                if (partner == TripwirePartners.end())
+                    continue;
+                for (size_t j = i + 1; j < stakes.size() && !zapped; ++j)
+                {
+                    if (stakes[j]->GetSpawnId() != partner->second)
+                        continue;
+                    if (std::fabs(player->GetPositionZ() - (stakes[i]->GetPositionZ() + stakes[j]->GetPositionZ()) / 2.0f) > 4.0f)
+                        continue;
+                    if (DistToSegment2d(player->GetPosition(), stakes[i], stakes[j]) <= TRIPWIRE_WIDTH)
+                        zapped = true;
+                }
+            }
+
+            if (zapped)
+            {
+                player->RemoveAurasDueToSpell(SPELL_SPEED_BOOST);
+                BoostAura(player, SPELL_ELECTRIFIED_TRIPWIRE, 2 * IN_MILLISECONDS);
+                racer.ZapImmune = 3 * IN_MILLISECONDS;
+            }
+        }
+    }
+
+    class player_darkmoon_race : public PlayerScript
+    {
+    public:
+        player_darkmoon_race() : PlayerScript("player_darkmoon_race") { }
+
+        void OnLogin(Player* player, bool /*firstLogin*/) override
+        {
+            // A race doesn't survive a logout.
+            if (player->HasAura(SPELL_ON_A_TRIAL) || player->HasAura(SPELL_RACING_STRIDER))
+                RemoveRaceAuras(player);
+        }
+
+        void OnLogout(Player* player) override
+        {
+            auto itr = Racers.find(player->GetGUID());
+            if (itr != Racers.end())
+            {
+                ResetObjectives(player, itr->second.Track->QuestId);
+                DespawnMarker(player, itr->second);
+                RemoveRaceAuras(player);
+                Racers.erase(itr);
+            }
+            TokenWarnings.erase(player->GetGUID());
+            IdleTimers.erase(player->GetGUID());
+        }
+
+        void OnUpdate(Player* player, uint32 diff) override
+        {
+            auto itr = Racers.find(player->GetGUID());
+
+            if (player->GetMapId() != MAP_DARKMOON_ISLAND)
+            {
+                if (itr != Racers.end())
+                    EndRace(player, true, "you left Darkmoon Island");
+                return;
+            }
+
+            if (itr == Racers.end())
+            {
+                // Waiting at a start banner? Check a few times a second only.
+                uint32& idle = IdleTimers[player->GetGUID()];
+                if (idle > diff)
+                {
+                    idle -= diff;
+                    return;
+                }
+                idle = 250;
+
+                auto warn = TokenWarnings.find(player->GetGUID());
+                if (warn != TokenWarnings.end())
+                    warn->second = warn->second > 250 ? warn->second - 250 : 0;
+
+                if (!player->IsAlive() || player->IsInFlight())
+                    return;
+
+                if (Course const* course = GetStartableCourse(player))
+                    if (Dist2d(player->GetPosition(), course->Banner->GetPositionX(), course->Banner->GetPositionY()) <= START_RADIUS &&
+                        std::fabs(player->GetPositionZ() - course->Banner->GetPositionZ()) < 10.0f)
+                        StartRace(player, course);
+                return;
+            }
+
+            Racer& racer = itr->second;
+            racer.Elapsed += diff;
+            racer.TollTimer += diff;
+            if (racer.TollTimer >= RACE_TOLL_MS)
+            {
+                racer.TollTimer -= RACE_TOLL_MS;
+                ++racer.Tolls;
+                player->CastSpell(player, SPELL_SOUND_BELL, true);
+            }
+
+            racer.TickTimer += diff;
+            if (racer.TickTimer < RACE_TICK_MS)
+                return;
+            uint32 tick = racer.TickTimer;
+            racer.TickTimer = 0;
+
+            if (!player->IsAlive())
+            {
+                EndRace(player, true, "you died");
+                return;
+            }
+            if (player->GetQuestStatus(racer.Track->QuestId) != QUEST_STATUS_INCOMPLETE)
+            {
+                EndRace(player, false);
+                return;
+            }
+            if (!player->IsMounted())
+            {
+                EndRace(player, true, "you left your racer");
+                return;
+            }
+            if (racer.Elapsed >= RACE_MAX_MS)
+            {
+                EndRace(player, true, "out of time");
+                return;
+            }
+
+            if (racer.Leg < racer.Track->PostCount)
+            {
+                Post const& post = racer.Track->Posts[racer.Leg];
+                if (Dist2d(player->GetPosition(), post.X, post.Y) <= POST_RADIUS)
+                {
+                    player->KilledMonsterCredit(post.Credit);
+                    ++racer.Leg;
+                    std::string next = racer.Leg < racer.Track->PostCount ? std::string(racer.Track->Posts[racer.Leg].Name) : std::string("start banner");
+                    Notify(player, std::string(post.Name) + " reached at " + std::to_string(racer.Tolls) + " tolls. Next: the " + next + ".");
+                    SpawnMarker(player, racer);
+                }
+            }
+            else if (Dist2d(player->GetPosition(), racer.Track->Banner->GetPositionX(), racer.Track->Banner->GetPositionY()) <= START_RADIUS)
+            {
+                FinishRace(player, racer);
+                return;
+            }
+
+            HandleCourse(player, racer, tick);
+        }
+    };
+
+    // Racing Strider buttons (OverrideSpellData 569). The client spells are
+    // script effects aimed at server-side targets, so the targets are picked here.
+    enum RacerSpells : uint32
+    {
+        SPELL_JUMP_TO_BANNER    = 179748,
+        SPELL_LASSO_POWERUP     = 316043,
+        SPELL_JUMP_TO_RACER     = 179804,
+    };
+
+    float const JUMP_RANGE      = 100.0f;
+    float const LASSO_RANGE     = 25.0f;
+
+    void LeapTo(Player* player, WorldObject const* target)
+    {
+        float dist = player->GetExactDist2d(target);
+        player->GetMotionMaster()->MoveJump(target->GetPositionX(), target->GetPositionY(), target->GetPositionZ() + 1.0f,
+            player->GetOrientation(), 45.0f, 8.0f + dist / 8.0f);
+    }
+
+    class spell_darkmoon_racer_button : public SpellScriptLoader
+    {
+    public:
+        spell_darkmoon_racer_button() : SpellScriptLoader("spell_darkmoon_racer_button") { }
+
+        class spell_darkmoon_racer_button_SpellScript : public SpellScript
+        {
+            PrepareSpellScript(spell_darkmoon_racer_button_SpellScript);
+
+            void ClearTargets(std::list<WorldObject*>& targets)
+            {
+                targets.clear();
+            }
+
+            void HandleCast()
+            {
+                Player* player = GetCaster()->ToPlayer();
+                if (!player)
+                    return;
+
+                auto itr = Racers.find(player->GetGUID());
+                if (itr == Racers.end())
+                    return;
+                Racer& racer = itr->second;
+
+                switch (GetSpellInfo()->Id)
+                {
+                    case SPELL_JUMP_TO_BANNER:
+                    {
+                        // Nearest checkpoint banner ahead of you, 4 seconds safe from tripwires.
+                        std::list<Creature*> banners;
+                        player->GetCreatureListWithEntryInGrid(banners, NPC_CHECKPOINT, JUMP_RANGE);
+                        Creature* best = nullptr;
+                        for (Creature* banner : banners)
+                            if (player->GetExactDist2d(banner) > 8.0f && player->HasInArc(float(M_PI) * 2.0f / 3.0f, banner) &&
+                                (!best || player->GetExactDist2d(banner) < player->GetExactDist2d(best)))
+                                best = banner;
+                        if (best)
+                        {
+                            LeapTo(player, best);
+                            racer.ZapImmune = 4 * IN_MILLISECONDS;
+                        }
+                        break;
+                    }
+                    case SPELL_JUMP_TO_RACER:
+                    {
+                        Player* best = nullptr;
+                        for (auto const& other : Racers)
+                        {
+                            if (other.first == player->GetGUID())
+                                continue;
+                            Player* racerPlayer = ObjectAccessor::GetPlayer(*player, other.first);
+                            if (racerPlayer && player->GetExactDist2d(racerPlayer) <= JUMP_RANGE && player->HasInArc(float(M_PI), racerPlayer) &&
+                                (!best || player->GetExactDist2d(racerPlayer) < player->GetExactDist2d(best)))
+                                best = racerPlayer;
+                        }
+                        if (best)
+                        {
+                            LeapTo(player, best);
+                            racer.ZapImmune = 4 * IN_MILLISECONDS;
+                        }
+                        break;
+                    }
+                    case SPELL_LASSO_POWERUP:
+                    {
+                        // Grab the nearest powerup pad in reach and use it at once.
+                        static uint32 const pads[] = { NPC_POWERUP_DASH, NPC_POWERUP_JUMP, NPC_POWERUP_ROCKET, NPC_POWERUP_BLINK, NPC_POWERUP_LOOT, NPC_POWERUP_ROTATING };
+                        Creature* best = nullptr;
+                        for (uint32 entry : pads)
+                        {
+                            std::list<Creature*> found;
+                            player->GetCreatureListWithEntryInGrid(found, entry, LASSO_RANGE);
+                            for (Creature* pad : found)
+                                if (!racer.PowerupCooldowns.count(pad->GetSpawnId()) &&
+                                    (!best || player->GetExactDist(pad) < player->GetExactDist(best)))
+                                    best = pad;
+                        }
+                        if (best)
+                            ApplyPowerup(player, racer, best);
+                        break;
+                    }
+                    default:
+                        break;
+                }
+            }
+
+            void Register() override
+            {
+                if (m_scriptSpellId == SPELL_LASSO_POWERUP)
+                    OnObjectAreaTargetSelect += SpellObjectAreaTargetSelectFn(spell_darkmoon_racer_button_SpellScript::ClearTargets, EFFECT_0, TARGET_UNIT_CONE_ENTRY);
+                else
+                    OnObjectAreaTargetSelect += SpellObjectAreaTargetSelectFn(spell_darkmoon_racer_button_SpellScript::ClearTargets, EFFECT_0, TARGET_UNIT_CONE_ENTRY_110);
+                OnCast += SpellCastFn(spell_darkmoon_racer_button_SpellScript::HandleCast);
+            }
+        };
+
+        SpellScript* GetSpellScript() const override
+        {
+            return new spell_darkmoon_racer_button_SpellScript();
+        }
+    };
+}
