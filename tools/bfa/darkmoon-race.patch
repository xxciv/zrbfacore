+namespace DarkmoonRace
+{
+    // Tripwire stake: wires itself to its nearest stake (when that stake picks it too) and shows
+    // the wire as a lightning beam. Only that pair zaps racers (HandleCourse).
+    struct npc_darkmoon_race_tripwire_stake : public ScriptedAI
+    {
+        npc_darkmoon_race_tripwire_stake(Creature* creature) : ScriptedAI(creature) { }
+
+        uint32 _wireTimer = 1 * IN_MILLISECONDS;
+
+        void Reset() override { }
+
+        void UpdateAI(uint32 diff) override
+        {
+            if (!_wireTimer)
+                return;
+            if (_wireTimer > diff)
+            {
+                _wireTimer -= diff;
+                return;
+            }
+            _wireTimer = 0;
+
+            Creature* partner = NearestStake(me);
+            if (!partner || NearestStake(partner) != me)
+                return;
+
+            TripwirePartners[me->GetSpawnId()] = partner->GetSpawnId();
+            TripwirePartners[partner->GetSpawnId()] = me->GetSpawnId();
+
+            // One beam per pair, from the stake with the lower spawn id.
+            if (me->GetSpawnId() > partner->GetSpawnId())
+                return;
+            if (SpellInfo const* beam = sSpellMgr->GetSpellInfo(SPELL_TRIPWIRE_BEAM))
+            {
+                me->SetChannelSpellId(beam->Id);
+                me->SetChannelSpellXSpellVisualId(beam->GetSpellXSpellVisualId(me));
+                me->AddChannelObject(partner->GetGUID());
+            }
+        }
+    };
+}
