+    float Dist2d(Position const& a, float x, float y)
+    {
+        return std::sqrt((a.GetPositionX() - x) * (a.GetPositionX() - x) + (a.GetPositionY() - y) * (a.GetPositionY() - y));
+    }
+
+    void Notify(Player* player, std::string const& text)
+    {
+        ChatHandler(player->GetSession()).SendSysMessage(text.c_str());
+    }
+
+    QuestObjective const* FindObjective(Quest const* quest, uint32 creditEntry)
+    {
+        for (QuestObjective const& objective : quest->GetObjectives())
+            if (objective.Type == QUEST_OBJECTIVE_MONSTER && uint32(objective.ObjectID) == creditEntry)
+                return &objective;
+        return nullptr;
+    }
+
+    // Course the player can start now: race quest in the log, start not credited yet.
+    Course const* GetStartableCourse(Player* player)
+    {
+        for (Course const& course : Courses)
+        {
+            if (player->GetQuestStatus(course.QuestId) != QUEST_STATUS_INCOMPLETE)
+                continue;
+
+            Quest const* quest = sObjectMgr->GetQuestTemplate(course.QuestId);
+            if (!quest)
+                continue;
+
+            QuestObjective const* start = FindObjective(quest, NPC_CREDIT_START);
+            if (start && player->IsQuestObjectiveComplete(*start))
+                continue;
+
+            return &course;
+        }
+        return nullptr;
+    }
+
+    void ResetObjectives(Player* player, uint32 questId)
+    {
+        Quest const* quest = sObjectMgr->GetQuestTemplate(questId);
+        if (!quest || player->GetQuestStatus(questId) != QUEST_STATUS_INCOMPLETE)
+            return;
+
+        for (QuestObjective const& objective : quest->GetObjectives())
+            player->SetQuestObjectiveData(objective, 0);
+
+        player->SendQuestUpdate(questId);
+    }
+
+    void DespawnMarker(Player* player, Racer& racer)
+    {
+        if (!racer.Marker.IsEmpty())
+            if (Creature* marker = ObjectAccessor::GetCreature(*player, racer.Marker))
+                marker->DespawnOrUnsummon();
+        racer.Marker.Clear();
+    }
+
+    void SpawnMarker(Player* player, Racer& racer)
+    {
+        DespawnMarker(player, racer);
+        if (racer.Leg >= racer.Track->PostCount)
+            return;
+
+        Post const& post = racer.Track->Posts[racer.Leg];
+        float z = post.Z;
+        if (z == 0.0f)
+            z = player->GetMap()->GetWaterOrGroundLevel(player->GetPhaseShift(), post.X, post.Y, 200.0f);
+
+        if (TempSummon* marker = player->SummonCreature(post.Credit, post.X, post.Y, z, 0.0f, TEMPSUMMON_TIMED_DESPAWN, RACE_MAX_MS, true))
+        {
+            marker->SetDisplayId(DISPLAY_POST_POINTER);
+            marker->SetUnitFlags(UnitFlags(UNIT_FLAG_NOT_SELECTABLE | UNIT_FLAG_IMMUNE_TO_PC | UNIT_FLAG_IMMUNE_TO_NPC));
+            marker->SetReactState(REACT_PASSIVE);
+            marker->CastSpell(marker, post.Visual, true);
+            racer.Marker = marker->GetGUID();
+        }
+    }
+
+    void RemoveRaceAuras(Player* player)
+    {
+        player->RemoveAurasDueToSpell(SPELL_RACING_STRIDER);
+        player->RemoveAurasDueToSpell(SPELL_ON_A_TRIAL);
+        player->RemoveAurasDueToSpell(SPELL_SPEED_BOOST);
+        player->RemoveAurasDueToSpell(SPELL_ELECTRIFIED_TRIPWIRE);
+        if (player->IsMounted() && !player->HasAuraType(SPELL_AURA_MOUNTED))
+            player->Dismount();
+    }
+
+    void EndRace(Player* player, bool canceled, char const* reason = nullptr)
+    {
+        auto itr = Racers.find(player->GetGUID());
+        if (itr == Racers.end())
+            return;
+
+        Racer& racer = itr->second;
+        DespawnMarker(player, racer);
+        RemoveRaceAuras(player);
+
+        if (canceled)
+        {
+            ResetObjectives(player, racer.Track->QuestId);
+            Notify(player, std::string("Race canceled") + (reason ? std::string(": ") + reason : std::string()) +
+                ". Run through the start banner again with a Darkmoon Game Token to retry.");
+        }
+
+        Racers.erase(itr);
+    }
+
+    void StartRace(Player* player, Course const* course)
+    {
+        if (!player->HasItemCount(ITEM_DARKMOON_GAME_TOKEN))
+        {
+            uint32& warned = TokenWarnings[player->GetGUID()];
+            if (!warned)
+            {
+                Notify(player, "You need a Darkmoon Game Token to start the race.");
+                warned = 10 * IN_MILLISECONDS;
+            }
+            return;
+        }
+
+        player->DestroyItemCount(ITEM_DARKMOON_GAME_TOKEN, 1, true);
+
+        player->RemoveAurasByType(SPELL_AURA_MOUNTED);
+        player->RemoveAurasByType(SPELL_AURA_MOD_SHAPESHIFT);
+        player->CastSpell(player, SPELL_RACING_STRIDER, true);
+        if (Aura* aura = player->GetAura(SPELL_RACING_STRIDER))
+        {
+            aura->SetMaxDuration(-1);
+            aura->SetDuration(-1);
+        }
+        if (!player->IsMounted())
+            if (CreatureTemplate const* strider = sObjectMgr->GetCreatureTemplate(NPC_DARKMOON_STRIDER))
+                player->Mount(ObjectMgr::ChooseDisplayId(strider)->CreatureDisplayID);
+
+        if (Aura* aura = player->AddAura(SPELL_ON_A_TRIAL, player))
+        {
+            aura->SetMaxDuration(-1);
+            aura->SetDuration(-1);
+        }
+
+        Racer& racer = Racers[player->GetGUID()];
+        racer = Racer();
+        racer.Track = course;
+        player->KilledMonsterCredit(NPC_CREDIT_START);
+        player->CastSpell(player, SPELL_SOUND_BELL, true);
+        SpawnMarker(player, racer);
+
+        Notify(player, std::string("The race is on! Head for the ") + course->Posts[0].Name +
+            ". The bell tolls every " + std::to_string(RACE_TOLL_MS / IN_MILLISECONDS) + " seconds.");
+    }
+
+    void FinishRace(Player* player, Racer& racer)
+    {
+        Course const* course = racer.Track;
+        uint32 tolls = racer.Tolls;
+
+        player->KilledMonsterCredit(NPC_CREDIT_END);
+        player->KilledMonsterCredit(NPC_CREDIT_PASSED);
+
+        if (course->Enthusiast)
+            player->CastSpell(player, SPELL_ACH_RACE_ENTHUSIAST, true);
+
+        for (uint8 i = 0; i < course->AchievementCount; ++i)
+            if (tolls <= course->Achievements[i].MaxTolls)
+                player->CastSpell(player, course->Achievements[i].Spell, true);
+
+        Notify(player, "Race complete in " + std::to_string(tolls) + " tolls (" +
+            std::to_string(racer.Elapsed / IN_MILLISECONDS) + " seconds). Turn in the quest at the race official.");
+
+        EndRace(player, false);
+    }
+
+    void BoostAura(Player* player, uint32 spellId, int32 durationMs)
+    {
+        if (Aura* aura = player->AddAura(spellId, player))
+        {
+            aura->SetMaxDuration(durationMs);
+            aura->SetDuration(durationMs);
+        }
+    }
+
+    float DistToSegment2d(Position const& p, Creature const* a, Creature const* b)
+    {
+        float ax = a->GetPositionX(), ay = a->GetPositionY();
+        float bx = b->GetPositionX(), by = b->GetPositionY();
+        float px = p.GetPositionX(), py = p.GetPositionY();
+        float dx = bx - ax, dy = by - ay;
+        float len = dx * dx + dy * dy;
+        float t = len > 0.0f ? ((px - ax) * dx + (py - ay) * dy) / len : 0.0f;
+        t = std::max(0.0f, std::min(1.0f, t));
+        float cx = ax + t * dx - px, cy = ay + t * dy - py;
+        return std::sqrt(cx * cx + cy * cy);
+    }
+
+    void HandleCourse(Player* player, Racer& racer, uint32 diff)
+    {
+        for (auto itr = racer.PowerupCooldowns.begin(); itr != racer.PowerupCooldowns.end();)
+        {
+            if (itr->second <= diff)
+                itr = racer.PowerupCooldowns.erase(itr);
+            else
+            {
+                itr->second -= diff;
+                ++itr;
+            }
+        }
+        racer.ZapImmune = racer.ZapImmune > diff ? racer.ZapImmune - diff : 0;
+
+        // Checkpoint banners: speed boost and 7 seconds of water walking, once each.
+        std::list<Creature*> found;
+        player->GetCreatureListWithEntryInGrid(found, NPC_CHECKPOINT, CHECKPOINT_RADIUS);
+        for (Creature* checkpoint : found)
+        {
+            if (!racer.Checkpoints.insert(checkpoint->GetSpawnId()).second)
+                continue;
+            BoostAura(player, SPELL_SPEED_BOOST, 3 * IN_MILLISECONDS);
+            BoostAura(player, SPELL_WATER_WALKING, 7 * IN_MILLISECONDS);
+        }
+
+        // Powerup pads.
+        static uint32 const powerups[] = { NPC_POWERUP_DASH, NPC_POWERUP_JUMP, NPC_POWERUP_ROCKET, NPC_POWERUP_BLINK, NPC_POWERUP_LOOT, NPC_POWERUP_ROTATING };
+        for (uint32 entry : powerups)
+        {
+            found.clear();
+            player->GetCreatureListWithEntryInGrid(found, entry, POWERUP_RADIUS);
+            for (Creature* pad : found)
+            {
+                if (racer.PowerupCooldowns.count(pad->GetSpawnId()))
+                    continue;
+                racer.PowerupCooldowns[pad->GetSpawnId()] = 5 * IN_MILLISECONDS;
+
+                uint32 effect = entry;
+                if (entry == NPC_POWERUP_ROTATING)
+                    effect = RAND(NPC_POWERUP_BLINK, NPC_POWERUP_ROCKET, NPC_POWERUP_JUMP);
+
+                switch (effect)
+                {
+                    case NPC_POWERUP_DASH:
+                    case NPC_POWERUP_LOOT:
+                        BoostAura(player, SPELL_SPEED_BOOST, 4 * IN_MILLISECONDS);
+                        break;
+                    case NPC_POWERUP_JUMP:
+                        player->JumpTo(25.0f, 12.0f, true);
+                        break;
+                    case NPC_POWERUP_ROCKET:
+                        player->JumpTo(40.0f, 20.0f, true);
+                        break;
+                    case NPC_POWERUP_BLINK:
+                    {
+                        Position dest = player->GetPosition();
+                        player->MovePositionToFirstCollision(dest, 20.0f, 0.0f);
+                        player->NearTeleportTo(dest.GetPositionX(), dest.GetPositionY(), dest.GetPositionZ(), player->GetOrientation());
+                        break;
+                    }
+                    default:
+                        break;
+                }
+                racer.ZapImmune = std::max<uint32>(racer.ZapImmune, 1500);
+            }
+        }
+
+        // Electrified tripwires between stakes.
+        if (!racer.ZapImmune && !player->HasAura(SPELL_ELECTRIFIED_TRIPWIRE))
+        {
+            std::vector<Creature*> stakes;
+            player->GetCreatureListWithEntryInGrid(stakes, NPC_TRIPWIRE_STAKE, TRIPWIRE_SPAN + 2.0f);
+            bool zapped = false;
+            for (size_t i = 0; i < stakes.size() && !zapped; ++i)
+                for (size_t j = i + 1; j < stakes.size() && !zapped; ++j)
+                {
+                    if (stakes[i]->GetExactDist2d(stakes[j]) > TRIPWIRE_SPAN)
+                        continue;
+                    if (std::fabs(player->GetPositionZ() - (stakes[i]->GetPositionZ() + stakes[j]->GetPositionZ()) / 2.0f) > 4.0f)
+                        continue;
+                    if (DistToSegment2d(player->GetPosition(), stakes[i], stakes[j]) <= TRIPWIRE_WIDTH)
+                        zapped = true;
+                }
+
+            if (zapped)
+            {
+                player->RemoveAurasDueToSpell(SPELL_SPEED_BOOST);
+                BoostAura(player, SPELL_ELECTRIFIED_TRIPWIRE, 2 * IN_MILLISECONDS);
+                racer.ZapImmune = 3 * IN_MILLISECONDS;
+            }
+        }
+    }
