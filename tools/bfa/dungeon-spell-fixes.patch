@@ -8316,6 +8316,14 @@ bool WorldObjectSpellConeTargetCheck::operator()(WorldObject* target)
             if (_caster->HasInArc(_coneAngle, target) != G3D::fuzzyGe(_coneAngle, 0.f))
                 return false;
     }
+
+    // A cone that selects by entry (target 110) and has no conditions takes the caster's enemies, like
+    // the enemy cone (104). Without conditions an entry check passes every unit, the caster's allies too.
+    if (_targetSelectionType == TARGET_CHECK_ENTRY && !_condSrcInfo)
+        if (Unit* unitTarget = target->ToUnit())
+            if (unitTarget->IsTotem() || !_caster->_IsValidAttackTarget(unitTarget, _spellInfo))
+                return false;
+
     return WorldObjectSpellAreaTargetCheck::operator ()(target);
 }
 
