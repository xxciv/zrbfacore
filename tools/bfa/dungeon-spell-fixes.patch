+// Server-side dummy effects whose base points hold the spell to cast on each target hit. Retail casts
+// these from its own scripts, so without this the spell does nothing.
+// 149887 Foul Tempest, 149908 Catch of the Day, 149910 Catch of the Day, 150020 Restorative Waters,
+// 151159 Darkness Calls, 151303 Tearing the Void, 151304 Tearing the Void, 151313 Grip of Darkness,
+// 151683 Static Shock, 151814 Piercing Rain, 152753 Spore Cloud, 152965 Falling Debris (Blackfathom Deeps)
+class spell_gen_dummy_cast_base_points : public SpellScript
+{
+    PrepareSpellScript(spell_gen_dummy_cast_base_points);
+
+    void HandleDummy(SpellEffIndex effIndex)
+    {
+        Unit* caster = GetCaster();
+        Unit* target = GetHitUnit();
+        SpellEffectInfo const* effect = GetSpellInfo()->GetEffect(effIndex);
+        if (!caster || !target || !effect || effect->BasePoints <= 0)
+            return;
+
+        if (sSpellMgr->GetSpellInfo(uint32(effect->BasePoints)))
+            caster->CastSpell(target, uint32(effect->BasePoints), true);
+    }
+
+    void Register() override
+    {
+        OnEffectHitTarget += SpellEffectFn(spell_gen_dummy_cast_base_points::HandleDummy, EFFECT_ALL, SPELL_EFFECT_DUMMY);
+    }
+};
+
 class spell_gen_dream_funnel : public SpellScriptLoader
