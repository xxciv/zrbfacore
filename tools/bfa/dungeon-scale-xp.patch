+        // Whether (and why) the player earns no XP where they are now.
+        XPBlock GetXPBlock(Player const* player, uint32* achievementId = nullptr)
+        {
+            Map const* map = player->GetMap();
+            if (!IsScaledMap(map))
+                return XPBlock::None;
+
+            ScaleConfig const& cfg = GetConfig();
+            if (!cfg.xpEnable)
+                return XPBlock::Disabled;
+            if (!cfg.xpStopAfterCompletion)
+                return XPBlock::None;
+
+            for (CompletionAchievement const& completion : GetCompletionAchievements(map))
+            {
+                if (!player->HasAchieved(completion.achievementId))
+                    continue;
+                if (completion.modifierTreeId && !player->ModifierTreeSatisfied(completion.modifierTreeId))
+                    continue;
+
+                if (achievementId)
+                    *achievementId = completion.achievementId;
+                return XPBlock::Completed;
+            }
+            return XPBlock::None;
+        }
+
+        // Achievements that mark this map and difficulty as completed: not statistics, with a criteria killing
+        // a creature, made for this map (Achievement InstanceID) or killing its final boss (instance_encounters
+        // row with lastEncounterDungeon). Built once per map and difficulty; DB2 and world data never change.
+        std::vector<CompletionAchievement> const& GetCompletionAchievements(Map const* map)
+        {
+            uint32 const key = (map->GetId() << 8) | uint32(map->GetDifficultyID());
+            std::lock_guard<std::mutex> guard(_completionLock);
+            auto itr = _completionAchievements.find(key);
+            if (itr != _completionAchievements.end())
+                return itr->second;
+
+            std::vector<CompletionAchievement>& completions = _completionAchievements[key];
+
+            std::unordered_set<uint32> finalBosses;
+            if (DungeonEncounterList const* encounters = sObjectMgr->GetDungeonEncounterList(map->GetId(), map->GetDifficultyID()))
+                for (DungeonEncounter const* encounter : *encounters)
+                    if (encounter->lastEncounterDungeon && encounter->creditType == ENCOUNTER_CREDIT_KILL_CREATURE)
+                        finalBosses.insert(encounter->creditEntry);
+
+            std::unordered_set<uint64> seen;
+            for (Criteria const* criteria : sCriteriaMgr->GetPlayerCriteriaByType(CRITERIA_TYPE_KILL_CREATURE))
+            {
+                CriteriaTreeList const* trees = sCriteriaMgr->GetCriteriaTreesByCriteria(criteria->ID);
+                if (!trees)
+                    continue;
+
+                bool const killsFinalBoss = finalBosses.count(uint32(criteria->Entry->Asset.CreatureID)) != 0;
+                for (CriteriaTree const* tree : *trees)
+                {
+                    AchievementEntry const* achievement = tree->Achievement;
+                    if (!achievement || (achievement->Flags & ACHIEVEMENT_FLAG_COUNTER))
+                        continue;
+                    if (achievement->InstanceID != int16(map->GetId()) && !(achievement->InstanceID == -1 && killsFinalBoss))
+                        continue;
+                    if (!seen.insert((uint64(achievement->ID) << 32) | criteria->Entry->ModifierTreeId).second)
+                        continue;
+
+                    completions.push_back({ achievement->ID, criteria->Entry->ModifierTreeId });
+                }
+            }
+            return completions;
+        }
+
