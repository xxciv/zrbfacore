+// True while a living attacker that still has threat on us is only hidden
+// from us (stealth or invisibility), so its threat entry is offline.
+static bool HasHiddenAttacker(Creature* me)
+{
+    if (!me->IsInCombat() || !me->CanHaveThreatList())
+        return false;
+
+    for (ThreatReference const* ref : me->GetThreatManager().GetUnsortedThreatList())
+    {
+        Unit* victim = ref->GetVictim();
+        if (ref->IsOffline() && ref->GetThreat() > 0.0f && victim->IsAlive() && !me->CanSeeOrDetect(victim))
+            return true;
+    }
+
+    return false;
+}
